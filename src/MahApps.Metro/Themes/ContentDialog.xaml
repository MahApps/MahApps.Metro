<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="clr-namespace:MahApps.Metro.Controls"
                    xmlns:mahConverters="clr-namespace:MahApps.Metro.Converters"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />

    <ControlTemplate x:Key="MahApps.Templates.ContentDialog" TargetType="{x:Type mah:ContentDialog}">
        <Grid x:Name="PART_Overlay"
              Background="{TemplateBinding OverlayBrush}"
              ClipToBounds="True"
              FocusVisualStyle="{x:Null}"
              KeyboardNavigation.TabNavigation="None"
              Opacity="0"
              Visibility="Collapsed">
            <Grid.Resources>
                <DropShadowEffect x:Key="GlowBrushEffect"
                                  BlurRadius="10"
                                  Opacity="0.8"
                                  ShadowDepth="0"
                                  Color="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=GlowBrush.Color, Mode=OneWay}" />
                <DropShadowEffect x:Key="NonActiveGlowBrushEffect"
                                  BlurRadius="10"
                                  Opacity="0.8"
                                  ShadowDepth="0"
                                  Color="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=NonActiveGlowBrush.Color, Mode=OneWay}" />
                <Canvas x:Key="ChildWindowHandImage"
                        Width="76"
                        Height="76"
                        Clip="F1 M 0,0L 76,0L 76,76L 0,76L 0,0">
                    <Path Canvas.Left="19"
                          Canvas.Top="19"
                          Width="38"
                          Height="38"
                          Data="F1 M 38,19C 48.4934,19 57,27.5066 57,38C 57,48.4934 48.4934,57 38,57C 27.5066,57 19,48.4934 19,38C 19,27.5066 27.5066,19 38,19 Z M 23.75,34.8334L 23.75,41.1667L 52.25,41.1667L 52.25,34.8334L 23.75,34.8334 Z "
                          Fill="{DynamicResource MahApps.Brushes.ThemeForeground}"
                          Stretch="Fill" />
                </Canvas>
            </Grid.Resources>

            <Grid x:Name="PART_Window"
                  Width="{TemplateBinding ChildWindowWidth}"
                  Height="{TemplateBinding ChildWindowHeight}"
                  MinWidth="{TemplateBinding ChildWindowMinWidth}"
                  MinHeight="{TemplateBinding ChildWindowMinHeight}"
                  MaxWidth="{TemplateBinding ChildWindowMaxWidth}"
                  MaxHeight="{TemplateBinding ChildWindowMaxHeight}"
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  Background="{TemplateBinding Background}"
                  FocusVisualStyle="{x:Null}"
                  UseLayoutRounding="True">

                <Border x:Name="PART_GlowEffect"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        Effect="{DynamicResource GlowBrushEffect}"
                        FocusVisualStyle="{x:Null}"
                        SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                        UseLayoutRounding="True"
                        Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=EnableDropShadow, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}" />

                <mah:ClipBorder x:Name="PART_Border"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}"
                                FocusVisualStyle="{x:Null}"
                                KeyboardNavigation.TabNavigation="None"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                UseLayoutRounding="True">

                    <AdornerDecorator>
                        <Grid KeyboardNavigation.ControlTabNavigation="Cycle"
                              KeyboardNavigation.DirectionalNavigation="Cycle"
                              KeyboardNavigation.TabNavigation="Cycle">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Rectangle x:Name="PART_TitleBarBackground"
                                       Grid.Row="0"
                                       Grid.Column="0"
                                       Fill="{TemplateBinding TitleBarBackground}"
                                       Focusable="False"
                                       StrokeThickness="0"
                                       Visibility="{TemplateBinding ShowTitleBar, Converter={StaticResource BooleanToVisibilityConverter}}" />

                            <Grid x:Name="PART_TitleBar"
                                  Grid.Row="0"
                                  Grid.Column="0"
                                  Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                  Focusable="False"
                                  Visibility="{TemplateBinding ShowTitleBar, Converter={StaticResource BooleanToVisibilityConverter}}">

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!--  icon  -->
                                <ContentControl x:Name="PART_TitleBarIcon"
                                                Grid.Column="0"
                                                Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                MinWidth="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                HorizontalContentAlignment="Stretch"
                                                VerticalContentAlignment="Stretch"
                                                Content="{TemplateBinding TitleBarIcon}"
                                                ContentTemplate="{TemplateBinding TitleBarIconTemplate}"
                                                Focusable="False" />

                                <!--  title  -->
                                <mah:MetroThumbContentControl x:Name="PART_TitleBarThumb"
                                                              Grid.Column="1"
                                                              Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                              HorizontalAlignment="Stretch"
                                                              VerticalAlignment="Stretch"
                                                              HorizontalContentAlignment="{TemplateBinding TitleHorizontalAlignment}"
                                                              VerticalContentAlignment="{TemplateBinding TitleVerticalAlignment}"
                                                              Content="{TemplateBinding Title}"
                                                              ContentCharacterCasing="{TemplateBinding TitleCharacterCasing}"
                                                              ContentTemplate="{TemplateBinding TitleTemplate}"
                                                              Focusable="False"
                                                              FontFamily="{TemplateBinding TitleFontFamily}"
                                                              FontSize="{TemplateBinding TitleFontSize}">
                                    <ContentControl.Foreground>
                                        <MultiBinding Converter="{x:Static mahConverters:BackgroundToForegroundConverter.Instance}">
                                            <Binding Mode="OneWay"
                                                     Path="TitleBarBackground"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                            <Binding Mode="OneWay"
                                                     Path="TitleBarForeground"
                                                     RelativeSource="{RelativeSource TemplatedParent}" />
                                        </MultiBinding>
                                    </ContentControl.Foreground>
                                </mah:MetroThumbContentControl>

                                <!--  close button  -->
                                <Button x:Name="PART_TitleBarCloseButton"
                                        Grid.Column="2"
                                        Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                        FocusVisualStyle="{DynamicResource MahApps.Styles.ChildWindow.FocusVisualStyle}"
                                        Focusable="False"
                                        IsTabStop="True"
                                        Style="{TemplateBinding TitleBarCloseButtonStyle}"
                                        ToolTip="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type mah:ContentDialog}}, Path=TitleBarCloseButtonToolTip, Mode=OneWay}"
                                        Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=ShowTitleBarCloseButton, Mode=OneWay, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Path Data="M 10.009,1.704 L 8.331,0.026 5.03,3.327 1.703,0 0,1.704 3.326,5.031 0.025,8.332 1.703,10.009 5.004,6.708 8.305,10.009 10.009,8.305 6.708,5.005"
                                          Fill="{TemplateBinding TitleBarForeground}"
                                          SnapsToDevicePixels="True" />
                                </Button>
                            </Grid>

                            <Grid Grid.Row="1"
                                  Grid.Column="0"
                                  UseLayoutRounding="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Rectangle x:Name="PART_Image"
                                           Grid.Column="0"
                                           Width="48"
                                           Height="48"
                                           Margin="4 0 0 4"
                                           VerticalAlignment="Center" />
                                <ContentPresenter x:Name="PART_Content"
                                                  Grid.Column="1"
                                                  Margin="16 16 16 0"
                                                  Content="{TemplateBinding Content}"
                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}" />

                                <StackPanel x:Name="CommandSpace"
                                            Grid.Row="1"
                                            Grid.Column="0"
                                            Grid.ColumnSpan="2"
                                            Margin="0 16 16 16"
                                            HorizontalAlignment="Right"
                                            Orientation="Horizontal">
                                    <Button x:Name="PART_PrimaryButton"
                                            Margin="8 0 0 0"
                                            Content="{TemplateBinding PrimaryButtonText}"
                                            IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}"
                                            Style="{TemplateBinding PrimaryButtonStyle}" />
                                    <Button x:Name="PART_SecondaryButton"
                                            Margin="8 0 0 0"
                                            Content="{TemplateBinding SecondaryButtonText}"
                                            IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}"
                                            Style="{TemplateBinding SecondaryButtonStyle}" />
                                    <Button x:Name="PART_CloseButton"
                                            Margin="8 0 0 0"
                                            Content="{TemplateBinding CloseButtonText}"
                                            Style="{TemplateBinding CloseButtonStyle}" />
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </AdornerDecorator>
                </mah:ClipBorder>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Default" />
                    <VisualState x:Name="Hide">
                        <Storyboard x:Name="HideStoryboard">
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                                           Storyboard.TargetName="PART_Overlay"
                                                           Storyboard.TargetProperty="(UIElement.Opacity)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                <SplineDoubleKeyFrame KeyTime="00:00:00.100" Value="0" />
                            </DoubleAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00.100"
                                                           Storyboard.TargetName="PART_Overlay"
                                                           Storyboard.TargetProperty="(UIElement.Visibility)">
                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Show">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames BeginTime="00:00:00"
                                                           Storyboard.TargetName="PART_Overlay"
                                                           Storyboard.TargetProperty="(UIElement.Visibility)">
                                <DiscreteObjectKeyFrame KeyTime="00:00:00" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                                           Storyboard.TargetName="PART_Overlay"
                                                           Storyboard.TargetProperty="(UIElement.Opacity)">
                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                                <SplineDoubleKeyFrame KeyTime="00:00:00.200" Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="ButtonsVisibilityStates">
                    <VisualState x:Name="AllVisible" />
                    <VisualState x:Name="NoneVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CommandSpace" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PrimaryVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_SecondaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CloseButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="SecondaryVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_PrimaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CloseButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="CloseVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_PrimaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_SecondaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PrimaryAndSecondaryVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CloseButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PrimaryAndCloseVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_SecondaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="SecondaryAndCloseVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_PrimaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ChildWindowImage" Value="None">
                <Setter TargetName="PART_Image" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ChildWindowImage" Value="Hand">
                <Setter TargetName="PART_Image" Property="Fill">
                    <Setter.Value>
                        <VisualBrush Stretch="Fill" Visual="{DynamicResource ChildWindowHandImage}" />
                    </Setter.Value>
                </Setter>
            </Trigger>
            <Trigger Property="IsModal" Value="False">
                <Setter TargetName="PART_Overlay" Property="Background" Value="{x:Null}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="TitleBarIcon" Value="{x:Null}" />
                    <Condition Property="TitleBarIconTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_TitleBarIcon" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsVisible" Value="True" />
                    <Condition Property="IsWindowHostActive" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Border" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=NonActiveBorderBrush, Mode=OneWay}" />
                <Setter TargetName="PART_GlowEffect" Property="Effect" Value="{DynamicResource NonActiveGlowBrushEffect}" />
                <Setter TargetName="PART_TitleBar" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarNonActiveBackground, Mode=OneWay}" />
            </MultiTrigger>
            <Trigger Property="DefaultButton" Value="Primary">
                <Setter TargetName="PART_PrimaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.Accent}" />
            </Trigger>
            <Trigger Property="DefaultButton" Value="Secondary">
                <Setter TargetName="PART_SecondaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.Accent}" />
            </Trigger>
            <Trigger Property="DefaultButton" Value="Close">
                <Setter TargetName="PART_CloseButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.Accent}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MahApps.Styles.ContentDialog"
           BasedOn="{StaticResource MahApps.Styles.ChildWindow}"
           TargetType="{x:Type mah:ContentDialog}">
        <Setter Property="CloseButtonStyle" Value="{DynamicResource MahApps.Styles.Button.Dialogs}" />
        <Setter Property="PrimaryButtonStyle" Value="{DynamicResource MahApps.Styles.Button.Dialogs}" />
        <Setter Property="SecondaryButtonStyle" Value="{DynamicResource MahApps.Styles.Button.Dialogs}" />
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.ContentDialog}" />
    </Style>

    <Style x:Key="MahApps.Styles.Button.ContentDialog.TitleBarClose"
           BasedOn="{StaticResource MahApps.Styles.Button.MetroWindow.Close.Light.Win10}"
           TargetType="{x:Type Button}">
        <Setter Property="Width" Value="46" />
    </Style>

    <Style x:Key="MahApps.Styles.Button.ContentDialog.TitleClose.Win10"
           BasedOn="{StaticResource MahApps.Styles.Button.MetroWindow.Close.Light.Win10}"
           TargetType="{x:Type Button}">
        <Setter Property="Height" Value="32" />
        <Setter Property="Width" Value="32" />
    </Style>

    <ControlTemplate x:Key="MahApps.Templates.ContentDialog.Win10" TargetType="{x:Type mah:ContentDialog}">
        <Grid x:Name="PART_Overlay"
              Background="{TemplateBinding OverlayBrush}"
              ClipToBounds="True"
              FocusVisualStyle="{x:Null}"
              KeyboardNavigation.TabNavigation="None"
              Opacity="0"
              Visibility="Collapsed">
            <Grid x:Name="PART_Window"
                  Width="{TemplateBinding ChildWindowWidth}"
                  Height="{TemplateBinding ChildWindowHeight}"
                  MinWidth="{TemplateBinding ChildWindowMinWidth}"
                  MinHeight="{TemplateBinding ChildWindowMinHeight}"
                  MaxWidth="{TemplateBinding ChildWindowMaxWidth}"
                  MaxHeight="{TemplateBinding ChildWindowMaxHeight}"
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  FocusVisualStyle="{x:Null}"
                  UseLayoutRounding="True">
                <Grid x:Name="ScaleRoot" RenderTransformOrigin="0.5 0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleTransform" />
                    </Grid.RenderTransform>
                    <!--  the stroke is see-through, so the dialog lies under it and not the window behind  -->
                    <Border x:Name="BackgroundUnderlay"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <AdornerDecorator>
                            <Grid KeyboardNavigation.ControlTabNavigation="Cycle"
                                  KeyboardNavigation.DirectionalNavigation="Cycle"
                                  KeyboardNavigation.TabNavigation="Cycle">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>

                                <!--  the title bar, only with ShowTitleBar  -->
                                <Grid x:Name="PART_TitleBar"
                                      Grid.Row="0"
                                      Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                      Background="{TemplateBinding TitleBarBackground}"
                                      TextElement.Foreground="{TemplateBinding TitleBarForeground}"
                                      Visibility="{TemplateBinding ShowTitleBar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl x:Name="PART_TitleBarIcon"
                                                    Grid.Column="0"
                                                    Content="{TemplateBinding TitleBarIcon}"
                                                    ContentTemplate="{TemplateBinding TitleBarIconTemplate}"
                                                    Focusable="False" />
                                    <mah:MetroThumbContentControl x:Name="PART_TitleBarThumb"
                                                                  Grid.Column="1"
                                                                  Padding="12 0"
                                                                  HorizontalContentAlignment="{TemplateBinding TitleHorizontalAlignment}"
                                                                  VerticalContentAlignment="Center"
                                                                  Content="{TemplateBinding Title}"
                                                                  Focusable="False"
                                                                  FontFamily="{DynamicResource MahApps.Fonts.Family.Window.Title.Win10}"
                                                                  FontSize="{DynamicResource MahApps.Font.Size.Window.Title.Win10}"
                                                                  Foreground="{TemplateBinding TitleBarForeground}" />
                                    <Button x:Name="PART_TitleBarCloseButton"
                                            Grid.Column="2"
                                            Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                            Focusable="False"
                                            Style="{TemplateBinding TitleBarCloseButtonStyle}"
                                            ToolTip="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarCloseButtonToolTip, Mode=OneWay}"
                                            Visibility="{TemplateBinding ShowTitleBarCloseButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Path Width="10"
                                              Height="10"
                                              Data="F1M8.583,8L13,12.424 12.424,13 8,8.583 3.576,13 3,12.424 7.417,8 3,3.576 3.576,3 8,7.417 12.424,3 13,3.576z"
                                              Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                              RenderOptions.EdgeMode="Aliased"
                                              SnapsToDevicePixels="True"
                                              Stretch="Uniform" />
                                    </Button>
                                </Grid>

                                <!--  the dialog space of UWP: padding 24 18 24 24, title, content, buttons  -->
                                <Grid Grid.Row="1" Margin="24 18 24 24">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid x:Name="ContentTitle"
                                          Grid.Row="0"
                                          Margin="0 0 0 12">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <mah:MetroThumbContentControl x:Name="PART_ContentTitleThumb"
                                                                      Grid.Column="0"
                                                                      MaxHeight="56"
                                                                      HorizontalAlignment="Stretch"
                                                                      HorizontalContentAlignment="Left"
                                                                      VerticalContentAlignment="Top"
                                                                      Content="{TemplateBinding Title}"
                                                                      ContentTemplate="{TemplateBinding TitleTemplate}"
                                                                      Focusable="False"
                                                                      FontFamily="{TemplateBinding TitleFontFamily}"
                                                                      FontSize="{TemplateBinding TitleFontSize}"
                                                                      Foreground="{TemplateBinding Foreground}" />
                                        <Button x:Name="PART_ContentTitleCloseButton"
                                                Grid.Column="1"
                                                Margin="12 -6 -12 0"
                                                VerticalAlignment="Top"
                                                Focusable="False"
                                                Style="{StaticResource MahApps.Styles.Button.ContentDialog.TitleClose.Win10}"
                                                ToolTip="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarCloseButtonToolTip, Mode=OneWay}"
                                                Visibility="{TemplateBinding ShowTitleBarCloseButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                            <Path Width="10"
                                                  Height="10"
                                                  Data="F1M8.583,8L13,12.424 12.424,13 8,8.583 3.576,13 3,12.424 7.417,8 3,3.576 3.576,3 8,7.417 12.424,3 13,3.576z"
                                                  Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                  RenderOptions.EdgeMode="Aliased"
                                                  SnapsToDevicePixels="True"
                                                  Stretch="Uniform" />
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Row="1">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Rectangle x:Name="PART_Image"
                                                   Grid.Column="0"
                                                   Width="48"
                                                   Height="48"
                                                   Margin="0 0 12 0"
                                                   VerticalAlignment="Top" />
                                        <ContentPresenter x:Name="PART_Content"
                                                          Grid.Column="1"
                                                          Content="{TemplateBinding Content}"
                                                          ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                          TextElement.FontSize="{DynamicResource MahApps.Font.Size.Body.Win10}" />
                                    </Grid>

                                    <Grid x:Name="CommandSpace"
                                          Grid.Row="2"
                                          Margin="0 24 0 0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="0.5*" />
                                            <ColumnDefinition Width="0.5*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button x:Name="PART_PrimaryButton"
                                                Grid.Column="0"
                                                Margin="0 0 2 0"
                                                HorizontalAlignment="Stretch"
                                                Content="{TemplateBinding PrimaryButtonText}"
                                                IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}"
                                                Style="{TemplateBinding PrimaryButtonStyle}" />
                                        <Button x:Name="PART_SecondaryButton"
                                                Grid.Column="1"
                                                Grid.ColumnSpan="2"
                                                Margin="2 0 2 0"
                                                HorizontalAlignment="Stretch"
                                                Content="{TemplateBinding SecondaryButtonText}"
                                                IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}"
                                                Style="{TemplateBinding SecondaryButtonStyle}" />
                                        <Button x:Name="PART_CloseButton"
                                                Grid.Column="3"
                                                Margin="2 0 0 0"
                                                HorizontalAlignment="Stretch"
                                                Content="{TemplateBinding CloseButtonText}"
                                                Style="{TemplateBinding CloseButtonStyle}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </AdornerDecorator>
                    </Border>
                </Grid>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Default" />
                    <VisualState x:Name="Hide">
                        <Storyboard x:Name="HideStoryboard">
                            <DoubleAnimation Storyboard.TargetName="PART_Overlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0.083" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX">
                                <SplineDoubleKeyFrame KeySpline="0.1,0.9 0.2,1.0"
                                                      KeyTime="0:0:0.5"
                                                      Value="1.05" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY">
                                <SplineDoubleKeyFrame KeySpline="0.1,0.9 0.2,1.0"
                                                      KeyTime="0:0:0.5"
                                                      Value="1.05" />
                            </DoubleAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Overlay" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.5" Value="{x:Static Visibility.Collapsed}" />
