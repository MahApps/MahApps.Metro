    <Style x:Key="MahApps.Styles.ContentDialog.Win10" TargetType="{x:Type mah:ContentDialog}">
        <Setter Property="AllowMove" Value="False" />
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ChildWindowMaxHeight" Value="756" />
        <Setter Property="ChildWindowMaxWidth" Value="548" />
        <Setter Property="ChildWindowMinHeight" Value="184" />
        <Setter Property="ChildWindowMinWidth" Value="320" />
        <Setter Property="CloseButtonStyle" Value="{DynamicResource MahApps.Styles.Button.Win10}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.Win10}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Control.Win10}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Foreground}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="OverlayBrush" Value="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Overlay}" />
        <Setter Property="PrimaryButtonStyle" Value="{DynamicResource MahApps.Styles.Button.Win10}" />
        <Setter Property="SecondaryButtonStyle" Value="{DynamicResource MahApps.Styles.Button.Win10}" />
        <Setter Property="ShowTitleBar" Value="False" />
        <Setter Property="ShowTitleBarCloseButton" Value="False" />
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.ContentDialog.Win10}" />
        <Setter Property="TitleBarBackground" Value="{DynamicResource MahApps.Brushes.WindowTitle}" />
        <Setter Property="TitleBarCloseButtonStyle" Value="{DynamicResource MahApps.Styles.Button.ContentDialog.TitleBarClose}" />
        <Setter Property="TitleBarForeground" Value="{DynamicResource MahApps.Brushes.IdealForeground}" />
        <Setter Property="TitleFontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.Win10}" />
        <Setter Property="TitleFontSize" Value="{DynamicResource MahApps.Font.Size.Subtitle.Win10}" />
        <Setter Property="TitleTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock Text="{Binding}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="MahApps.Styles.Button.ContentDialog.Close.WinUI" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.WinUI.TextPrimary}" />
        <Setter Property="MinWidth" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}">
                        <ContentPresenter Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="#FFC42B1C" />
                            <Setter Property="Foreground" Value="#FFFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter Property="Background" Value="#E6C42B1C" />
                            <Setter Property="Foreground" Value="#B3FFFFFF" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="46" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{DynamicResource MahApps.CornerRadius.WinUI.Control}" />
    </Style>

    <ControlTemplate x:Key="MahApps.Templates.ContentDialog.WinUI" TargetType="{x:Type mah:ContentDialog}">
        <Grid x:Name="PART_Overlay"
              Background="{TemplateBinding OverlayBrush}"
              ClipToBounds="True"
              FocusVisualStyle="{x:Null}"
              KeyboardNavigation.TabNavigation="None"
              Opacity="0"
              Visibility="Collapsed">
            <Grid x:Name="PART_Window"
                  Width="{TemplateBinding ChildWindowWidth}"
                  Height="{TemplateBinding ChildWindowHeight}"
                  MinWidth="{TemplateBinding ChildWindowMinWidth}"
                  MinHeight="{TemplateBinding ChildWindowMinHeight}"
                  MaxWidth="{TemplateBinding ChildWindowMaxWidth}"
                  MaxHeight="{TemplateBinding ChildWindowMaxHeight}"
                  Margin="{TemplateBinding Padding}"
                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                  FocusVisualStyle="{x:Null}"
                  UseLayoutRounding="True">
                <Grid x:Name="ScaleRoot" RenderTransformOrigin="0.5 0.5">
                    <Grid.RenderTransform>
                        <ScaleTransform x:Name="ScaleTransform" />
                    </Grid.RenderTransform>
                    <!--  the stroke is see-through, so the dialog lies under it and not the window behind  -->
                    <Border x:Name="BackgroundUnderlay"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}" />
                    <Border x:Name="PART_Border"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <Grid x:Name="ClipGrid">
                            <Grid.Clip>
                                <MultiBinding Converter="{x:Static mahConverters:ClipGeometryConverter.Instance}">
                                    <Binding ElementName="ClipGrid" Path="ActualWidth" />
                                    <Binding ElementName="ClipGrid" Path="ActualHeight" />
                                    <Binding ElementName="PART_Border" Path="CornerRadius" />
                                    <Binding ElementName="PART_Border" Path="BorderThickness" />
                                    <Binding ElementName="PART_Border" Path="Padding" />
                                </MultiBinding>
                            </Grid.Clip>
                            <AdornerDecorator>
                                <Grid KeyboardNavigation.ControlTabNavigation="Cycle"
                                      KeyboardNavigation.DirectionalNavigation="Cycle"
                                      KeyboardNavigation.TabNavigation="Cycle">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!--  the title bar, only with ShowTitleBar, a Windows 11 caption over the content layer  -->
                                    <Border x:Name="TitleBarBorder"
                                            Grid.Row="0"
                                            BorderBrush="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Separator}"
                                            BorderThickness="0 0 0 1"
                                            Visibility="{TemplateBinding ShowTitleBar, Converter={StaticResource BooleanToVisibilityConverter}}">
                                        <Grid x:Name="PART_TitleBar"
                                              Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                              Background="{TemplateBinding TitleBarBackground}"
                                              TextElement.Foreground="{TemplateBinding TitleBarForeground}">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl x:Name="PART_TitleBarIcon"
                                                            Grid.Column="0"
                                                            Content="{TemplateBinding TitleBarIcon}"
                                                            ContentTemplate="{TemplateBinding TitleBarIconTemplate}"
                                                            Focusable="False" />
                                            <mah:MetroThumbContentControl x:Name="PART_TitleBarThumb"
                                                                          Grid.Column="1"
                                                                          Padding="12 0"
                                                                          HorizontalContentAlignment="{TemplateBinding TitleHorizontalAlignment}"
                                                                          VerticalContentAlignment="Center"
                                                                          Content="{TemplateBinding Title}"
                                                                          Focusable="False"
                                                                          FontFamily="{DynamicResource MahApps.Fonts.Family.Window.Title.WinUI}"
                                                                          FontSize="{DynamicResource MahApps.Font.Size.Window.Title.WinUI}"
                                                                          Foreground="{TemplateBinding TitleBarForeground}" />
                                            <Button x:Name="PART_TitleBarCloseButton"
                                                    Grid.Column="2"
                                                    Height="{Binding TitleBarHeight, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}"
                                                    Focusable="False"
                                                    Style="{TemplateBinding TitleBarCloseButtonStyle}"
                                                    ToolTip="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarCloseButtonToolTip, Mode=OneWay}"
                                                    Visibility="{TemplateBinding ShowTitleBarCloseButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                <Path Width="10"
                                                      Height="10"
                                                      Data="F1M8.583,8L13,12.424 12.424,13 8,8.583 3.576,13 3,12.424 7.417,8 3,3.576 3.576,3 8,7.417 12.424,3 13,3.576z"
                                                      Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                      RenderOptions.EdgeMode="Aliased"
                                                      SnapsToDevicePixels="True"
                                                      Stretch="Uniform" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <!--  the content on the lighter layer, a line under it  -->
                                    <Border x:Name="ContentLayer"
                                            Grid.Row="1"
                                            Padding="24"
                                            Background="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.TopOverlay}"
                                            BorderBrush="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Separator}"
                                            BorderThickness="0 0 0 1">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="*" />
                                            </Grid.RowDefinitions>
                                            <Grid x:Name="ContentTitle"
                                                  Grid.Row="0"
                                                  Margin="0 0 0 12">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <mah:MetroThumbContentControl x:Name="PART_ContentTitleThumb"
                                                                              Grid.Column="0"
                                                                              HorizontalAlignment="Stretch"
                                                                              HorizontalContentAlignment="Left"
                                                                              VerticalContentAlignment="Top"
                                                                              Content="{TemplateBinding Title}"
                                                                              ContentTemplate="{TemplateBinding TitleTemplate}"
                                                                              Focusable="False"
                                                                              FontFamily="{TemplateBinding TitleFontFamily}"
                                                                              FontSize="{TemplateBinding TitleFontSize}"
                                                                              Foreground="{TemplateBinding Foreground}" />
                                                <Button x:Name="PART_ContentTitleCloseButton"
                                                        Grid.Column="1"
                                                        Width="32"
                                                        Height="32"
                                                        Margin="12 -6 -12 0"
                                                        VerticalAlignment="Top"
                                                        Focusable="False"
                                                        Style="{DynamicResource MahApps.Styles.Button.ContentDialog.Close.WinUI}"
                                                        ToolTip="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=TitleBarCloseButtonToolTip, Mode=OneWay}"
                                                        Visibility="{TemplateBinding ShowTitleBarCloseButton, Converter={StaticResource BooleanToVisibilityConverter}}">
                                                    <Path Width="10"
                                                          Height="10"
                                                          Data="F1M8.583,8L13,12.424 12.424,13 8,8.583 3.576,13 3,12.424 7.417,8 3,3.576 3.576,3 8,7.417 12.424,3 13,3.576z"
                                                          Fill="{Binding RelativeSource={RelativeSource AncestorType=Button}, Path=Foreground}"
                                                          RenderOptions.EdgeMode="Aliased"
                                                          SnapsToDevicePixels="True"
                                                          Stretch="Uniform" />
                                                </Button>
                                            </Grid>
                                            <Grid Grid.Row="1">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Rectangle x:Name="PART_Image"
                                                           Grid.Column="0"
                                                           Width="48"
                                                           Height="48"
                                                           Margin="0 0 12 0"
                                                           VerticalAlignment="Top" />
                                                <ContentPresenter x:Name="PART_Content"
                                                                  Grid.Column="1"
                                                                  Content="{TemplateBinding Content}"
                                                                  ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                                                  ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  ContentTemplateSelector="{TemplateBinding ContentTemplateSelector}"
                                                                  TextElement.FontSize="{DynamicResource MahApps.Font.Size.Body.WinUI}" />
                                            </Grid>
                                        </Grid>
                                    </Border>

                                    <!--  the buttons on the base colour  -->
                                    <Border x:Name="CommandSpace"
                                            Grid.Row="2"
                                            Padding="24"
                                            VerticalAlignment="Bottom"
                                            Background="{TemplateBinding Background}">
                                        <Grid x:Name="CommandGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition x:Name="PrimaryColumn" Width="*" />
                                                <ColumnDefinition x:Name="FirstSpacer" Width="0" />
                                                <ColumnDefinition x:Name="SecondaryColumn" Width="0" />
                                                <ColumnDefinition x:Name="SecondSpacer" Width="8" />
                                                <ColumnDefinition x:Name="CloseColumn" Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button x:Name="PART_PrimaryButton"
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Stretch"
                                                    Content="{TemplateBinding PrimaryButtonText}"
                                                    IsEnabled="{TemplateBinding IsPrimaryButtonEnabled}"
                                                    Style="{TemplateBinding PrimaryButtonStyle}" />
                                            <Button x:Name="PART_SecondaryButton"
                                                    Grid.Column="0"
                                                    HorizontalAlignment="Stretch"
                                                    Content="{TemplateBinding SecondaryButtonText}"
                                                    IsEnabled="{TemplateBinding IsSecondaryButtonEnabled}"
                                                    Style="{TemplateBinding SecondaryButtonStyle}" />
                                            <Button x:Name="PART_CloseButton"
                                                    Grid.Column="4"
                                                    HorizontalAlignment="Stretch"
                                                    Content="{TemplateBinding CloseButtonText}"
                                                    Style="{TemplateBinding CloseButtonStyle}" />
                                        </Grid>
                                    </Border>
                                </Grid>
                            </AdornerDecorator>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>

            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup>
                    <VisualState x:Name="Default" />
                    <VisualState x:Name="Hide">
                        <Storyboard x:Name="HideStoryboard">
                            <DoubleAnimation Storyboard.TargetName="PART_Overlay"
                                             Storyboard.TargetProperty="Opacity"
                                             To="0"
                                             Duration="0:0:0.083" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX">
                                <SplineDoubleKeyFrame KeySpline="0,0 0,1"
                                                      KeyTime="0:0:0.167"
                                                      Value="1.05" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY">
                                <SplineDoubleKeyFrame KeySpline="0,0 0,1"
                                                      KeyTime="0:0:0.167"
                                                      Value="1.05" />
                            </DoubleAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Overlay" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0:0:0.167" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="Show">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_Overlay" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                            <DoubleAnimation Storyboard.TargetName="PART_Overlay"
                                             Storyboard.TargetProperty="Opacity"
                                             From="0"
                                             To="1"
                                             Duration="0:0:0.083" />
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleX">
                                <DiscreteDoubleKeyFrame KeyTime="0" Value="1.05" />
                                <SplineDoubleKeyFrame KeySpline="0,0 0,1"
                                                      KeyTime="0:0:0.25"
                                                      Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                            <DoubleAnimationUsingKeyFrames Storyboard.TargetName="ScaleTransform" Storyboard.TargetProperty="ScaleY">
                                <DiscreteDoubleKeyFrame KeyTime="0" Value="1.05" />
                                <SplineDoubleKeyFrame KeySpline="0,0 0,1"
                                                      KeyTime="0:0:0.25"
                                                      Value="1" />
                            </DoubleAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
                <VisualStateGroup x:Name="ButtonsVisibilityStates">
                    <VisualState x:Name="AllVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="FirstSpacer" Storyboard.TargetProperty="Width">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <GridLength>8</GridLength>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="SecondaryColumn" Storyboard.TargetProperty="Width">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <GridLength>*</GridLength>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_SecondaryButton" Storyboard.TargetProperty="(Grid.Column)">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <sys:Int32>2</sys:Int32>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="NoneVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="CommandSpace" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PrimaryVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_PrimaryButton" Storyboard.TargetProperty="(Grid.Column)">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <sys:Int32>4</sys:Int32>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_SecondaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CloseButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="SecondaryVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_SecondaryButton" Storyboard.TargetProperty="(Grid.Column)">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <sys:Int32>4</sys:Int32>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_PrimaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CloseButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="CloseVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_PrimaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_SecondaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PrimaryAndSecondaryVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_SecondaryButton" Storyboard.TargetProperty="(Grid.Column)">
                                <DiscreteObjectKeyFrame KeyTime="0">
                                    <DiscreteObjectKeyFrame.Value>
                                        <sys:Int32>4</sys:Int32>
                                    </DiscreteObjectKeyFrame.Value>
                                </DiscreteObjectKeyFrame>
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_CloseButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="PrimaryAndCloseVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_SecondaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    <VisualState x:Name="SecondaryAndCloseVisible">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="PART_PrimaryButton" Storyboard.TargetProperty="Visibility">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Collapsed}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ShowTitleBar" Value="True">
                <Setter TargetName="ContentTitle" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Title" Value="{x:Null}" />
                    <Condition Property="ShowTitleBarCloseButton" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ContentTitle" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Title" Value="" />
                    <Condition Property="ShowTitleBarCloseButton" Value="False" />
                </MultiTrigger.Conditions>
                <Setter TargetName="ContentTitle" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <Trigger Property="ChildWindowImage" Value="None">
                <Setter TargetName="PART_Image" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="IsModal" Value="False">
                <Setter TargetName="PART_Overlay" Property="Background" Value="{x:Null}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="TitleBarIcon" Value="{x:Null}" />
                    <Condition Property="TitleBarIconTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_TitleBarIcon" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <Trigger Property="DefaultButton" Value="Primary">
                <Setter TargetName="PART_PrimaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.WinUI}" />
            </Trigger>
            <Trigger Property="DefaultButton" Value="Secondary">
                <Setter TargetName="PART_SecondaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.WinUI}" />
            </Trigger>
            <Trigger Property="DefaultButton" Value="Close">
                <Setter TargetName="PART_CloseButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.WinUI}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MahApps.Styles.ContentDialog.WinUI" TargetType="{x:Type mah:ContentDialog}">
        <Setter Property="AllowMove" Value="False" />
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="ChildWindowMaxHeight" Value="756" />
        <Setter Property="ChildWindowMaxWidth" Value="548" />
        <Setter Property="ChildWindowMinHeight" Value="184" />
        <Setter Property="ChildWindowMinWidth" Value="320" />
        <Setter Property="CloseButtonStyle" Value="{DynamicResource MahApps.Styles.Button.WinUI}" />
        <Setter Property="CornerRadius" Value="{DynamicResource MahApps.CornerRadius.WinUI.Overlay}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.WinUI}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Control.WinUI}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Foreground}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="OverlayBrush" Value="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Overlay}" />
        <Setter Property="PrimaryButtonStyle" Value="{DynamicResource MahApps.Styles.Button.WinUI}" />
        <Setter Property="SecondaryButtonStyle" Value="{DynamicResource MahApps.Styles.Button.WinUI}" />
        <Setter Property="ShowTitleBar" Value="False" />
        <Setter Property="ShowTitleBarCloseButton" Value="False" />
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.ContentDialog.WinUI}" />
        <Setter Property="TitleBarBackground" Value="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.TopOverlay}" />
        <Setter Property="TitleBarCloseButtonStyle" Value="{DynamicResource MahApps.Styles.Button.ContentDialog.TitleBarClose}" />
        <Setter Property="TitleBarForeground" Value="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Foreground}" />
        <Setter Property="TitleFontFamily" Value="{DynamicResource MahApps.Fonts.Family.Display.WinUI}" />
        <Setter Property="TitleFontSize" Value="{DynamicResource MahApps.Font.Size.Subtitle.WinUI}" />
        <Setter Property="TitleTemplate">
            <Setter.Value>
                <DataTemplate>
                    <TextBlock MaxHeight="56"
                               FontWeight="SemiBold"
                               Text="{Binding}"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="Wrap" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

</ResourceDictionary>
