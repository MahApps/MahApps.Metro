<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:behaviors="clr-namespace:MahApps.Metro.Behaviors"
                    xmlns:dialogs="clr-namespace:MahApps.Metro.Controls.Dialogs"
                    xmlns:lang="clr-namespace:MahApps.Metro.Lang"
                    xmlns:mah="clr-namespace:MahApps.Metro.Controls"
                    xmlns:mahConverters="clr-namespace:MahApps.Metro.Converters">
    <ControlTemplate x:Key="MahApps.Templates.LoginDialog" TargetType="{x:Type dialogs:LoginDialog}">
        <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentPresenter x:Name="PART_Top"
                              Grid.Row="0"
                              AutomationProperties.Name="{x:Static lang:Automation.DialogTop}"
                              Content="{TemplateBinding DialogTop}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

            <Grid Grid.Row="1" Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{TemplateBinding DialogContentMargin}" />
                    <ColumnDefinition Width="{TemplateBinding DialogContentWidth}" />
                    <ColumnDefinition Width="{TemplateBinding DialogContentMargin}" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="PART_Icon"
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="{x:Static lang:Automation.DialogIcon}"
                                Content="{TemplateBinding Icon}"
                                ContentTemplate="{TemplateBinding IconTemplate}"
                                Focusable="False"
                                UseLayoutRounding="False" />

                <TextBlock x:Name="PART_Title"
                           Grid.Row="0"
                           Grid.Column="1"
                           AutomationProperties.Name="{x:Static lang:Automation.DialogTitle}"
                           FontSize="{TemplateBinding DialogTitleFontSize}"
                           Foreground="{TemplateBinding Foreground}"
                           Text="{TemplateBinding Title}"
                           TextWrapping="Wrap" />

                <Grid x:Name="PART_Content"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0 10 0 0"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                      AutomationProperties.Name="{x:Static lang:Automation.DialogContent}"
                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" MinHeight="20" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <TextBlock x:Name="PART_MessageTextBlock"
                               Grid.Row="0"
                               Margin="0 5 0 0"
                               FontSize="{TemplateBinding DialogMessageFontSize}"
                               Foreground="{TemplateBinding MessageForeground}"
                               Text="{TemplateBinding Message}"
                               TextWrapping="Wrap" />

                    <TextBox x:Name="PART_TextBox"
                             Grid.Row="1"
                             Margin="0 5 0 0"
                             mah:TextBoxHelper.SelectAllOnFocus="True"
                             mah:TextBoxHelper.Watermark="{TemplateBinding UsernameWatermark}"
                             mah:VisibilityHelper.IsCollapsed="{TemplateBinding ShouldHideUsername}"
                             CharacterCasing="{TemplateBinding UsernameCharacterCasing}"
                             FontSize="{TemplateBinding DialogMessageFontSize}"
                             Foreground="{TemplateBinding Foreground}"
                             Text="{Binding Username, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                             TextWrapping="Wrap" />

                    <PasswordBox x:Name="PART_PasswordBox"
                                 Grid.Row="2"
                                 Margin="0 5 0 0"
                                 behaviors:PasswordBoxBindingBehavior.Password="{Binding Password, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                 mah:TextBoxHelper.SelectAllOnFocus="True"
                                 mah:TextBoxHelper.Watermark="{TemplateBinding PasswordWatermark}"
                                 FontSize="{TemplateBinding DialogMessageFontSize}"
                                 Foreground="{TemplateBinding Foreground}" />

                    <CheckBox x:Name="PART_RememberCheckBox"
                              Grid.Row="3"
                              Margin="0 5 0 0"
                              Content="{TemplateBinding RememberCheckBoxText}"
                              FontSize="{TemplateBinding DialogMessageFontSize}"
                              IsChecked="{Binding RememberCheckBoxChecked, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                              Visibility="{TemplateBinding RememberCheckBoxVisibility}" />

                    <StackPanel Grid.Row="5"
                                MinHeight="85"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="PART_AffirmativeButton"
                                Margin="0 0 5 0"
                                Content="{TemplateBinding AffirmativeButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Dialogs.Accent}" />
                        <Button x:Name="PART_NegativeButton"
                                Margin="5 0 5 0"
                                Content="{TemplateBinding NegativeButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Dialogs}"
                                Visibility="{TemplateBinding NegativeButtonButtonVisibility}" />
                    </StackPanel>
                </Grid>
            </Grid>

            <ContentPresenter x:Name="PART_Bottom"
                              Grid.Row="2"
                              AutomationProperties.Name="{x:Static lang:Automation.DialogBottom}"
                              Content="{TemplateBinding DialogBottom}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>
        <ControlTemplate.Triggers>
            <!--  Told no colour of its own, the message is written along with the rest of the dialog  -->
            <Trigger Property="MessageForeground" Value="{x:Null}">
                <Setter TargetName="PART_MessageTextBlock" Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="Affirmative">
                <Setter TargetName="PART_AffirmativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.Accent}" />
                <Setter TargetName="PART_NegativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="Negative">
                <Setter TargetName="PART_AffirmativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs}" />
                <Setter TargetName="PART_NegativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.Accent}" />
            </Trigger>
            <Trigger Property="EnablePasswordPreview" Value="True">
                <Setter TargetName="PART_PasswordBox" Property="Style" Value="{DynamicResource MahApps.Styles.PasswordBox.Win8}" />
            </Trigger>

            <Trigger Property="ColorScheme" Value="Accented">
                <Setter TargetName="PART_NegativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.AccentHighlight}" />
                <Setter TargetName="PART_PasswordBox" Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                <Setter TargetName="PART_TextBox" Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
            </Trigger>

            <Trigger Property="Title" Value="{x:Null}">
                <Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <EventTrigger RoutedEvent="Loaded">
                <EventTrigger.Actions>
                    <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.Dialogs.Show}" />
                </EventTrigger.Actions>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MahApps.Styles.LoginDialog"
           BasedOn="{StaticResource MahApps.Styles.BaseMetroDialog}"
           TargetType="{x:Type dialogs:LoginDialog}">
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.LoginDialog}" />
    </Style>

    <!--  The Windows 10 look, a card like the content dialog of that look; see BaseMetroDialog.xaml  -->

    <ControlTemplate x:Key="MahApps.Templates.LoginDialog.Win10" TargetType="{x:Type dialogs:LoginDialog}">
        <Grid x:Name="Card"
              MinWidth="320"
              MaxWidth="{DynamicResource MahApps.Sizes.Dialogs.Card.MaxWidth}"
              HorizontalAlignment="Center"
              TextElement.Foreground="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Foreground}"
              UseLayoutRounding="True">
            <!--  the stroke is see-through, so the card lies under it and not the window behind  -->
            <Border x:Name="BackgroundUnderlay" Background="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Background}" />
            <Border x:Name="CardBorder"
                    Background="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Background}"
                    BorderBrush="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Border}"
                    BorderThickness="1">
                <Grid Margin="24 18 24 24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentPresenter x:Name="PART_Top"
                                      Grid.Row="0"
                                      AutomationProperties.Name="{x:Static lang:Automation.DialogTop}"
                                      Content="{TemplateBinding DialogTop}" />
                    <TextBlock x:Name="PART_Title"
                               Grid.Row="1"
                               Margin="0 0 0 12"
                               AutomationProperties.Name="{x:Static lang:Automation.DialogTitle}"
                               FontSize="{TemplateBinding DialogTitleFontSize}"
                               Text="{TemplateBinding Title}"
                               TextWrapping="Wrap" />
                    <StackPanel x:Name="PART_Content"
                                Grid.Row="2"
                                AutomationProperties.Name="{x:Static lang:Automation.DialogContent}">
                        <TextBlock x:Name="PART_MessageTextBlock"
                                   FontSize="{TemplateBinding DialogMessageFontSize}"
                                   Foreground="{TemplateBinding MessageForeground}"
                                   Text="{TemplateBinding Message}"
                                   TextWrapping="Wrap" />
                        <TextBox x:Name="PART_TextBox"
                                 Margin="0 12 0 0"
                                 mah:TextBoxHelper.SelectAllOnFocus="True"
                                 mah:TextBoxHelper.Watermark="{TemplateBinding UsernameWatermark}"
                                 mah:VisibilityHelper.IsCollapsed="{TemplateBinding ShouldHideUsername}"
                                 CharacterCasing="{TemplateBinding UsernameCharacterCasing}"
                                 FontSize="{TemplateBinding DialogMessageFontSize}"
                                 Style="{DynamicResource MahApps.Styles.TextBox.Win10}"
                                 Text="{Binding Username, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                        <PasswordBox x:Name="PART_PasswordBox"
                                     Margin="0 8 0 0"
                                     behaviors:PasswordBoxBindingBehavior.Password="{Binding Password, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                     mah:PasswordBoxHelper.ShowRevealButton="{TemplateBinding EnablePasswordPreview}"
                                     mah:TextBoxHelper.SelectAllOnFocus="True"
                                     mah:TextBoxHelper.Watermark="{TemplateBinding PasswordWatermark}"
                                     FontSize="{TemplateBinding DialogMessageFontSize}"
                                     Style="{DynamicResource MahApps.Styles.PasswordBox.Win10}" />
                        <CheckBox x:Name="PART_RememberCheckBox"
                                  Margin="0 8 0 0"
                                  Content="{TemplateBinding RememberCheckBoxText}"
                                  FontSize="{TemplateBinding DialogMessageFontSize}"
                                  IsChecked="{Binding RememberCheckBoxChecked, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                  Style="{DynamicResource MahApps.Styles.CheckBox.Win10}"
                                  Visibility="{TemplateBinding RememberCheckBoxVisibility}" />
                    </StackPanel>
                    <UniformGrid x:Name="ButtonRow"
                                 Grid.Row="3"
                                 Margin="-4 24 -4 0"
                                 Rows="1">
                        <Button x:Name="PART_AffirmativeButton"
                                Margin="4 0"
                                HorizontalAlignment="Stretch"
                                Content="{TemplateBinding AffirmativeButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Accent.Win10}" />
                        <Button x:Name="PART_NegativeButton"
                                Margin="4 0"
                                HorizontalAlignment="Stretch"
                                Content="{TemplateBinding NegativeButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Win10}"
                                Visibility="{TemplateBinding NegativeButtonButtonVisibility}" />
                    </UniformGrid>
                    <ContentPresenter x:Name="PART_Bottom"
                                      Grid.Row="4"
                                      AutomationProperties.Name="{x:Static lang:Automation.DialogBottom}"
                                      Content="{TemplateBinding DialogBottom}" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <!--  Told no colour of its own, the message is written along with the rest of the card  -->
            <Trigger Property="MessageForeground" Value="{x:Null}">
                <Setter TargetName="PART_MessageTextBlock" Property="Foreground" Value="{Binding (TextElement.Foreground), ElementName=Card}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="Affirmative">
                <Setter TargetName="PART_AffirmativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.Win10}" />
                <Setter TargetName="PART_NegativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Win10}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="Negative">
                <Setter TargetName="PART_AffirmativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Win10}" />
                <Setter TargetName="PART_NegativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.Win10}" />
            </Trigger>
            <!--  a single button stands in the right half, as in the content dialog  -->
            <Trigger Property="NegativeButtonButtonVisibility" Value="Collapsed">
                <Setter TargetName="ButtonRow" Property="Columns" Value="2" />
                <Setter TargetName="ButtonRow" Property="FirstColumn" Value="1" />
            </Trigger>
            <Trigger Property="Title" Value="{x:Null}">
                <Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <EventTrigger RoutedEvent="Loaded">
                <EventTrigger.Actions>
                    <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.Dialogs.Show}" />
                </EventTrigger.Actions>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  The WinUI look, the content on the lighter layer and the buttons on the base colour  -->

    <ControlTemplate x:Key="MahApps.Templates.LoginDialog.WinUI" TargetType="{x:Type dialogs:LoginDialog}">
        <Grid x:Name="Card"
              MinWidth="320"
              MaxWidth="{DynamicResource MahApps.Sizes.Dialogs.Card.MaxWidth}"
              HorizontalAlignment="Center"
              TextElement.Foreground="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Foreground}"
              UseLayoutRounding="True">
            <!--  the stroke is see-through, so the card lies under it and not the window behind  -->
            <Border x:Name="BackgroundUnderlay"
                    Background="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Background}"
                    CornerRadius="{DynamicResource MahApps.CornerRadius.WinUI.Overlay}" />
            <Border x:Name="CardBorder"
                    Background="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Background}"
                    BorderBrush="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource MahApps.CornerRadius.WinUI.Overlay}">
                <Grid x:Name="ClipGrid">
                    <Grid.Clip>
                        <MultiBinding Converter="{x:Static mahConverters:ClipGeometryConverter.Instance}">
                            <Binding ElementName="ClipGrid" Path="ActualWidth" />
                            <Binding ElementName="ClipGrid" Path="ActualHeight" />
                            <Binding ElementName="CardBorder" Path="CornerRadius" />
                            <Binding ElementName="CardBorder" Path="BorderThickness" />
                            <Binding ElementName="CardBorder" Path="Padding" />
                        </MultiBinding>
                    </Grid.Clip>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  the content on the lighter layer, a line under it  -->
                    <Border x:Name="ContentLayer"
                            Grid.Row="0"
                            Padding="24"
                            Background="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.TopOverlay}"
                            BorderBrush="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Separator}"
                            BorderThickness="0 0 0 1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ContentPresenter x:Name="PART_Top"
                                              Grid.Row="0"
                                              AutomationProperties.Name="{x:Static lang:Automation.DialogTop}"
                                              Content="{TemplateBinding DialogTop}" />
                            <TextBlock x:Name="PART_Title"
                                       Grid.Row="1"
                                       Margin="0 0 0 12"
                                       AutomationProperties.Name="{x:Static lang:Automation.DialogTitle}"
                                       FontFamily="{DynamicResource MahApps.Fonts.Family.Display.WinUI}"
                                       FontSize="{TemplateBinding DialogTitleFontSize}"
                                       FontWeight="SemiBold"
                                       Text="{TemplateBinding Title}"
                                       TextWrapping="Wrap" />
                            <StackPanel x:Name="PART_Content"
                                        Grid.Row="2"
                                        AutomationProperties.Name="{x:Static lang:Automation.DialogContent}">
                                <TextBlock x:Name="PART_MessageTextBlock"
                                           FontSize="{TemplateBinding DialogMessageFontSize}"
                                           Foreground="{TemplateBinding MessageForeground}"
                                           Text="{TemplateBinding Message}"
                                           TextWrapping="Wrap" />
                                <TextBox x:Name="PART_TextBox"
                                         Margin="0 12 0 0"
                                         mah:TextBoxHelper.SelectAllOnFocus="True"
                                         mah:TextBoxHelper.Watermark="{TemplateBinding UsernameWatermark}"
                                         mah:VisibilityHelper.IsCollapsed="{TemplateBinding ShouldHideUsername}"
                                         CharacterCasing="{TemplateBinding UsernameCharacterCasing}"
                                         FontSize="{TemplateBinding DialogMessageFontSize}"
                                         Style="{DynamicResource MahApps.Styles.TextBox.WinUI}"
                                         Text="{Binding Username, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}" />
                                <PasswordBox x:Name="PART_PasswordBox"
                                             Margin="0 8 0 0"
                                             behaviors:PasswordBoxBindingBehavior.Password="{Binding Password, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                             mah:PasswordBoxHelper.ShowRevealButton="{TemplateBinding EnablePasswordPreview}"
                                             mah:TextBoxHelper.SelectAllOnFocus="True"
                                             mah:TextBoxHelper.Watermark="{TemplateBinding PasswordWatermark}"
                                             FontSize="{TemplateBinding DialogMessageFontSize}"
                                             Style="{DynamicResource MahApps.Styles.PasswordBox.WinUI}" />
                                <CheckBox x:Name="PART_RememberCheckBox"
                                          Margin="0 8 0 0"
                                          Content="{TemplateBinding RememberCheckBoxText}"
                                          FontSize="{TemplateBinding DialogMessageFontSize}"
                                          IsChecked="{Binding RememberCheckBoxChecked, RelativeSource={RelativeSource TemplatedParent}, UpdateSourceTrigger=PropertyChanged}"
                                          Style="{DynamicResource MahApps.Styles.CheckBox.WinUI}"
                                          Visibility="{TemplateBinding RememberCheckBoxVisibility}" />
                            </StackPanel>
                            <ContentPresenter x:Name="PART_Bottom"
                                              Grid.Row="3"
                                              AutomationProperties.Name="{x:Static lang:Automation.DialogBottom}"
                                              Content="{TemplateBinding DialogBottom}" />
                        </Grid>
                    </Border>
                    <!--  the buttons on the base colour  -->
                    <Border x:Name="CommandSpace"
                            Grid.Row="1"
                            Padding="20 24"
                            Background="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Background}">
                        <UniformGrid x:Name="ButtonRow" Rows="1">
                            <Button x:Name="PART_AffirmativeButton"
                                    Margin="4 0"
                                    HorizontalAlignment="Stretch"
                                    Content="{TemplateBinding AffirmativeButtonText}"
                                    FontSize="{TemplateBinding DialogButtonFontSize}"
                                    Style="{DynamicResource MahApps.Styles.Button.Accent.WinUI}" />
                            <Button x:Name="PART_NegativeButton"
                                    Margin="4 0"
                                    HorizontalAlignment="Stretch"
                                    Content="{TemplateBinding NegativeButtonText}"
                                    FontSize="{TemplateBinding DialogButtonFontSize}"
                                    Style="{DynamicResource MahApps.Styles.Button.WinUI}"
                                    Visibility="{TemplateBinding NegativeButtonButtonVisibility}" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <!--  Told no colour of its own, the message is written along with the rest of the card  -->
            <Trigger Property="MessageForeground" Value="{x:Null}">
                <Setter TargetName="PART_MessageTextBlock" Property="Foreground" Value="{Binding (TextElement.Foreground), ElementName=Card}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="Affirmative">
                <Setter TargetName="PART_AffirmativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.WinUI}" />
                <Setter TargetName="PART_NegativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.WinUI}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="Negative">
                <Setter TargetName="PART_AffirmativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.WinUI}" />
                <Setter TargetName="PART_NegativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.WinUI}" />
            </Trigger>
            <!--  a single button stands in the right half, as in the content dialog  -->
            <Trigger Property="NegativeButtonButtonVisibility" Value="Collapsed">
                <Setter TargetName="ButtonRow" Property="Columns" Value="2" />
                <Setter TargetName="ButtonRow" Property="FirstColumn" Value="1" />
            </Trigger>
            <Trigger Property="Title" Value="{x:Null}">
                <Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <EventTrigger RoutedEvent="Loaded">
                <EventTrigger.Actions>
                    <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.Dialogs.Show}" />
                </EventTrigger.Actions>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MahApps.Styles.LoginDialog.Win10"
           BasedOn="{StaticResource MahApps.Styles.LoginDialog}"
           TargetType="{x:Type dialogs:LoginDialog}">
        <Setter Property="DialogButtonFontSize" Value="{DynamicResource MahApps.Font.Size.Control.Win10}" />
        <Setter Property="DialogMessageFontSize" Value="{DynamicResource MahApps.Font.Size.Body.Win10}" />
        <Setter Property="DialogTitleFontSize" Value="{DynamicResource MahApps.Font.Size.Subtitle.Win10}" />
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.Win10}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Control.Win10}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.LoginDialog.Win10}" />
    </Style>

    <Style x:Key="MahApps.Styles.LoginDialog.WinUI"
           BasedOn="{StaticResource MahApps.Styles.LoginDialog}"
           TargetType="{x:Type dialogs:LoginDialog}">
        <Setter Property="DialogButtonFontSize" Value="{DynamicResource MahApps.Font.Size.Control.WinUI}" />
        <Setter Property="DialogMessageFontSize" Value="{DynamicResource MahApps.Font.Size.Body.WinUI}" />
        <Setter Property="DialogTitleFontSize" Value="{DynamicResource MahApps.Font.Size.Subtitle.WinUI}" />
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.WinUI}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Control.WinUI}" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.LoginDialog.WinUI}" />
    </Style>
</ResourceDictionary>
