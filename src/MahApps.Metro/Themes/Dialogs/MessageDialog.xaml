<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:dialogs="clr-namespace:MahApps.Metro.Controls.Dialogs"
                    xmlns:lang="clr-namespace:MahApps.Metro.Lang"
                    xmlns:mahConverters="clr-namespace:MahApps.Metro.Converters">
    <ControlTemplate x:Key="MahApps.Templates.MessageDialog" TargetType="{x:Type dialogs:MessageDialog}">
        <Grid Background="{TemplateBinding Background}">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <ContentPresenter x:Name="PART_Top"
                              Grid.Row="0"
                              AutomationProperties.Name="{x:Static lang:Automation.DialogTop}"
                              Content="{TemplateBinding DialogTop}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />

            <Grid Grid.Row="1" Margin="{TemplateBinding Padding}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{TemplateBinding DialogContentMargin}" />
                    <ColumnDefinition Width="{TemplateBinding DialogContentWidth}" />
                    <ColumnDefinition Width="{TemplateBinding DialogContentMargin}" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <ContentControl x:Name="PART_Icon"
                                Grid.Row="1"
                                Grid.Column="0"
                                HorizontalAlignment="Center"
                                AutomationProperties.Name="{x:Static lang:Automation.DialogIcon}"
                                Content="{TemplateBinding Icon}"
                                ContentTemplate="{TemplateBinding IconTemplate}"
                                Focusable="False"
                                UseLayoutRounding="False" />

                <TextBlock x:Name="PART_Title"
                           Grid.Row="0"
                           Grid.Column="1"
                           AutomationProperties.Name="{x:Static lang:Automation.DialogTitle}"
                           FontSize="{TemplateBinding DialogTitleFontSize}"
                           Foreground="{TemplateBinding Foreground}"
                           Text="{TemplateBinding Title}"
                           TextWrapping="Wrap" />

                <Grid x:Name="PART_Content"
                      Grid.Row="1"
                      Grid.Column="1"
                      Margin="0 10 0 0"
                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                      AutomationProperties.Name="{x:Static lang:Automation.DialogContent}"
                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <ScrollViewer x:Name="PART_MessageScrollViewer"
                                  FocusVisualStyle="{x:Null}"
                                  Focusable="False"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PART_MessageTextBlock"
                                   Margin="0 5 0 0"
                                   FontSize="{TemplateBinding DialogMessageFontSize}"
                                   Foreground="{TemplateBinding MessageForeground}"
                                   Text="{TemplateBinding Message}"
                                   TextWrapping="Wrap" />
                    </ScrollViewer>

                    <StackPanel Grid.Row="1"
                                MinHeight="85"
                                HorizontalAlignment="Right"
                                Orientation="Horizontal">
                        <Button x:Name="PART_AffirmativeButton"
                                Margin="0 0 5 0"
                                Content="{TemplateBinding AffirmativeButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Dialogs}" />
                        <Button x:Name="PART_NegativeButton"
                                Margin="5 0 5 0"
                                Content="{TemplateBinding NegativeButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Dialogs}" />
                        <Button x:Name="PART_FirstAuxiliaryButton"
                                Margin="5 0 5 0"
                                Content="{TemplateBinding FirstAuxiliaryButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Dialogs}"
                                Visibility="Collapsed" />
                        <Button x:Name="PART_SecondAuxiliaryButton"
                                Margin="5 0 0 0"
                                Content="{TemplateBinding SecondAuxiliaryButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Dialogs}"
                                Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Grid>

            <ContentPresenter x:Name="PART_Bottom"
                              Grid.Row="2"
                              AutomationProperties.Name="{x:Static lang:Automation.DialogBottom}"
                              Content="{TemplateBinding DialogBottom}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
        </Grid>
        <ControlTemplate.Triggers>
            <!--  Told no colour of its own, the message is written along with the rest of the dialog  -->
            <Trigger Property="MessageForeground" Value="{x:Null}">
                <Setter TargetName="PART_MessageTextBlock" Property="Foreground" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay}" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="Affirmative">
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="AffirmativeAndNegativeAndSingleAuxiliary">
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="AffirmativeAndNegativeAndDoubleAuxiliary">
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="AffirmativeAndNegative">
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>

            <Trigger Property="DefaultButtonFocus" Value="Affirmative">
                <Setter TargetName="PART_AffirmativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.Accent}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="Negative">
                <Setter TargetName="PART_NegativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.Accent}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="FirstAuxiliary">
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.Accent}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="SecondAuxiliary">
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.Accent}" />
            </Trigger>

            <Trigger Property="ColorScheme" Value="Accented">
                <Setter TargetName="PART_AffirmativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.AccentHighlight}" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.AccentHighlight}" />
                <Setter TargetName="PART_NegativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.AccentHighlight}" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Dialogs.AccentHighlight}" />
            </Trigger>

            <Trigger Property="Title" Value="{x:Null}">
                <Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <EventTrigger RoutedEvent="Loaded">
                <EventTrigger.Actions>
                    <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.Dialogs.Show}" />
                </EventTrigger.Actions>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MahApps.Styles.MessageDialog"
           BasedOn="{StaticResource MahApps.Styles.BaseMetroDialog}"
           TargetType="{x:Type dialogs:MessageDialog}">
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.MessageDialog}" />
    </Style>

    <!--  The Windows 10 look, a card like the content dialog of that look; see BaseMetroDialog.xaml  -->

    <ControlTemplate x:Key="MahApps.Templates.MessageDialog.Win10" TargetType="{x:Type dialogs:MessageDialog}">
        <Grid x:Name="Card"
              MinWidth="320"
              MaxWidth="{DynamicResource MahApps.Sizes.Dialogs.Card.MaxWidth}"
              HorizontalAlignment="Center"
              TextElement.Foreground="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Foreground}"
              UseLayoutRounding="True">
            <!--  the stroke is see-through, so the card lies under it and not the window behind  -->
            <Border x:Name="BackgroundUnderlay" Background="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Background}" />
            <Border x:Name="CardBorder"
                    Background="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Background}"
                    BorderBrush="{DynamicResource MahApps.Brushes.ContentDialog.Win10.Border}"
                    BorderThickness="1">
                <Grid Margin="24 18 24 24">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ContentPresenter x:Name="PART_Top"
                                      Grid.Row="0"
                                      AutomationProperties.Name="{x:Static lang:Automation.DialogTop}"
                                      Content="{TemplateBinding DialogTop}" />
                    <TextBlock x:Name="PART_Title"
                               Grid.Row="1"
                               Margin="0 0 0 12"
                               AutomationProperties.Name="{x:Static lang:Automation.DialogTitle}"
                               FontSize="{TemplateBinding DialogTitleFontSize}"
                               Text="{TemplateBinding Title}"
                               TextWrapping="Wrap" />
                    <Grid x:Name="PART_Content"
                          Grid.Row="2"
                          AutomationProperties.Name="{x:Static lang:Automation.DialogContent}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="PART_Icon"
                                        Grid.Column="0"
                                        Margin="0 0 12 0"
                                        VerticalAlignment="Top"
                                        AutomationProperties.Name="{x:Static lang:Automation.DialogIcon}"
                                        Content="{TemplateBinding Icon}"
                                        ContentTemplate="{TemplateBinding IconTemplate}"
                                        Focusable="False" />
                        <ScrollViewer x:Name="PART_MessageScrollViewer"
                                      Grid.Column="1"
                                      FocusVisualStyle="{x:Null}"
                                      Focusable="False"
                                      HorizontalScrollBarVisibility="Disabled"
                                      Style="{DynamicResource MahApps.Styles.ScrollViewer.Win10}"
                                      VerticalScrollBarVisibility="Auto">
                            <TextBlock x:Name="PART_MessageTextBlock"
                                       FontSize="{TemplateBinding DialogMessageFontSize}"
                                       Foreground="{TemplateBinding MessageForeground}"
                                       Text="{TemplateBinding Message}"
                                       TextWrapping="Wrap" />
                        </ScrollViewer>
                    </Grid>
                    <UniformGrid x:Name="ButtonRow"
                                 Grid.Row="3"
                                 Margin="-4 24 -4 0"
                                 Rows="1">
                        <Button x:Name="PART_AffirmativeButton"
                                Margin="4 0"
                                HorizontalAlignment="Stretch"
                                Content="{TemplateBinding AffirmativeButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Win10}" />
                        <Button x:Name="PART_NegativeButton"
                                Margin="4 0"
                                HorizontalAlignment="Stretch"
                                Content="{TemplateBinding NegativeButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Win10}" />
                        <Button x:Name="PART_FirstAuxiliaryButton"
                                Margin="4 0"
                                HorizontalAlignment="Stretch"
                                Content="{TemplateBinding FirstAuxiliaryButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Win10}"
                                Visibility="Collapsed" />
                        <Button x:Name="PART_SecondAuxiliaryButton"
                                Margin="4 0"
                                HorizontalAlignment="Stretch"
                                Content="{TemplateBinding SecondAuxiliaryButtonText}"
                                FontSize="{TemplateBinding DialogButtonFontSize}"
                                Style="{DynamicResource MahApps.Styles.Button.Win10}"
                                Visibility="Collapsed" />
                    </UniformGrid>
                    <ContentPresenter x:Name="PART_Bottom"
                                      Grid.Row="4"
                                      AutomationProperties.Name="{x:Static lang:Automation.DialogBottom}"
                                      Content="{TemplateBinding DialogBottom}" />
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <!--  without an icon its column takes no room, so the message starts under the title  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Icon" Value="{x:Null}" />
                    <Condition Property="IconTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <!--  Told no colour of its own, the message is written along with the rest of the card  -->
            <Trigger Property="MessageForeground" Value="{x:Null}">
                <Setter TargetName="PART_MessageTextBlock" Property="Foreground" Value="{Binding (TextElement.Foreground), ElementName=Card}" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="Affirmative">
                <!--  a single button stands in the right half, as in the content dialog  -->
                <Setter TargetName="ButtonRow" Property="Columns" Value="2" />
                <Setter TargetName="ButtonRow" Property="FirstColumn" Value="1" />
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="AffirmativeAndNegativeAndSingleAuxiliary">
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="AffirmativeAndNegativeAndDoubleAuxiliary">
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="AffirmativeAndNegative">
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="Affirmative">
                <Setter TargetName="PART_AffirmativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.Win10}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="Negative">
                <Setter TargetName="PART_NegativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.Win10}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="FirstAuxiliary">
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.Win10}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="SecondAuxiliary">
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.Win10}" />
            </Trigger>
            <Trigger Property="Title" Value="{x:Null}">
                <Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <EventTrigger RoutedEvent="Loaded">
                <EventTrigger.Actions>
                    <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.Dialogs.Show}" />
                </EventTrigger.Actions>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  The WinUI look, the content on the lighter layer and the buttons on the base colour  -->

    <ControlTemplate x:Key="MahApps.Templates.MessageDialog.WinUI" TargetType="{x:Type dialogs:MessageDialog}">
        <Grid x:Name="Card"
              MinWidth="320"
              MaxWidth="{DynamicResource MahApps.Sizes.Dialogs.Card.MaxWidth}"
              HorizontalAlignment="Center"
              TextElement.Foreground="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Foreground}"
              UseLayoutRounding="True">
            <!--  the stroke is see-through, so the card lies under it and not the window behind  -->
            <Border x:Name="BackgroundUnderlay"
                    Background="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Background}"
                    CornerRadius="{DynamicResource MahApps.CornerRadius.WinUI.Overlay}" />
            <Border x:Name="CardBorder"
                    Background="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Background}"
                    BorderBrush="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Border}"
                    BorderThickness="1"
                    CornerRadius="{DynamicResource MahApps.CornerRadius.WinUI.Overlay}">
                <Grid x:Name="ClipGrid">
                    <Grid.Clip>
                        <MultiBinding Converter="{x:Static mahConverters:ClipGeometryConverter.Instance}">
                            <Binding ElementName="ClipGrid" Path="ActualWidth" />
                            <Binding ElementName="ClipGrid" Path="ActualHeight" />
                            <Binding ElementName="CardBorder" Path="CornerRadius" />
                            <Binding ElementName="CardBorder" Path="BorderThickness" />
                            <Binding ElementName="CardBorder" Path="Padding" />
                        </MultiBinding>
                    </Grid.Clip>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!--  the content on the lighter layer, a line under it  -->
                    <Border x:Name="ContentLayer"
                            Grid.Row="0"
                            Padding="24"
                            Background="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.TopOverlay}"
                            BorderBrush="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Separator}"
                            BorderThickness="0 0 0 1">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ContentPresenter x:Name="PART_Top"
                                              Grid.Row="0"
                                              AutomationProperties.Name="{x:Static lang:Automation.DialogTop}"
                                              Content="{TemplateBinding DialogTop}" />
                            <TextBlock x:Name="PART_Title"
                                       Grid.Row="1"
                                       Margin="0 0 0 12"
                                       AutomationProperties.Name="{x:Static lang:Automation.DialogTitle}"
                                       FontFamily="{DynamicResource MahApps.Fonts.Family.Display.WinUI}"
                                       FontSize="{TemplateBinding DialogTitleFontSize}"
                                       FontWeight="SemiBold"
                                       Text="{TemplateBinding Title}"
                                       TextWrapping="Wrap" />
                            <Grid x:Name="PART_Content"
                                  Grid.Row="2"
                                  AutomationProperties.Name="{x:Static lang:Automation.DialogContent}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl x:Name="PART_Icon"
                                                Grid.Column="0"
                                                Margin="0 0 12 0"
                                                VerticalAlignment="Top"
                                                AutomationProperties.Name="{x:Static lang:Automation.DialogIcon}"
                                                Content="{TemplateBinding Icon}"
                                                ContentTemplate="{TemplateBinding IconTemplate}"
                                                Focusable="False" />
                                <ScrollViewer x:Name="PART_MessageScrollViewer"
                                              Grid.Column="1"
                                              FocusVisualStyle="{x:Null}"
                                              Focusable="False"
                                              HorizontalScrollBarVisibility="Disabled"
                                              Style="{DynamicResource MahApps.Styles.ScrollViewer.WinUI}"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock x:Name="PART_MessageTextBlock"
                                               FontSize="{TemplateBinding DialogMessageFontSize}"
                                               Foreground="{TemplateBinding MessageForeground}"
                                               Text="{TemplateBinding Message}"
                                               TextWrapping="Wrap" />
                                </ScrollViewer>
                            </Grid>
                            <ContentPresenter x:Name="PART_Bottom"
                                              Grid.Row="3"
                                              AutomationProperties.Name="{x:Static lang:Automation.DialogBottom}"
                                              Content="{TemplateBinding DialogBottom}" />
                        </Grid>
                    </Border>
                    <!--  the buttons on the base colour  -->
                    <Border x:Name="CommandSpace"
                            Grid.Row="1"
                            Padding="20 24"
                            Background="{DynamicResource MahApps.Brushes.ContentDialog.WinUI.Background}">
                        <UniformGrid x:Name="ButtonRow" Rows="1">
                            <Button x:Name="PART_AffirmativeButton"
                                    Margin="4 0"
                                    HorizontalAlignment="Stretch"
                                    Content="{TemplateBinding AffirmativeButtonText}"
                                    FontSize="{TemplateBinding DialogButtonFontSize}"
                                    Style="{DynamicResource MahApps.Styles.Button.WinUI}" />
                            <Button x:Name="PART_NegativeButton"
                                    Margin="4 0"
                                    HorizontalAlignment="Stretch"
                                    Content="{TemplateBinding NegativeButtonText}"
                                    FontSize="{TemplateBinding DialogButtonFontSize}"
                                    Style="{DynamicResource MahApps.Styles.Button.WinUI}" />
                            <Button x:Name="PART_FirstAuxiliaryButton"
                                    Margin="4 0"
                                    HorizontalAlignment="Stretch"
                                    Content="{TemplateBinding FirstAuxiliaryButtonText}"
                                    FontSize="{TemplateBinding DialogButtonFontSize}"
                                    Style="{DynamicResource MahApps.Styles.Button.WinUI}"
                                    Visibility="Collapsed" />
                            <Button x:Name="PART_SecondAuxiliaryButton"
                                    Margin="4 0"
                                    HorizontalAlignment="Stretch"
                                    Content="{TemplateBinding SecondAuxiliaryButtonText}"
                                    FontSize="{TemplateBinding DialogButtonFontSize}"
                                    Style="{DynamicResource MahApps.Styles.Button.WinUI}"
                                    Visibility="Collapsed" />
                        </UniformGrid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <!--  without an icon its column takes no room, so the message starts under the title  -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="Icon" Value="{x:Null}" />
                    <Condition Property="IconTemplate" Value="{x:Null}" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Icon" Property="Visibility" Value="Collapsed" />
            </MultiTrigger>
            <!--  Told no colour of its own, the message is written along with the rest of the card  -->
            <Trigger Property="MessageForeground" Value="{x:Null}">
                <Setter TargetName="PART_MessageTextBlock" Property="Foreground" Value="{Binding (TextElement.Foreground), ElementName=Card}" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="Affirmative">
                <!--  a single button stands in the right half, as in the content dialog  -->
                <Setter TargetName="ButtonRow" Property="Columns" Value="2" />
                <Setter TargetName="ButtonRow" Property="FirstColumn" Value="1" />
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="AffirmativeAndNegativeAndSingleAuxiliary">
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="AffirmativeAndNegativeAndDoubleAuxiliary">
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="ButtonStyle" Value="AffirmativeAndNegative">
                <Setter TargetName="PART_AffirmativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Visibility" Value="Collapsed" />
                <Setter TargetName="PART_NegativeButton" Property="Visibility" Value="Visible" />
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="Affirmative">
                <Setter TargetName="PART_AffirmativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.WinUI}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="Negative">
                <Setter TargetName="PART_NegativeButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.WinUI}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="FirstAuxiliary">
                <Setter TargetName="PART_FirstAuxiliaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.WinUI}" />
            </Trigger>
            <Trigger Property="DefaultButtonFocus" Value="SecondAuxiliary">
                <Setter TargetName="PART_SecondAuxiliaryButton" Property="Style" Value="{DynamicResource MahApps.Styles.Button.Accent.WinUI}" />
            </Trigger>
            <Trigger Property="Title" Value="{x:Null}">
                <Setter TargetName="PART_Title" Property="Visibility" Value="Collapsed" />
            </Trigger>
            <EventTrigger RoutedEvent="Loaded">
                <EventTrigger.Actions>
                    <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.Dialogs.Show}" />
                </EventTrigger.Actions>
            </EventTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MahApps.Styles.MessageDialog.Win10"
           BasedOn="{StaticResource MahApps.Styles.MessageDialog}"
           TargetType="{x:Type dialogs:MessageDialog}">
        <Setter Property="DialogButtonFontSize" Value="{DynamicResource MahApps.Font.Size.Control.Win10}" />
        <Setter Property="DialogMessageFontSize" Value="{DynamicResource MahApps.Font.Size.Body.Win10}" />
