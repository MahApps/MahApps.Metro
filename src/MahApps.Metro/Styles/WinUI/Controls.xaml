<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="clr-namespace:MahApps.Metro.Controls">

    <!--
        The WinUI set, the look Windows 11 draws. It stands on the Windows 10 one rather than on the
        default one, because the two belong to the same family: a control with no WinUI style of its
        own sits better in the older of the two than in the Metro look. Every WinUI style that gets
        written takes one of those places.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Win10/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource MahApps.Styles.Button.WinUI}" TargetType="Button" />
    <Style BasedOn="{StaticResource MahApps.Styles.Button.WinUI}" TargetType="RepeatButton" />
    <Style BasedOn="{StaticResource MahApps.Styles.CheckBox.WinUI}" TargetType="CheckBox" />
    <Style BasedOn="{StaticResource MahApps.Styles.ComboBox.WinUI}" TargetType="ComboBox" />
    <Style BasedOn="{StaticResource MahApps.Styles.ComboBoxItem.WinUI}" TargetType="ComboBoxItem" />
    <Style BasedOn="{StaticResource MahApps.Styles.Menu.WinUI}" TargetType="Menu" />
    <Style BasedOn="{StaticResource MahApps.Styles.MenuItem.WinUI}" TargetType="MenuItem" />
    <Style BasedOn="{StaticResource MahApps.Styles.ContextMenu.WinUI}" TargetType="ContextMenu" />
    <!--  the line between two groups of a menu is looked up by a key rather than by type, so the set hands its own over under that key  -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
           BasedOn="{StaticResource MahApps.Styles.Separator.Menu.WinUI}"
           TargetType="{x:Type Separator}" />
    <Style BasedOn="{StaticResource MahApps.Styles.RadioButton.WinUI}" TargetType="RadioButton" />
    <Style BasedOn="{StaticResource MahApps.Styles.TextBox.WinUI}" TargetType="TextBox" />
    <Style BasedOn="{StaticResource MahApps.Styles.PasswordBox.WinUI}" TargetType="PasswordBox" />
    <Style BasedOn="{StaticResource MahApps.Styles.RichTextBox.WinUI}" TargetType="RichTextBox" />
    <Style BasedOn="{StaticResource MahApps.Styles.ScrollBar.WinUI}" TargetType="ScrollBar" />
    <!--  the line the hamburger menu shows while it waits for the pointer, so that it is the same line this set's bar shows at rest  -->
    <Style x:Key="MahApps.Styles.Thumb.ScrollBar.PanningIndicator"
           BasedOn="{StaticResource MahApps.Styles.Thumb.ScrollBar.WinUI.Vertical}"
           TargetType="{x:Type Thumb}" />
    <Thickness x:Key="MahApps.Thickness.ScrollBar.PanningIndicator">0 12 0 12</Thickness>
    <Style BasedOn="{StaticResource MahApps.Styles.ScrollViewer.WinUI}" TargetType="ScrollViewer" />
    <Style BasedOn="{StaticResource MahApps.Styles.NumericUpDown.WinUI}" TargetType="{x:Type mah:NumericUpDownBase}" />
    <Style BasedOn="{StaticResource MahApps.Styles.NumericUpDown.WinUI}" TargetType="{x:Type mah:NumericUpDown}" />
    <Style BasedOn="{StaticResource MahApps.Styles.NumericUpDown.WinUI}" TargetType="{x:Type mah:DecimalUpDown}" />
    <Style BasedOn="{StaticResource MahApps.Styles.NumericUpDown.WinUI}" TargetType="{x:Type mah:IntegerUpDown}" />
    <Style BasedOn="{StaticResource MahApps.Styles.NumericUpDown.WinUI}" TargetType="{x:Type mah:LongUpDown}" />
    <Style BasedOn="{StaticResource MahApps.Styles.AutoSuggestBox.WinUI}" TargetType="{x:Type mah:AutoSuggestBox}" />
    <Style BasedOn="{StaticResource MahApps.Styles.HotKeyBox.WinUI}" TargetType="{x:Type mah:HotKeyBox}" />
    <Style BasedOn="{StaticResource MahApps.Styles.MultiSelectionComboBox.WinUI}" TargetType="{x:Type mah:MultiSelectionComboBox}" />
    <Style BasedOn="{StaticResource MahApps.Styles.SplitButton.WinUI}" TargetType="{x:Type mah:SplitButton}" />
    <Style BasedOn="{StaticResource MahApps.Styles.DropDownButton.WinUI}" TargetType="{x:Type mah:DropDownButton}" />
    <Style BasedOn="{StaticResource MahApps.Styles.ColorPicker.WinUI}" TargetType="{x:Type mah:ColorPicker}" />
    <Style BasedOn="{StaticResource MahApps.Styles.ColorCanvas.WinUI}" TargetType="{x:Type mah:ColorCanvas}" />
    <Style BasedOn="{StaticResource MahApps.Styles.ColorPalette.WinUI}" TargetType="{x:Type mah:ColorPalette}" />
    <Style BasedOn="{StaticResource MahApps.Styles.ColorEyeDropper.WinUI}" TargetType="{x:Type mah:ColorEyeDropper}" />
    <Style BasedOn="{StaticResource MahApps.Styles.Calendar.WinUI}" TargetType="Calendar" />
    <Style BasedOn="{StaticResource MahApps.Styles.DatePicker.WinUI}" TargetType="DatePicker" />
    <Style BasedOn="{StaticResource MahApps.Styles.AnalogClock.WinUI}" TargetType="{x:Type mah:AnalogClock}" />
    <Style BasedOn="{StaticResource MahApps.Styles.DateTimePicker.WinUI}" TargetType="{x:Type mah:DateTimePicker}" />
    <Style BasedOn="{StaticResource MahApps.Styles.TimePicker.WinUI}" TargetType="{x:Type mah:TimePicker}" />


    <!--  the menu a text box puts on the right button is a named resource rather than an implicit style, so a set that wants its own has to hand one over under the same name  -->
    <ContextMenu x:Key="MahApps.TextBox.ContextMenu"
                 x:Shared="False"
                 Style="{StaticResource MahApps.Styles.ContextMenu.WinUI}">
        <MenuItem Command="ApplicationCommands.Cut" Style="{DynamicResource MahApps.Styles.MenuItem.WinUI}" />
        <MenuItem Command="ApplicationCommands.Copy" Style="{DynamicResource MahApps.Styles.MenuItem.WinUI}" />
        <MenuItem Command="ApplicationCommands.Paste" Style="{DynamicResource MahApps.Styles.MenuItem.WinUI}" />
    </ContextMenu>

</ResourceDictionary>
