                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BackgroundPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.ForegroundPressed}" />
                <Setter Property="mah:ControlsHelper.BottomBorderBrush" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BottomBorderBrushPressed}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
