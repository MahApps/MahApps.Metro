                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BorderBrush}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.ForegroundDisabled}" />
                <Setter Property="mah:ControlsHelper.BottomBorderBrush" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BottomBorderBrushPressed}" />
            </Trigger>
            <!--  the checked states come after the others, so that a toggle which is down keeps the accent whatever the pointer is doing  -->
            <Trigger Property="IsChecked" Value="True">
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BackgroundChecked}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BorderBrushChecked}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.ForegroundChecked}" />
                <Setter Property="mah:ControlsHelper.BottomBorderBrush" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BottomBorderBrushChecked}" />
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsMouseOver" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BackgroundCheckedPointerOver}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.ForegroundCheckedPointerOver}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsPressed" Value="True" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BackgroundCheckedPressed}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BorderBrushCheckedPressed}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.ForegroundCheckedPressed}" />
                <Setter Property="mah:ControlsHelper.BottomBorderBrush" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BorderBrushCheckedPressed}" />
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsChecked" Value="True" />
                    <Condition Property="IsEnabled" Value="False" />
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BackgroundCheckedDisabled}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BorderBrushCheckedDisabled}" />
                <Setter Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.ForegroundCheckedDisabled}" />
                <Setter Property="mah:ControlsHelper.BottomBorderBrush" Value="{DynamicResource MahApps.Brushes.ToggleButton.WinUI.BorderBrushCheckedDisabled}" />
            </MultiTrigger>
        </Style.Triggers>
    </Style>

