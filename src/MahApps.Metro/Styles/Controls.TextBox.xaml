<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:lang="clr-namespace:MahApps.Metro.Lang"
                    xmlns:mah="clr-namespace:MahApps.Metro.Controls"
                    xmlns:mahConverters="clr-namespace:MahApps.Metro.Converters">

    <Thickness x:Key="TextControlBorderThemeThickness">1,1,1,1</Thickness>
    <Thickness x:Key="TextControlThemePadding">4,4,4,4</Thickness>
    <Thickness x:Key="TextControlBorderThemeThicknessFocused">1,1,1,1</Thickness>
    <Thickness x:Key="TextControlPlaceholderMargin">4,0,4,0</Thickness>

    <mahConverters:CornerRadiusFilterConverter x:Key="CornerRadiusLeftConverter" Filter="Left" />
    <mahConverters:CornerRadiusFilterConverter x:Key="CornerRadiusRightConverter" Filter="Right" />

    <!--  TextBox Style  -->
    <Style x:Key="MahApps.Styles.TextBox" TargetType="{x:Type TextBox}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Control.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border}" />
        <Setter Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThickness}" />
        <!--
            Without this WPF paints the caret itself, by inverting the RGB channels of whatever the
            Background is, and where that is not a solid brush it inverts SystemColors.WindowColor
            instead, which is white whatever Windows is set to. That is how the caret ends up black
            on a dark theme in every control whose template hands its inner text box a null
            background: the editable ComboBox, the MultiSelectionComboBox, the AutoSuggestBox and
            the four up-downs all take this style or one based on it.
        -->
        <Setter Property="CaretBrush" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="ContextMenu" Value="{DynamicResource MahApps.TextBox.ContextMenu}" />
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Content}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Text}" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Padding" Value="{DynamicResource TextControlThemePadding}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource MahApps.Brushes.Highlight}" />
        <!--  change SnapsToDevicePixels to True to view a better border and validation error  -->
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <!--
                        Layout rounding here and not on the box itself: it rounds the frame, the inner
                        grid and the buttons onto whole device pixels, which is what keeps a filled
                        glyph button from ending in part of a pixel against the frame it stands in, and
                        it leaves the size the box reports to its own parent alone. The property does
                        not inherit, so a container carrying it would do nothing for this.
                    -->
                    <Grid UseLayoutRounding="True">
                        <Border x:Name="BorderElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Grid x:Name="PART_InnerGrid">
                                <Grid.Clip>
                                    <!--  a clip lives in the coordinates of the element it sits on, so it takes the size of this grid and the corners the border leaves over  -->
                                    <MultiBinding Converter="{x:Static mahConverters:ClipGeometryConverter.Instance}">
                                        <Binding ElementName="PART_InnerGrid" Path="ActualWidth" />
                                        <Binding ElementName="PART_InnerGrid" Path="ActualHeight" />
                                        <Binding ElementName="BorderElement" Path="CornerRadius" />
                                        <Binding ElementName="BorderElement" Path="BorderThickness" />
                                        <Binding ElementName="BorderElement" Path="Padding" />
                                    </MultiBinding>
                                </Grid.Clip>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="TextColumn" Width="*" />
                                    <ColumnDefinition x:Name="ButtonColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="ButtonRow" Height="*" />
                                </Grid.RowDefinitions>

                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Row="1"
                                              Grid.Column="0"
                                              Margin="0"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="Stretch"
                                              Background="{x:Null}"
                                              BorderThickness="0"
                                              IsTabStop="False"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              Style="{DynamicResource MahApps.Styles.ScrollViewer.TextControlContentHost}" />

                                <TextBlock x:Name="PART_Message"
                                           Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="{DynamicResource TextControlPlaceholderMargin}"
                                           Padding="{TemplateBinding Padding}"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Foreground="{TemplateBinding Foreground}"
                                           Style="{DynamicResource MahApps.Styles.TextBlock.Watermark}"
                                           Text="{TemplateBinding mah:TextBoxHelper.Watermark}"
                                           TextAlignment="{TemplateBinding mah:TextBoxHelper.WatermarkAlignment}"
                                           TextTrimming="{TemplateBinding mah:TextBoxHelper.WatermarkTrimming}"
                                           TextWrapping="{TemplateBinding mah:TextBoxHelper.WatermarkWrapping}"
                                           Visibility="Collapsed" />

                                <ContentControl x:Name="PART_FloatingMessageContainer"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="{DynamicResource TextControlPlaceholderMargin}"
                                                Style="{DynamicResource MahApps.Styles.ContentControl.FloatingMessageContainer}">
                                    <ContentControl.Height>
                                        <MultiBinding Converter="{mahConverters:MathMultiplyConverter}" FallbackValue="0">
                                            <Binding ElementName="PART_FloatingMessage"
                                                     Mode="OneWay"
                                                     Path="ActualHeight" />
                                            <Binding ElementName="PART_FloatingMessageContainer"
                                                     Mode="OneWay"
                                                     Path="Opacity" />
                                        </MultiBinding>
                                    </ContentControl.Height>
                                    <TextBlock x:Name="PART_FloatingMessage"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Style="{DynamicResource MahApps.Styles.TextBlock.AutoCollapsing}"
                                               Text="{TemplateBinding mah:TextBoxHelper.Watermark}"
                                               TextAlignment="{TemplateBinding mah:TextBoxHelper.WatermarkAlignment}"
                                               TextTrimming="{TemplateBinding mah:TextBoxHelper.WatermarkTrimming}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="FloatingMessageTransform">
                                                <TranslateTransform.Y>
                                                    <MultiBinding Converter="{mahConverters:MathSubtractConverter}" FallbackValue="0">
                                                        <Binding ElementName="PART_FloatingMessage"
                                                                 Mode="OneWay"
                                                                 Path="ActualHeight" />
                                                        <Binding ElementName="PART_FloatingMessageContainer"
                                                                 Mode="OneWay"
                                                                 Path="ActualHeight" />
                                                    </MultiBinding>
                                                </TranslateTransform.Y>
                                            </TranslateTransform>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </ContentControl>

                                <Button x:Name="PART_ClearText"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Width="{TemplateBinding mah:TextBoxHelper.ButtonWidth}"
                                        mah:ControlsHelper.CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Path=(mah:ControlsHelper.CornerRadius), Converter={StaticResource CornerRadiusRightConverter}}"
                                        AutomationProperties.Name="{x:Static lang:Automation.Clear}"
                                        Command="{TemplateBinding mah:TextBoxHelper.ButtonCommand}"
                                        CommandParameter="{TemplateBinding mah:TextBoxHelper.ButtonCommandParameter}"
                                        CommandTarget="{TemplateBinding mah:TextBoxHelper.ButtonCommandTarget}"
                                        Content="{TemplateBinding mah:TextBoxHelper.ButtonContent}"
                                        ContentTemplate="{TemplateBinding mah:TextBoxHelper.ButtonContentTemplate}"
                                        Focusable="False"
                                        FontFamily="{TemplateBinding mah:TextBoxHelper.ButtonFontFamily}"
                                        FontSize="{TemplateBinding mah:TextBoxHelper.ButtonFontSize}"
                                        IsTabStop="False"
                                        Style="{DynamicResource MahApps.Styles.Button.Chromeless}"
                                        Template="{TemplateBinding mah:TextBoxHelper.ButtonTemplate}"
                                        Visibility="Visible" />
                            </Grid>
                        </Border>

                        <Border x:Name="DisabledVisualElement"
                                Background="{TemplateBinding mah:ControlsHelper.DisabledBorderBrush}"
                                BorderBrush="{TemplateBinding mah:ControlsHelper.DisabledBorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                                IsHitTestVisible="False"
                                Opacity="0"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                Visibility="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.DisabledVisualElementVisibility), Mode=OneWay}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="mah:TextBoxHelper.ClearTextButton" Value="True">
                            <Setter TargetName="PART_ClearText" Property="Command" Value="{x:Static mah:MahAppsCommands.ClearControlCommand}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="mah:TextBoxHelper.ClearTextButton" Value="False" />
                                <Condition Property="mah:TextBoxHelper.ButtonCommand" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearText" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(mah:TextBoxHelper.ButtonsAlignment)}" Value="Left">
                            <Setter TargetName="ButtonColumn" Property="Width" Value="*" />
                            <Setter TargetName="PART_ClearText" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_ClearText" Property="mah:ControlsHelper.CornerRadius" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Path=(mah:ControlsHelper.CornerRadius), Converter={StaticResource CornerRadiusLeftConverter}}" />
                            <Setter TargetName="PART_ContentHost" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_FloatingMessageContainer" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_Message" Property="Grid.Column" Value="1" />
                            <Setter TargetName="TextColumn" Property="Width" Value="Auto" />
                        </DataTrigger>

                        <Trigger Property="mah:TextBoxHelper.HasText" Value="False">
                            <Setter TargetName="PART_Message" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(mah:TextBoxHelper.UseFloatingWatermark), RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(mah:TextBoxHelper.HasText), RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(mah:TextBoxHelper.Watermark), RelativeSource={RelativeSource Self}, Converter={x:Static mahConverters:StringIsNullOrEmptyConverter.Default}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.ShowFloatingMessage}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.HideFloatingMessage}" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.MouseOverBorderBrush)}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="DisabledVisualElement" Property="Opacity" Value="0.6" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.FocusBorderBrush)}" />
                            <Setter TargetName="BorderElement" Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThicknessFocused}" />
                            <Setter TargetName="PART_FloatingMessage" Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextBlock.FloatingMessage}" />
                            <Setter TargetName="PART_FloatingMessage" Property="Opacity" Value="1" />
                        </Trigger>

                        <Trigger SourceName="PART_ClearText" Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_ClearText" Property="Background" Value="{DynamicResource MahApps.Brushes.Gray8}" />
                            <Setter TargetName="PART_ClearText" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                        </Trigger>
                        <Trigger SourceName="PART_ClearText" Property="IsPressed" Value="True">
                            <Setter TargetName="PART_ClearText" Property="Background" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
                            <Setter TargetName="PART_ClearText" Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeBackground}" />
                        </Trigger>

                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="mah:TextBoxHelper.HasText" Value="False" />
                                <Condition Property="IsFocused" Value="True" />
                            </MultiTrigger.Conditions>
                            <MultiTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.EnterGotFocus}" />
                            </MultiTrigger.EnterActions>
                            <MultiTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.ExitGotFocus}" />
                            </MultiTrigger.ExitActions>
                        </MultiTrigger>

                        <Trigger Property="mah:TextBoxHelper.HasText" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.EnterHasText}" />
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.ExitHasText}" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Validation.ErrorTemplate" Value="{DynamicResource MahApps.Templates.ValidationError}" />

        <Setter Property="mah:ControlsHelper.DisabledBorderBrush" Value="{DynamicResource MahApps.Brushes.Control.Disabled}" />
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border.Focus}" />
        <Setter Property="mah:ControlsHelper.MouseOverBorderBrush" Value="{DynamicResource MahApps.Brushes.TextBox.Border.MouseOver}" />

        <Setter Property="mah:TextBoxHelper.ButtonCommandParameter" Value="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}" />
        <Setter Property="mah:TextBoxHelper.ButtonCommandTarget" Value="{Binding RelativeSource={RelativeSource Self}, Mode=OneWay}" />
        <Setter Property="mah:TextBoxHelper.ButtonFontSize" Value="{DynamicResource MahApps.Font.Size.Button.ClearText}" />
        <Setter Property="mah:TextBoxHelper.ButtonTemplate" Value="{DynamicResource MahApps.Templates.Button.Chromeless}" />
        <Setter Property="mah:TextBoxHelper.ButtonWidth" Value="22" />
        <Setter Property="mah:TextBoxHelper.IsMonitoring" Value="True" />
        <Setter Property="mah:TextBoxHelper.IsSpellCheckContextMenuEnabled" Value="{Binding RelativeSource={RelativeSource Self}, Path=(SpellCheck.IsEnabled)}" />
        <Setter Property="mah:TextBoxHelper.WatermarkWrapping" Value="{Binding RelativeSource={RelativeSource Self}, Path=TextWrapping, Mode=OneWay}" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBox.Search"
           BasedOn="{StaticResource MahApps.Styles.TextBox}"
           TargetType="{x:Type TextBox}">
        <!--  Modern - Magnify  -->
        <Setter Property="mah:TextBoxHelper.ButtonCommand" Value="{x:Static mah:MahAppsCommands.SearchCommand}" />
        <Setter Property="mah:TextBoxHelper.ButtonContent" Value="M 42.5,22C 49.4036,22 55,27.5964 55,34.5C 55,41.4036 49.4036,47 42.5,47C 40.1356,47 37.9245,46.3435 36,45.2426L 26.9749,54.2678C 25.8033,55.4393 23.9038,55.4393 22.7322,54.2678C 21.5607,53.0962 21.5607,51.1967 22.7322,50.0251L 31.7971,40.961C 30.6565,39.0755 30,36.8644 30,34.5C 30,27.5964 35.5964,22 42.5,22 Z M 42.5,26C 37.8056,26 34,29.8056 34,34.5C 34,39.1944 37.8056,43 42.5,43C 47.1944,43 51,39.1944 51,34.5C 51,29.8056 47.1944,26 42.5,26 Z" />
        <Setter Property="mah:TextBoxHelper.ButtonContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <mah:PathIcon Width="{Binding RelativeSource={RelativeSource AncestorType=TextBox}, Path=(mah:TextBoxHelper.ButtonWidth), Mode=OneWay}"
                                  Height="{Binding RelativeSource={RelativeSource AncestorType=TextBox}, Path=(mah:TextBoxHelper.ButtonWidth), Mode=OneWay}"
                                  Padding="3"
                                  Data="{Binding Mode=OneWay}" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MahApps.Styles.TextBox.Win10"
           BasedOn="{StaticResource MahApps.Styles.TextBox}"
           TargetType="{x:Type TextBox}">
        <Style.Resources>
            <Thickness x:Key="TextControlBorderThemeThickness">2,2,2,2</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">2,2,2,2</Thickness>
            <Thickness x:Key="TextControlThemePadding">10,6,6,5</Thickness>
            <Thickness x:Key="TextControlPlaceholderMargin">0,0,0,0</Thickness>
        </Style.Resources>

        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.TextControl.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextControl.BorderBrush}" />
        <!--  The caret only ever shows on the focused box, and that one is white under both base themes, so it takes the focused text colour rather than the theme foreground.  -->
        <Setter Property="CaretBrush" Value="{DynamicResource MahApps.Brushes.TextControl.ForegroundFocused}" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Default}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.Foreground}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="ScrollViewer.IsDeferredScrollingEnabled" Value="False" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Hidden" />
        <Setter Property="SelectionBrush" Value="{DynamicResource MahApps.Brushes.TextControl.SelectionHighlightColor}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <!--
                        Layout rounding here and not on the box itself: it rounds the frame, the inner
                        grid and the buttons onto whole device pixels, which is what keeps a filled
                        glyph button from ending in part of a pixel against the frame it stands in, and
                        it leaves the size the box reports to its own parent alone. The property does
                        not inherit, so a container carrying it would do nothing for this.
                    -->
                    <Grid UseLayoutRounding="True">
                        <Border x:Name="BorderElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Grid x:Name="PART_InnerGrid">
                                <Grid.Clip>
                                    <!--  a clip lives in the coordinates of the element it sits on, so it takes the size of this grid and the corners the border leaves over  -->
                                    <MultiBinding Converter="{x:Static mahConverters:ClipGeometryConverter.Instance}">
                                        <Binding ElementName="PART_InnerGrid" Path="ActualWidth" />
                                        <Binding ElementName="PART_InnerGrid" Path="ActualHeight" />
                                        <Binding ElementName="BorderElement" Path="CornerRadius" />
                                        <Binding ElementName="BorderElement" Path="BorderThickness" />
                                        <Binding ElementName="BorderElement" Path="Padding" />
                                    </MultiBinding>
                                </Grid.Clip>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="TextColumn" Width="*" />
                                    <ColumnDefinition x:Name="ButtonColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="ButtonRow" Height="*" />
                                </Grid.RowDefinitions>

                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Row="1"
                                              Grid.Column="0"
                                              Margin="0"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="Stretch"
                                              Background="{x:Null}"
                                              BorderThickness="0"
                                              IsTabStop="False"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              Style="{DynamicResource MahApps.Styles.ScrollViewer.TextControlContentHost}" />

                                <TextBlock x:Name="PART_Message"
                                           Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="{DynamicResource TextControlPlaceholderMargin}"
                                           Padding="{TemplateBinding Padding}"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Foreground="{DynamicResource MahApps.Brushes.TextControl.PlaceholderForeground}"
                                           Opacity="1"
                                           Style="{DynamicResource MahApps.Styles.TextBlock.Watermark}"
                                           Text="{TemplateBinding mah:TextBoxHelper.Watermark}"
                                           TextAlignment="{TemplateBinding mah:TextBoxHelper.WatermarkAlignment}"
                                           TextTrimming="{TemplateBinding mah:TextBoxHelper.WatermarkTrimming}"
                                           TextWrapping="{TemplateBinding mah:TextBoxHelper.WatermarkWrapping}"
                                           Visibility="Collapsed" />

                                <ContentControl x:Name="PART_FloatingMessageContainer"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="{DynamicResource TextControlPlaceholderMargin}"
                                                Style="{DynamicResource MahApps.Styles.ContentControl.FloatingMessageContainer}">
                                    <ContentControl.Height>
                                        <MultiBinding Converter="{mahConverters:MathMultiplyConverter}" FallbackValue="0">
                                            <Binding ElementName="PART_FloatingMessage"
                                                     Mode="OneWay"
                                                     Path="ActualHeight" />
                                            <Binding ElementName="PART_FloatingMessageContainer"
                                                     Mode="OneWay"
                                                     Path="Opacity" />
                                        </MultiBinding>
                                    </ContentControl.Height>
                                    <TextBlock x:Name="PART_FloatingMessage"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Style="{DynamicResource MahApps.Styles.TextBlock.AutoCollapsing}"
                                               Text="{TemplateBinding mah:TextBoxHelper.Watermark}"
                                               TextAlignment="{TemplateBinding mah:TextBoxHelper.WatermarkAlignment}"
                                               TextTrimming="{TemplateBinding mah:TextBoxHelper.WatermarkTrimming}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="FloatingMessageTransform">
                                                <TranslateTransform.Y>
                                                    <MultiBinding Converter="{mahConverters:MathSubtractConverter}" FallbackValue="0">
                                                        <Binding ElementName="PART_FloatingMessage"
                                                                 Mode="OneWay"
                                                                 Path="ActualHeight" />
                                                        <Binding ElementName="PART_FloatingMessageContainer"
                                                                 Mode="OneWay"
                                                                 Path="ActualHeight" />
                                                    </MultiBinding>
                                                </TranslateTransform.Y>
                                            </TranslateTransform>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </ContentControl>

                                <Button x:Name="PART_ClearText"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Width="{TemplateBinding mah:TextBoxHelper.ButtonWidth}"
                                        mah:ControlsHelper.CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Path=(mah:ControlsHelper.CornerRadius), Converter={StaticResource CornerRadiusRightConverter}}"
                                        BorderThickness="0"
                                        Command="{TemplateBinding mah:TextBoxHelper.ButtonCommand}"
                                        CommandParameter="{TemplateBinding mah:TextBoxHelper.ButtonCommandParameter}"
                                        CommandTarget="{TemplateBinding mah:TextBoxHelper.ButtonCommandTarget}"
                                        Content="{TemplateBinding mah:TextBoxHelper.ButtonContent}"
                                        ContentTemplate="{TemplateBinding mah:TextBoxHelper.ButtonContentTemplate}"
                                        Focusable="False"
                                        FontFamily="{TemplateBinding mah:TextBoxHelper.ButtonFontFamily}"
                                        FontSize="{TemplateBinding mah:TextBoxHelper.ButtonFontSize}"
                                        IsTabStop="False"
                                        Style="{DynamicResource MahApps.Styles.Button.TextControl.Delete}"
                                        Template="{TemplateBinding mah:TextBoxHelper.ButtonTemplate}"
                                        Visibility="Visible" />
                            </Grid>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="mah:TextBoxHelper.ClearTextButton" Value="True">
                            <Setter TargetName="PART_ClearText" Property="Command" Value="{x:Static mah:MahAppsCommands.ClearControlCommand}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="mah:TextBoxHelper.ClearTextButton" Value="False" />
                                <Condition Property="mah:TextBoxHelper.ButtonCommand" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearText" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="mah:TextBoxHelper.ClearTextButton" Value="True" />
                                <Condition Property="mah:TextBoxHelper.HasText" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearText" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <!--
                            The delete button of a UWP box is there for as long as the caret is in
                            the box. A button that carries a command of the application's own is
                            not that button and has to stay where it is.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="mah:TextBoxHelper.ClearTextButton" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearText" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(mah:TextBoxHelper.ButtonsAlignment)}" Value="Left">
                            <Setter TargetName="ButtonColumn" Property="Width" Value="*" />
                            <Setter TargetName="PART_ClearText" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_ClearText" Property="mah:ControlsHelper.CornerRadius" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Path=(mah:ControlsHelper.CornerRadius), Converter={StaticResource CornerRadiusLeftConverter}}" />
                            <Setter TargetName="PART_ContentHost" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_FloatingMessageContainer" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_Message" Property="Grid.Column" Value="1" />
                            <Setter TargetName="TextColumn" Property="Width" Value="Auto" />
                        </DataTrigger>

                        <Trigger Property="mah:TextBoxHelper.HasText" Value="False">
                            <Setter TargetName="PART_Message" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(mah:TextBoxHelper.UseFloatingWatermark), RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(mah:TextBoxHelper.HasText), RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(mah:TextBoxHelper.Watermark), RelativeSource={RelativeSource Self}, Converter={x:Static mahConverters:StringIsNullOrEmptyConverter.Default}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.ShowFloatingMessage}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.HideFloatingMessage}" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.TextControl.BackgroundPointerOver}" />
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.ForegroundPointerOver}" />
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.MouseOverBorderBrush)}" />
                            <Setter TargetName="PART_Message" Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.PlaceholderForegroundPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.TextControl.BackgroundFocused}" />
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.ForegroundFocused}" />
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.FocusBorderBrush)}" />
                            <Setter TargetName="BorderElement" Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThicknessFocused}" />

                            <Setter TargetName="PART_ClearText" Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.ButtonForeground}" />
                            <Setter TargetName="PART_FloatingMessage" Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextBlock.FloatingMessage}" />
                            <Setter TargetName="PART_FloatingMessage" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_Message" Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.PlaceholderForegroundFocused}" />
                        </Trigger>
                        <!--
                            A box that is switched off looks switched off, even when the caret was in
                            it when it happened: of two triggers that set the same thing, the later one
                            wins, and IsFocused stays true on a control that has just been disabled.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.TextControl.BackgroundDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.ForegroundDisabled}" />
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.DisabledBorderBrush)}" />
                            <Setter TargetName="PART_Message" Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.PlaceholderForegroundDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>

        <Setter Property="mah:ControlsHelper.DisabledBorderBrush" Value="{DynamicResource MahApps.Brushes.TextControl.BorderBrushDisabled}" />
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{DynamicResource MahApps.Brushes.TextControl.BorderBrushFocused}" />
        <Setter Property="mah:ControlsHelper.MouseOverBorderBrush" Value="{DynamicResource MahApps.Brushes.TextControl.BorderBrushPointerOver}" />

        <Setter Property="mah:TextBoxHelper.ButtonContent" Value="&#xE10A;" />
        <Setter Property="mah:TextBoxHelper.ButtonContentTemplate">
            <Setter.Value>
                <DataTemplate>
                    <mah:FontIcon FontFamily="{DynamicResource MahApps.Fonts.Family.SymbolTheme}"
                                  FontSize="12"
                                  Glyph="{Binding}"
                                  UseLayoutRounding="False" />
                </DataTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="mah:TextBoxHelper.ButtonTemplate" Value="{DynamicResource MahApps.Templates.Button.TextControl.Win10}" />
        <Setter Property="mah:TextBoxHelper.ButtonWidth" Value="30" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBox.WinUI"
           BasedOn="{StaticResource MahApps.Styles.TextBox.Win10}"
           TargetType="{x:Type TextBox}">
        <Style.Resources>
            <!--
                The line along the bottom edge is two pixels thick whether the box has the caret or
                not, and only its colour changes, because a border that grows takes the height of the
                control with it and moves whatever stands under it. It also leaves the text where the
                padding of a WinUI box puts it: six above and five below, plus one and two of border,
                is seven either way.
            -->
            <Thickness x:Key="TextControlBorderThemeThickness">1,1,1,2</Thickness>
            <Thickness x:Key="TextControlBorderThemeThicknessFocused">1,1,1,2</Thickness>
            <!--
                How thick that edge is, rather than a number written into the template: a box
                standing inside another control has no edge of its own to draw, because the one
                below it belongs to the control around it and runs the whole width.
            -->
            <Thickness x:Key="TextControlBottomEdgeThemeThickness">0,0,0,2</Thickness>
            <Thickness x:Key="TextControlThemePadding">10,6,6,5</Thickness>
            <Thickness x:Key="TextControlPlaceholderMargin">0,0,0,0</Thickness>

        </Style.Resources>

        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.BorderBrush}" />
        <Setter Property="CaretBrush" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.ForegroundFocused}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.Foreground}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TextBox}">
                    <!--
                        Layout rounding here and not on the box itself: it rounds the frame, the inner
                        grid and the buttons onto whole device pixels, which is what keeps a filled
                        glyph button from ending in part of a pixel against the frame it stands in, and
                        it leaves the size the box reports to its own parent alone. The property does
                        not inherit, so a container carrying it would do nothing for this.
                    -->
                    <Grid UseLayoutRounding="True">
                        <Border x:Name="BorderElement"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Grid x:Name="PART_InnerGrid">
                                <Grid.Clip>
                                    <!--  a clip lives in the coordinates of the element it sits on, so it takes the size of this grid and the corners the border leaves over  -->
                                    <MultiBinding Converter="{x:Static mahConverters:ClipGeometryConverter.Instance}">
                                        <Binding ElementName="PART_InnerGrid" Path="ActualWidth" />
                                        <Binding ElementName="PART_InnerGrid" Path="ActualHeight" />
                                        <Binding ElementName="BorderElement" Path="CornerRadius" />
                                        <Binding ElementName="BorderElement" Path="BorderThickness" />
                                        <Binding ElementName="BorderElement" Path="Padding" />
                                    </MultiBinding>
                                </Grid.Clip>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="TextColumn" Width="*" />
                                    <ColumnDefinition x:Name="ButtonColumn" Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition x:Name="ButtonRow" Height="*" />
                                </Grid.RowDefinitions>

                                <ScrollViewer x:Name="PART_ContentHost"
                                              Grid.Row="1"
                                              Grid.Column="0"
                                              Margin="0"
                                              Padding="{TemplateBinding Padding}"
                                              VerticalAlignment="Stretch"
                                              Background="{x:Null}"
                                              BorderThickness="0"
                                              IsTabStop="False"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                              Style="{DynamicResource MahApps.Styles.ScrollViewer.TextControlContentHost}" />

                                <TextBlock x:Name="PART_Message"
                                           Grid.Row="1"
                                           Grid.Column="0"
                                           Margin="{DynamicResource TextControlPlaceholderMargin}"
                                           Padding="{TemplateBinding Padding}"
                                           HorizontalAlignment="Stretch"
                                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                           Foreground="{DynamicResource MahApps.Brushes.TextControl.WinUI.PlaceholderForeground}"
                                           Opacity="1"
                                           Style="{DynamicResource MahApps.Styles.TextBlock.Watermark}"
                                           Text="{TemplateBinding mah:TextBoxHelper.Watermark}"
                                           TextAlignment="{TemplateBinding mah:TextBoxHelper.WatermarkAlignment}"
                                           TextTrimming="{TemplateBinding mah:TextBoxHelper.WatermarkTrimming}"
                                           TextWrapping="{TemplateBinding mah:TextBoxHelper.WatermarkWrapping}"
                                           Visibility="Collapsed" />

                                <ContentControl x:Name="PART_FloatingMessageContainer"
                                                Grid.Row="0"
                                                Grid.Column="0"
                                                Margin="{DynamicResource TextControlPlaceholderMargin}"
                                                Style="{DynamicResource MahApps.Styles.ContentControl.FloatingMessageContainer}">
                                    <ContentControl.Height>
                                        <MultiBinding Converter="{mahConverters:MathMultiplyConverter}" FallbackValue="0">
                                            <Binding ElementName="PART_FloatingMessage"
                                                     Mode="OneWay"
                                                     Path="ActualHeight" />
                                            <Binding ElementName="PART_FloatingMessageContainer"
                                                     Mode="OneWay"
                                                     Path="Opacity" />
                                        </MultiBinding>
                                    </ContentControl.Height>
                                    <TextBlock x:Name="PART_FloatingMessage"
                                               HorizontalAlignment="Stretch"
                                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                               Foreground="{TemplateBinding Foreground}"
                                               Style="{DynamicResource MahApps.Styles.TextBlock.AutoCollapsing}"
                                               Text="{TemplateBinding mah:TextBoxHelper.Watermark}"
                                               TextAlignment="{TemplateBinding mah:TextBoxHelper.WatermarkAlignment}"
                                               TextTrimming="{TemplateBinding mah:TextBoxHelper.WatermarkTrimming}">
                                        <TextBlock.RenderTransform>
                                            <TranslateTransform x:Name="FloatingMessageTransform">
                                                <TranslateTransform.Y>
                                                    <MultiBinding Converter="{mahConverters:MathSubtractConverter}" FallbackValue="0">
                                                        <Binding ElementName="PART_FloatingMessage"
                                                                 Mode="OneWay"
                                                                 Path="ActualHeight" />
                                                        <Binding ElementName="PART_FloatingMessageContainer"
                                                                 Mode="OneWay"
                                                                 Path="ActualHeight" />
                                                    </MultiBinding>
                                                </TranslateTransform.Y>
                                            </TranslateTransform>
                                        </TextBlock.RenderTransform>
                                    </TextBlock>
                                </ContentControl>

                                <Button x:Name="PART_ClearText"
                                        Grid.Row="0"
                                        Grid.RowSpan="2"
                                        Grid.Column="1"
                                        Width="{TemplateBinding mah:TextBoxHelper.ButtonWidth}"
                                        mah:ControlsHelper.CornerRadius="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Path=(mah:ControlsHelper.CornerRadius), Converter={StaticResource CornerRadiusRightConverter}}"
                                        BorderThickness="0"
                                        Command="{TemplateBinding mah:TextBoxHelper.ButtonCommand}"
                                        CommandParameter="{TemplateBinding mah:TextBoxHelper.ButtonCommandParameter}"
                                        CommandTarget="{TemplateBinding mah:TextBoxHelper.ButtonCommandTarget}"
                                        Content="{TemplateBinding mah:TextBoxHelper.ButtonContent}"
                                        ContentTemplate="{TemplateBinding mah:TextBoxHelper.ButtonContentTemplate}"
                                        Focusable="False"
                                        FontFamily="{TemplateBinding mah:TextBoxHelper.ButtonFontFamily}"
                                        FontSize="{TemplateBinding mah:TextBoxHelper.ButtonFontSize}"
                                        IsTabStop="False"
                                        Style="{DynamicResource MahApps.Styles.Button.TextControl.Delete}"
                                        Template="{TemplateBinding mah:TextBoxHelper.ButtonTemplate}"
                                        Visibility="Visible" />
                            </Grid>
                        </Border>

                        <!--
                            The edge WinUI draws a little stronger, and the accent while the box has
                            the caret. It is a frame of its own carrying nothing but that edge, so
                            that it follows the corners of the one behind it and is the same two
                            units on a box of any height.
                        -->
                        <Border x:Name="BottomEdge"
                                BorderBrush="{TemplateBinding mah:ControlsHelper.BottomBorderBrush}"
                                BorderThickness="{DynamicResource TextControlBottomEdgeThemeThickness}"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                                IsHitTestVisible="False"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="mah:TextBoxHelper.ClearTextButton" Value="True">
                            <Setter TargetName="PART_ClearText" Property="Command" Value="{x:Static mah:MahAppsCommands.ClearControlCommand}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="mah:TextBoxHelper.ClearTextButton" Value="False" />
                                <Condition Property="mah:TextBoxHelper.ButtonCommand" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearText" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="mah:TextBoxHelper.ClearTextButton" Value="True" />
                                <Condition Property="mah:TextBoxHelper.HasText" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearText" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>
                        <!--
                            The delete button of a UWP box is there for as long as the caret is in
                            the box. A button that carries a command of the application's own is
                            not that button and has to stay where it is.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="mah:TextBoxHelper.ClearTextButton" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="PART_ClearText" Property="Visibility" Value="Collapsed" />
                        </MultiTrigger>

                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource Self}, Path=(mah:TextBoxHelper.ButtonsAlignment)}" Value="Left">
                            <Setter TargetName="ButtonColumn" Property="Width" Value="*" />
                            <Setter TargetName="PART_ClearText" Property="Grid.Column" Value="0" />
                            <Setter TargetName="PART_ClearText" Property="mah:ControlsHelper.CornerRadius" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Mode=OneWay, Path=(mah:ControlsHelper.CornerRadius), Converter={StaticResource CornerRadiusLeftConverter}}" />
                            <Setter TargetName="PART_ContentHost" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_FloatingMessageContainer" Property="Grid.Column" Value="1" />
                            <Setter TargetName="PART_Message" Property="Grid.Column" Value="1" />
                            <Setter TargetName="TextColumn" Property="Width" Value="Auto" />
                        </DataTrigger>

                        <Trigger Property="mah:TextBoxHelper.HasText" Value="False">
                            <Setter TargetName="PART_Message" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding Path=IsVisible, RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(mah:TextBoxHelper.UseFloatingWatermark), RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(mah:TextBoxHelper.HasText), RelativeSource={RelativeSource Self}}" Value="True" />
                                <Condition Binding="{Binding Path=(mah:TextBoxHelper.Watermark), RelativeSource={RelativeSource Self}, Converter={x:Static mahConverters:StringIsNullOrEmptyConverter.Default}}" Value="False" />
                            </MultiDataTrigger.Conditions>
                            <MultiDataTrigger.EnterActions>
                                <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.ShowFloatingMessage}" />
                            </MultiDataTrigger.EnterActions>
                            <MultiDataTrigger.ExitActions>
                                <BeginStoryboard Storyboard="{StaticResource MahApps.Storyboard.HideFloatingMessage}" />
                            </MultiDataTrigger.ExitActions>
                        </MultiDataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.BackgroundPointerOver}" />
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.ForegroundPointerOver}" />
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.MouseOverBorderBrush)}" />
                            <Setter TargetName="PART_Message" Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.PlaceholderForegroundPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.BackgroundFocused}" />
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.ForegroundFocused}" />
                            <Setter TargetName="BorderElement" Property="BorderThickness" Value="{DynamicResource TextControlBorderThemeThicknessFocused}" />
                            <Setter TargetName="BottomEdge" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.FocusBorderBrush)}" />

                            <Setter TargetName="PART_ClearText" Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.ButtonForeground}" />
                            <Setter TargetName="PART_FloatingMessage" Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextBlock.FloatingMessage}" />
                            <Setter TargetName="PART_FloatingMessage" Property="Opacity" Value="1" />
                            <Setter TargetName="PART_Message" Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.PlaceholderForegroundFocused}" />
                        </Trigger>
                        <!--
                            A box that is switched off looks switched off, even when the caret was in
                            it when it happened: of two triggers that set the same thing, the later one
                            wins, and IsFocused stays true on a control that has just been disabled.
                        -->
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.BackgroundDisabled}" />
                            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.ForegroundDisabled}" />
                            <Setter TargetName="BorderElement" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.DisabledBorderBrush)}" />
                            <Setter TargetName="BottomEdge" Property="BorderBrush" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.DisabledBorderBrush)}" />
                            <Setter TargetName="PART_Message" Property="Foreground" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.PlaceholderForegroundDisabled}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="mah:ControlsHelper.BottomBorderBrush" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.BorderBrushBottom}" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{DynamicResource MahApps.CornerRadius.WinUI.Control}" />
        <Setter Property="mah:ControlsHelper.DisabledBorderBrush" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.BorderBrushDisabled}" />
        <Setter Property="mah:ControlsHelper.FocusBorderBrush" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.BorderBrushBottomFocused}" />
        <Setter Property="mah:ControlsHelper.MouseOverBorderBrush" Value="{DynamicResource MahApps.Brushes.TextControl.WinUI.BorderBrush}" />
        <Setter Property="mah:TextBoxHelper.ButtonTemplate" Value="{DynamicResource MahApps.Templates.Button.TextControl.WinUI}" />
    </Style>

</ResourceDictionary>
