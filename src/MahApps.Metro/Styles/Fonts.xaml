<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:markup="clr-namespace:MahApps.Metro.Markup"
                    xmlns:system="clr-namespace:System;assembly=mscorlib">

    <FontFamily x:Key="MahApps.Fonts.Family.SymbolTheme">Segoe MDL2 Assets,/MahApps.Metro;component/Assets/#Segoe MDL2 Assets</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Button">Segoe UI, Lucida Sans Unicode, Verdana</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Header">Segoe UI Light, Lucida Sans Unicode, Verdana</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Window.Title">Segoe UI Light, Lucida Sans Unicode, Verdana</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Control">Segoe UI, Lucida Sans Unicode, Verdana</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.ToggleSwitch">Segoe UI, Lucida Sans Unicode, Verdana</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.ToggleSwitch.Header">Segoe UI, Lucida Sans Unicode, Verdana</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.ContentControlTheme">Segoe UI, Lucida Sans Unicode, Verdana</FontFamily>

    <system:Double x:Key="MahApps.Font.Size.Header">40</system:Double>
    <system:Double x:Key="MahApps.Font.Size.SubHeader">29.333</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Window.Title">16</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Default">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Content">12</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Button.Flat">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.TabItem">26.67</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Button">10</system:Double>
    <system:Double x:Key="MahApps.Font.Size.FloatingWatermark">10</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Button.ClearText">16</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Tooltip">12</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Menu">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.ContextMenu">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.StatusBar">12</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Dialog.Title">26</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Dialog.Message">15</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Dialog.Button">12</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Flyout.Header">20</system:Double>
    <system:Double x:Key="MahApps.Font.Size.ToggleSwitch">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.ToggleSwitch.Header">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.ColorPicker.TabItemHeader">16</system:Double>
    <system:Double x:Key="MahApps.Font.Size.ControlContentTheme">14</system:Double>

    <!--
        The fonts of the two Windows looks. The Windows 10 values are the ones of the UWP generic.xaml,
        the WinUI ones those of TextBlock_themeresources.xaml in microsoft-ui-xaml. WPF does not drive
        the optical axis of Segoe UI Variable, but it knows the three named families of it, so the WinUI
        ramp picks Small, Text or Display the way Microsoft assigns them. Windows 10 has none of them
        and falls back to Segoe UI.
    -->
    <FontFamily x:Key="MahApps.Fonts.Family.Control.Win10">Segoe UI</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Control.WinUI">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Caption.WinUI">Segoe UI Variable Small, Segoe UI</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Display.WinUI">Segoe UI Variable Display, Segoe UI</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Window.Title.Win10">Segoe UI</FontFamily>
    <FontFamily x:Key="MahApps.Fonts.Family.Window.Title.WinUI">Segoe UI Variable Small, Segoe UI</FontFamily>
    <system:Double x:Key="MahApps.Font.Size.Window.Title.Win10">12</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Window.Title.WinUI">12</system:Double>

    <system:Double x:Key="MahApps.Font.Size.Control.Win10">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Caption.Win10">12</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Body.Win10">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Base.Win10">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Subtitle.Win10">20</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Title.Win10">24</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Subheader.Win10">34</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Header.Win10">46</system:Double>

    <system:Double x:Key="MahApps.Font.Size.Control.WinUI">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Caption.WinUI">12</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Body.WinUI">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.BodyStrong.WinUI">14</system:Double>
    <system:Double x:Key="MahApps.Font.Size.BodyLarge.WinUI">18</system:Double>
    <system:Double x:Key="MahApps.Font.Size.BodyLargeStrong.WinUI">18</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Subtitle.WinUI">20</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Title.WinUI">28</system:Double>
    <system:Double x:Key="MahApps.Font.Size.TitleLarge.WinUI">40</system:Double>
    <system:Double x:Key="MahApps.Font.Size.Display.WinUI">68</system:Double>

    <CharacterCasing x:Key="MahApps.CharacterCasing.Button">Upper</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.Button.Square">Lower</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.Button.Dialogs">Normal</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.Button.Dialogs.Accent">Normal</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.Button.Dialogs.AccentHighlight">Normal</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.DataGridColumnHeader">Upper</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.Expander">Upper</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.Expander.VisualStudio">Normal</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.GroupBox">Upper</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.GroupBox.VisualStudio">Normal</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.GridViewColumnHeader">Upper</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.ColorEyeDropper">Upper</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.ColorPalette">Upper</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.HotKeyBox">Upper</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.WindowCommands">Normal</CharacterCasing>
    <CharacterCasing x:Key="MahApps.CharacterCasing.WindowCommands.Clean">Upper</CharacterCasing>

</ResourceDictionary>