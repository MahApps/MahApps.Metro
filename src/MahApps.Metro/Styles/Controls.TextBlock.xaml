<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--  never ever make a default style for TextBlock in App.xaml !!!  -->
    <Style x:Key="MahApps.Styles.TextBlock" TargetType="{x:Type TextBlock}" />

    <Style x:Key="MahApps.Styles.TextBlock.Watermark"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Opacity" Value="0.6" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.AutoCollapsing"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.FloatingWatermark}" />
        <Setter Property="Opacity" Value="0.6" />
        <Style.Triggers>
            <Trigger Property="Text" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The type ramps of the three looks. They are never implicit, the way Microsoft's are not either:
        a text picks its step by key. Metro is made of the sizes this library has always had.
    -->
    <Style x:Key="MahApps.Styles.TextBlock.Caption"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Content}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.Body"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Default}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.Subtitle"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Flyout.Header}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.Subheader"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Header}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.SubHeader}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.Header"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Header}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Header}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.Caption.Win10"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.Win10}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Caption.Win10}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.Body.Win10"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.Win10}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Body.Win10}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.Base.Win10"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.Win10}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Base.Win10}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.Subtitle.Win10"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.Win10}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Subtitle.Win10}" />
        <Setter Property="FontWeight" Value="Normal" />
    </Style>

    <!--  SemiLight, which WPF has no name for  -->
    <Style x:Key="MahApps.Styles.TextBlock.Title.Win10"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.Win10}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Title.Win10}" />
        <Setter Property="FontWeight" Value="350" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.Subheader.Win10"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.Win10}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Subheader.Win10}" />
        <Setter Property="FontWeight" Value="Light" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.Header.Win10"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
