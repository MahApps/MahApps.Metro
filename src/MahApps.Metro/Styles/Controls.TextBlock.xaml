        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Title.WinUI}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.TitleLarge.WinUI"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Display.WinUI}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.TitleLarge.WinUI}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="MahApps.Styles.TextBlock.Display.WinUI"
           BasedOn="{StaticResource MahApps.Styles.TextBlock}"
           TargetType="{x:Type TextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Display.WinUI}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Display.WinUI}" />
