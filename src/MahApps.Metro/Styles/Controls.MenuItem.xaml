    <!--
        The two Windows looks of a menu, GH-3328. A row of either of them is a row of that set's
        list: the same height, the same padding, the same fill under the pointer, and the words in
        the colour that set writes in. The bar at the top wears that row as a tile and the flyout
        under it as a line, and what tells a header from an item is the chevron at its right hand
        end. So each set brings two templates rather than four.
    -->

    <ControlTemplate x:Key="MahApps.Templates.MenuItem.TopLevel.Win10" TargetType="{x:Type MenuItem}">
        <Grid SnapsToDevicePixels="True">
            <Border x:Name="Background"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
            <StackPanel Margin="{TemplateBinding Padding}"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                <!--  an icon of any size is brought down to the sixteen units this set draws one at, and one already smaller is left where it is rather than blown up  -->
                <Viewbox x:Name="Icon"
                         Width="16"
                         Height="16"
                         Margin="0 0 8 0"
                         VerticalAlignment="Center"
                         StretchDirection="DownOnly">
                    <ContentPresenter ContentSource="Icon" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                </Viewbox>
                <mah:FontIcon x:Name="CheckGlyph"
                              Margin="0 0 8 0"
                              VerticalAlignment="Center"
                              FontFamily="{DynamicResource MahApps.Fonts.Family.SymbolTheme}"
                              FontSize="12"
                              Foreground="{TemplateBinding Foreground}"
                              Glyph="&#xE73E;"
                              Visibility="Collapsed" />
                <ContentPresenter VerticalAlignment="Center"
                                  ContentSource="Header"
