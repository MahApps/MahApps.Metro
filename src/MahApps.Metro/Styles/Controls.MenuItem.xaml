    <!--  The line between two groups of a Windows menu: one unit, edge to edge, in a colour of its own.  -->
    <Style x:Key="MahApps.Styles.Separator.Menu.Win10" TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Menu.Win10.Separator}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Margin" Value="0 2" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Separator}">
                    <Rectangle Height="1"
                               Fill="{TemplateBinding Background}"
                               SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                               UseLayoutRounding="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MahApps.Styles.Separator.Menu.WinUI"
           BasedOn="{StaticResource MahApps.Styles.Separator.Menu.Win10}"
           TargetType="{x:Type Separator}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Menu.WinUI.Separator}" />
    </Style>

    <!--
        The Windows 10 menu item. The four roles a menu item can be in take one of the two
        templates, and each role brings the padding it stands in, since the padding of a role is
        set by a trigger in the style this one stands on and a trigger beats a plain setter.
    -->
    <Style x:Key="MahApps.Styles.MenuItem.Win10"
           BasedOn="{StaticResource MahApps.Styles.MenuItem}"
           TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.MenuItem.Win10.Background}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.MenuItem.Win10.Foreground}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="11 5 11 7" />
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.MenuItem.Submenu.Win10}" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="0" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Padding" Value="11 5 11 7" />
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.MenuItem.TopLevel.Win10}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Padding" Value="11 5 11 7" />
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.MenuItem.TopLevel.Win10}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Padding" Value="11 5 11 7" />
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.MenuItem.Submenu.Win10}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuItem">
                <Setter Property="Padding" Value="11 5 11 7" />
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.MenuItem.Submenu.Win10}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        And the WinUI one on top of it: the row is a rounded tile with air around it rather than a
        line that goes edge to edge, which is what a flyout of that set does with its rows.
    -->
    <Style x:Key="MahApps.Styles.MenuItem.WinUI"
           BasedOn="{StaticResource MahApps.Styles.MenuItem.Win10}"
           TargetType="{x:Type MenuItem}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.MenuItem.WinUI.Background}" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.MenuItem.WinUI.Foreground}" />
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.MenuItem.Submenu.WinUI}" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{DynamicResource MahApps.CornerRadius.WinUI.Control}" />
        <Style.Triggers>
            <Trigger Property="Role" Value="TopLevelHeader">
                <Setter Property="Margin" Value="4" />
                <Setter Property="Padding" Value="10 4 10 4" />
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.MenuItem.TopLevel.WinUI}" />
            </Trigger>
            <Trigger Property="Role" Value="TopLevelItem">
                <Setter Property="Margin" Value="4" />
                <Setter Property="Padding" Value="10 4 10 4" />
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.MenuItem.TopLevel.WinUI}" />
            </Trigger>
            <Trigger Property="Role" Value="SubmenuHeader">
                <Setter Property="Margin" Value="4 2" />
                <Setter Property="Padding" Value="11 4 11 5" />
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.MenuItem.Submenu.WinUI}" />
            </Trigger>
