    <SolidColorBrush x:Key="MahApps.Brushes.Badged.Background.Disabled" Color="{{MahApps.Colors.Badged.Background.Disabled}}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Badged.Foreground" Color="{StaticResource MahApps.Colors.IdealForeground}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.Badged.Foreground.Disabled" Color="{{MahApps.Colors.Badged.Foreground.Disabled}}" options:Freeze="True" />

    <!--  HamburgerMenu  -->

    <SolidColorBrush x:Key="MahApps.HamburgerMenu.Pane.Background" Color="#FF444444" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.HamburgerMenu.Pane.Foreground" Color="#FFFFFFFF" options:Freeze="True" />

    <!--
        ******************************************************************
        DEFAULT COMMON CONTROL COLORS
        ******************************************************************
    -->
    <Color x:Key="MahApps.Colors.SystemAccent">{{MahApps.Colors.AccentBase}}</Color>

    <Color x:Key="MahApps.Colors.SystemAltHigh">{{MahApps.Colors.SystemAltHigh}}</Color>
    <Color x:Key="MahApps.Colors.SystemAltLow">{{MahApps.Colors.SystemAltLow}}</Color>
    <Color x:Key="MahApps.Colors.SystemAltMedium">{{MahApps.Colors.SystemAltMedium}}</Color>
    <Color x:Key="MahApps.Colors.SystemAltMediumHigh">{{MahApps.Colors.SystemAltMediumHigh}}</Color>
    <Color x:Key="MahApps.Colors.SystemAltMediumLow">{{MahApps.Colors.SystemAltMediumLow}}</Color>
    <Color x:Key="MahApps.Colors.SystemBaseHigh">{{MahApps.Colors.SystemBaseHigh}}</Color>
    <Color x:Key="MahApps.Colors.SystemBaseLow">{{MahApps.Colors.SystemBaseLow}}</Color>
