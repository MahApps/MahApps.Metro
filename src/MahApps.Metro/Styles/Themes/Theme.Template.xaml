    <SolidColorBrush x:Key="MahApps.Brushes.SystemControlHighlightListAccentHigh" Opacity="{{MahApps.Brushes.SystemControlHighlightListAccentHigh.Opacity}}" Color="{StaticResource MahApps.Colors.SystemAccent}" options:Freeze="True" />
