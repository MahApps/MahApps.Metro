    <markup:StaticResource x:Key="MahApps.Brushes.TextControl.SelectionHighlightColor" ResourceKey="MahApps.Brushes.SystemControlHighlightAccent" />
    <markup:StaticResource x:Key="MahApps.Brushes.TextControl.ButtonBackgroundPressed" ResourceKey="MahApps.Brushes.SystemControlHighlightAccent" />
    <markup:StaticResource x:Key="MahApps.Brushes.TextControl.ButtonForegroundPointerOver" ResourceKey="MahApps.Brushes.SystemControlHighlightAccent" />

    <!--  and with the caret in the box, that edge is the accent  -->
