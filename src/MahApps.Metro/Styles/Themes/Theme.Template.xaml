    <!--
        The border of a WinUI control is drawn a little stronger along its bottom edge. That edge is
        an element of its own in the template rather than a gradient over the whole frame: WPF works
        out where the colours of a gradient measured in units land once and keeps that for the brush
        instead of for the element, so a brush shared between a box of thirty two and one of eighty
        draws the edge of the first across the middle of the second.
    -->
    <SolidColorBrush x:Key="MahApps.Brushes.TextControl.WinUI.BorderBrush" Color="{StaticResource MahApps.Colors.WinUI.ControlStrokeDefault}" options:Freeze="True" />
    <SolidColorBrush x:Key="MahApps.Brushes.TextControl.WinUI.BorderBrushBottom" Color="{StaticResource MahApps.Colors.WinUI.ControlStrokeSecondary}" options:Freeze="True" />

    <!--  and with the caret in the box, that edge is the accent  -->
    <SolidColorBrush x:Key="MahApps.Brushes.TextControl.WinUI.BorderBrushBottomFocused" Color="{StaticResource MahApps.Colors.SystemAccent}" options:Freeze="True" />

    <!--
        The frame of a drop-down belonging to one of these. It is the stronger of the two strokes
        the border of a box is made of, since a flyout has to stand away from whatever it hangs over.
