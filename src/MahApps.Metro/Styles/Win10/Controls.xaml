<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mah="clr-namespace:MahApps.Metro.Controls">

    <!--
        The Windows 10 set, the look UWP gave a control. It stands on the default one and puts its
        own styles in front of the handful it has, so an application merges this one instead of
        Styles/Controls.xaml rather than next to it.
        
        The slider, the range slider and the window buttons wear their Win10 style by default
        already, so they are not repeated here. MahApps.Styles.CheckBox.DataGrid.Win10 has no
        implicit style either, because a DataGrid column takes one through ElementStyle and
        EditingElementStyle rather than by type.
    -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style BasedOn="{StaticResource MahApps.Styles.Button.Win10}" TargetType="Button" />
    <Style BasedOn="{StaticResource MahApps.Styles.Button.Win10}" TargetType="RepeatButton" />
    <Style BasedOn="{StaticResource MahApps.Styles.CheckBox.Win10}" TargetType="CheckBox" />
    <Style BasedOn="{StaticResource MahApps.Styles.ComboBox.Win10}" TargetType="ComboBox" />
    <Style BasedOn="{StaticResource MahApps.Styles.ComboBoxItem.Win10}" TargetType="ComboBoxItem" />
    <Style BasedOn="{StaticResource MahApps.Styles.Menu.Win10}" TargetType="Menu" />
    <Style BasedOn="{StaticResource MahApps.Styles.MenuItem.Win10}" TargetType="MenuItem" />
    <Style BasedOn="{StaticResource MahApps.Styles.ContextMenu.Win10}" TargetType="ContextMenu" />
    <!--  the line between two groups of a menu is looked up by a key rather than by type, so the set hands its own over under that key  -->
    <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
           BasedOn="{StaticResource MahApps.Styles.Separator.Menu.Win10}"
           TargetType="{x:Type Separator}" />
    <Style BasedOn="{StaticResource MahApps.Styles.RadioButton.Win10}" TargetType="RadioButton" />
    <Style BasedOn="{StaticResource MahApps.Styles.ScrollBar.Win10}" TargetType="ScrollBar" />
    <!--  the line the hamburger menu shows while it waits for the pointer, so that it is the same line this set's bar shows at rest  -->
    <Style x:Key="MahApps.Styles.Thumb.ScrollBar.PanningIndicator"
           BasedOn="{StaticResource MahApps.Styles.Thumb.ScrollBar.Win10.Vertical}"
           TargetType="{x:Type Thumb}" />
    <Thickness x:Key="MahApps.Thickness.ScrollBar.PanningIndicator">0 16 0 16</Thickness>
    <Style BasedOn="{StaticResource MahApps.Styles.ScrollViewer.Win10}" TargetType="ScrollViewer" />
    <Style BasedOn="{StaticResource MahApps.Styles.TextBox.Win10}" TargetType="TextBox" />
    <Style BasedOn="{StaticResource MahApps.Styles.PasswordBox.Win10}" TargetType="PasswordBox" />
    <Style BasedOn="{StaticResource MahApps.Styles.RichTextBox.Win10}" TargetType="RichTextBox" />
    <Style BasedOn="{StaticResource MahApps.Styles.NumericUpDown.Win10}" TargetType="{x:Type mah:NumericUpDownBase}" />
    <Style BasedOn="{StaticResource MahApps.Styles.NumericUpDown.Win10}" TargetType="{x:Type mah:NumericUpDown}" />
    <Style BasedOn="{StaticResource MahApps.Styles.NumericUpDown.Win10}" TargetType="{x:Type mah:DecimalUpDown}" />
    <Style BasedOn="{StaticResource MahApps.Styles.NumericUpDown.Win10}" TargetType="{x:Type mah:IntegerUpDown}" />
    <Style BasedOn="{StaticResource MahApps.Styles.NumericUpDown.Win10}" TargetType="{x:Type mah:LongUpDown}" />
    <Style BasedOn="{StaticResource MahApps.Styles.AutoSuggestBox.Win10}" TargetType="{x:Type mah:AutoSuggestBox}" />
    <Style BasedOn="{StaticResource MahApps.Styles.HotKeyBox.Win10}" TargetType="{x:Type mah:HotKeyBox}" />
    <Style BasedOn="{StaticResource MahApps.Styles.MultiSelectionComboBox.Win10}" TargetType="{x:Type mah:MultiSelectionComboBox}" />
    <Style BasedOn="{StaticResource MahApps.Styles.SplitButton.Win10}" TargetType="{x:Type mah:SplitButton}" />
    <Style BasedOn="{StaticResource MahApps.Styles.ColorPicker.Win10}" TargetType="{x:Type mah:ColorPicker}" />
    <Style BasedOn="{StaticResource MahApps.Styles.ColorCanvas.Win10}" TargetType="{x:Type mah:ColorCanvas}" />
    <Style BasedOn="{StaticResource MahApps.Styles.ColorPalette.Win10}" TargetType="{x:Type mah:ColorPalette}" />
    <Style BasedOn="{StaticResource MahApps.Styles.ColorEyeDropper.Win10}" TargetType="{x:Type mah:ColorEyeDropper}" />
    <Style BasedOn="{StaticResource MahApps.Styles.Calendar.Win10}" TargetType="Calendar" />
    <Style BasedOn="{StaticResource MahApps.Styles.DatePicker.Win10}" TargetType="DatePicker" />
    <Style BasedOn="{StaticResource MahApps.Styles.AnalogClock.Win10}" TargetType="{x:Type mah:AnalogClock}" />
    <Style BasedOn="{StaticResource MahApps.Styles.DateTimePicker.Win10}" TargetType="{x:Type mah:DateTimePicker}" />
    <Style BasedOn="{StaticResource MahApps.Styles.TimePicker.Win10}" TargetType="{x:Type mah:TimePicker}" />


    <!--  the menu a text box puts on the right button is a named resource rather than an implicit style, so a set that wants its own has to hand one over under the same name  -->
    <ContextMenu x:Key="MahApps.TextBox.ContextMenu"
                 x:Shared="False"
                 Style="{StaticResource MahApps.Styles.ContextMenu.Win10}">
        <MenuItem Command="ApplicationCommands.Cut" Style="{DynamicResource MahApps.Styles.MenuItem.Win10}" />
        <MenuItem Command="ApplicationCommands.Copy" Style="{DynamicResource MahApps.Styles.MenuItem.Win10}" />
        <MenuItem Command="ApplicationCommands.Paste" Style="{DynamicResource MahApps.Styles.MenuItem.Win10}" />
    </ContextMenu>

</ResourceDictionary>
