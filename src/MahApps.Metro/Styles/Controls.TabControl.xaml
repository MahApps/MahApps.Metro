    <!--  MahApps.Styles.TabControl.AnimatedSingleRow  -->

    <Style x:Key="MahApps.Styles.RepeatButton.ScrollBar.AnimatedSingleRow" TargetType="{x:Type RepeatButton}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="OverridesDefaultStyle" Value="True" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Grid Background="{TemplateBinding Background}" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <mah:PathIcon x:Name="PART_Arrow"
                                      Width="12"
                                      Height="12"
                                      Data="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Content}"
                                      FlowDirection="{TemplateBinding FlowDirection}"
                                      Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="PART_Arrow" Property="Opacity" Value="0.5" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="PART_Arrow" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray1}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="PART_Arrow" Property="Foreground" Value="{DynamicResource MahApps.Brushes.Accent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="MahApps.Templates.ScrollBar.AnimatedSingleRow.Horizontal" TargetType="{x:Type ScrollBar}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <RepeatButton Grid.Column="0"
                          Width="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}"
                          AutomationProperties.Name="{x:Static lang:Automation.ScrollLeft}"
                          Command="ScrollBar.PageLeftCommand"
                          Content="M6 2L0 8l6 6z"
                          Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.AnimatedSingleRow}" />
            <RepeatButton Grid.Column="2"
                          Width="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}"
                          AutomationProperties.Name="{x:Static lang:Automation.ScrollRight}"
                          Command="ScrollBar.PageRightCommand"
                          Content="M0 14l6-6-6-6z"
                          Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.AnimatedSingleRow}" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="MahApps.Templates.ScrollBar.AnimatedSingleRow.Vertical" TargetType="{x:Type ScrollBar}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <RepeatButton Grid.Row="0"
                          Height="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}"
                          AutomationProperties.Name="{x:Static lang:Automation.ScrollUp}"
                          Command="ScrollBar.PageUpCommand"
                          Content="M12 11L6 5l-6 6z"
                          Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.AnimatedSingleRow}" />
            <RepeatButton Grid.Row="2"
                          Height="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}"
                          AutomationProperties.Name="{x:Static lang:Automation.ScrollDown}"
                          Command="ScrollBar.PageDownCommand"
                          Content="M0 5l6 6 6-6z"
                          Style="{DynamicResource MahApps.Styles.RepeatButton.ScrollBar.AnimatedSingleRow}" />
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="MahApps.Templates.ScrollViewer.AnimatedSingleRow" TargetType="{x:Type ScrollViewer}">
        <Grid>
            <ScrollBar x:Name="PART_HorizontalScrollBar"
                       Height="Auto"
                       AutomationProperties.AutomationId="MahApps.Templates.ScrollBar.AnimatedSingleRow.Horizontal"
                       Cursor="Arrow"
                       Maximum="{TemplateBinding ScrollableWidth}"
                       Minimum="0"
                       Orientation="Horizontal"
                       Template="{DynamicResource MahApps.Templates.ScrollBar.AnimatedSingleRow.Horizontal}"
                       ViewportSize="{TemplateBinding ViewportWidth}"
                       Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}"
                       Value="{Binding HorizontalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <ScrollBar x:Name="PART_VerticalScrollBar"
                       Width="Auto"
                       AutomationProperties.AutomationId="MahApps.Templates.ScrollBar.AnimatedSingleRow.Vertical"
                       Cursor="Arrow"
                       Maximum="{TemplateBinding ScrollableHeight}"
                       Minimum="0"
                       Orientation="Vertical"
                       Template="{DynamicResource MahApps.Templates.ScrollBar.AnimatedSingleRow.Vertical}"
                       ViewportSize="{TemplateBinding ViewportHeight}"
                       Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}"
                       Value="{Binding VerticalOffset, Mode=OneWay, RelativeSource={RelativeSource TemplatedParent}}" />
            <Grid Margin="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Grid.Column="1"
                      Height="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}"
                      Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
                <Grid Grid.Row="1"
                      Grid.Column="0"
                      Width="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}"
                      Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                <ScrollContentPresenter x:Name="PART_ScrollContentPresenter"
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        CanContentScroll="{TemplateBinding CanContentScroll}"
                                        CanHorizontallyScroll="False"
                                        CanVerticallyScroll="False"
                                        Content="{TemplateBinding Content}"
                                        ContentTemplate="{TemplateBinding ContentTemplate}" />
                <Grid Grid.Row="1"
                      Grid.Column="2"
                      Width="{DynamicResource {x:Static SystemParameters.HorizontalScrollBarButtonWidthKey}}"
                      Visibility="{TemplateBinding ComputedHorizontalScrollBarVisibility}" />
                <Grid Grid.Row="2"
                      Grid.Column="1"
                      Height="{DynamicResource {x:Static SystemParameters.VerticalScrollBarButtonHeightKey}}"
                      Visibility="{TemplateBinding ComputedVerticalScrollBarVisibility}" />
            </Grid>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="MahApps.Templates.TabControl.AnimatedSingleRow.Horizontal" TargetType="{x:Type TabControl}">
        <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.RowDefinitions>
                <RowDefinition x:Name="RowDefinition0" Height="Auto" />
                <RowDefinition x:Name="RowDefinition1" Height="*" />
            </Grid.RowDefinitions>
            <ScrollViewer x:Name="HeaderPanelScroll"
                          Grid.Row="0"
                          Panel.ZIndex="1"
                          mah:ScrollViewerHelper.IsHorizontalScrollWheelEnabled="{TemplateBinding mah:ScrollViewerHelper.IsHorizontalScrollWheelEnabled}"
                          HorizontalScrollBarVisibility="Auto"
                          Template="{StaticResource MahApps.Templates.ScrollViewer.AnimatedSingleRow}"
                          VerticalScrollBarVisibility="Disabled">
                <Grid x:Name="HeaderPanelGrid">
                    <mah:Underline x:Name="Underline"
                                   Background="Transparent"
                                   BorderBrush="{TemplateBinding mah:TabControlHelper.UnderlineBrush}"
                                   LineThickness="{DynamicResource TabControlUnderlineThickness}"
                                   Placement="Bottom"
                                   SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                   Visibility="Collapsed" />
                    <mah:TabPanelEx x:Name="HeaderPanel"
                                    IsItemsHost="true"
                                    KeyboardNavigation.TabIndex="1"
                                    TabWidthMode="{TemplateBinding mah:TabControlHelper.TabWidthMode}" />
                </Grid>
            </ScrollViewer>
            <mah:TransitioningContentControl x:Name="ContentPanel"
                                             Grid.Row="1"
                                             behaviors:ReloadBehavior.OnSelectedTabChanged="True"
                                             Background="{TemplateBinding Background}"
                                             BorderBrush="{TemplateBinding BorderBrush}"
                                             BorderThickness="{TemplateBinding BorderThickness}"
                                             RestartTransitionOnContentChange="True"
                                             Transition="{TemplateBinding mah:TabControlHelper.Transition}"
                                             UseLayoutRounding="True">
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  ContentSource="SelectedContent"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                  UseLayoutRounding="False" />
            </mah:TransitioningContentControl>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="mah:TabControlHelper.Underlined" Value="TabPanel">
                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Top">
                <Setter TargetName="ContentPanel" Property="Grid.Row" Value="1" />
                <Setter TargetName="HeaderPanelScroll" Property="Grid.Row" Value="0" />
                <Setter TargetName="HeaderPanelScroll" Property="Margin" Value="2 2 2 0" />
                <Setter TargetName="RowDefinition0" Property="Height" Value="Auto" />
                <Setter TargetName="RowDefinition1" Property="Height" Value="*" />
                <Setter TargetName="Underline" Property="Placement" Value="Bottom" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Bottom">
                <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                <Setter TargetName="HeaderPanelScroll" Property="Grid.Row" Value="1" />
                <Setter TargetName="HeaderPanelScroll" Property="Margin" Value="2 0 2 2" />
                <Setter TargetName="RowDefinition0" Property="Height" Value="*" />
                <Setter TargetName="RowDefinition1" Property="Height" Value="Auto" />
                <Setter TargetName="Underline" Property="Placement" Value="Top" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <ControlTemplate x:Key="MahApps.Templates.TabControl.AnimatedSingleRow.Vertical" TargetType="{x:Type TabControl}">
        <Grid KeyboardNavigation.TabNavigation="Local">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColumnDefinition0" Width="*" />
                <ColumnDefinition x:Name="ColumnDefinition1" Width="Auto" />
            </Grid.ColumnDefinitions>
            <ScrollViewer x:Name="HeaderPanelScroll"
                          Grid.Column="1"
                          Panel.ZIndex="1"
                          HorizontalScrollBarVisibility="Disabled"
                          Template="{StaticResource MahApps.Templates.ScrollViewer.AnimatedSingleRow}"
                          VerticalScrollBarVisibility="Auto">
                <Grid x:Name="HeaderPanelGrid">
                    <mah:Underline x:Name="Underline"
                                   Background="Transparent"
                                   BorderBrush="{TemplateBinding mah:TabControlHelper.UnderlineBrush}"
                                   LineThickness="{DynamicResource TabControlUnderlineThickness}"
                                   Placement="Bottom"
                                   SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                   Visibility="Collapsed" />
                    <mah:TabPanelEx x:Name="HeaderPanel"
                                    IsItemsHost="true"
                                    KeyboardNavigation.TabIndex="1"
                                    TabWidthMode="{TemplateBinding mah:TabControlHelper.TabWidthMode}" />
                </Grid>
            </ScrollViewer>
            <mah:TransitioningContentControl x:Name="ContentPanel"
                                             Grid.Column="0"
                                             behaviors:ReloadBehavior.OnSelectedTabChanged="True"
                                             Background="{TemplateBinding Background}"
                                             BorderBrush="{TemplateBinding BorderBrush}"
                                             BorderThickness="{TemplateBinding BorderThickness}"
                                             RestartTransitionOnContentChange="True"
                                             Transition="{TemplateBinding mah:TabControlHelper.Transition}"
                                             UseLayoutRounding="True">
                <ContentPresenter x:Name="PART_SelectedContentHost"
                                  Margin="{TemplateBinding Padding}"
                                  ContentSource="SelectedContent"
                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                  UseLayoutRounding="False" />
            </mah:TransitioningContentControl>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="mah:TabControlHelper.Underlined" Value="TabPanel">
                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Left">
                <Setter TargetName="ColumnDefinition0" Property="Width" Value="Auto" />
                <Setter TargetName="ColumnDefinition1" Property="Width" Value="*" />
                <Setter TargetName="ContentPanel" Property="Grid.Column" Value="1" />
                <Setter TargetName="HeaderPanelScroll" Property="Grid.Column" Value="0" />
                <Setter TargetName="HeaderPanelScroll" Property="Margin" Value="2 2 0 2" />
                <Setter TargetName="Underline" Property="Placement" Value="Right" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Right">
                <Setter TargetName="ColumnDefinition0" Property="Width" Value="*" />
                <Setter TargetName="ColumnDefinition1" Property="Width" Value="Auto" />
                <Setter TargetName="ContentPanel" Property="Grid.Column" Value="0" />
                <Setter TargetName="HeaderPanelScroll" Property="Grid.Column" Value="1" />
                <Setter TargetName="HeaderPanelScroll" Property="Margin" Value="0 2 2 2" />
                <Setter TargetName="Underline" Property="Placement" Value="Left" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MahApps.Styles.TabControl.AnimatedSingleRow"
           BasedOn="{StaticResource MahApps.Styles.TabControl}"
           TargetType="{x:Type TabControl}">
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.AnimatedSingleRow.Horizontal}" />
        <Setter Property="mah:ScrollViewerHelper.IsHorizontalScrollWheelEnabled" Value="True" />
        <Setter Property="mah:TabControlHelper.Transition" Value="Left" />
        <Style.Triggers>
            <Trigger Property="TabStripPlacement" Value="Top">
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.AnimatedSingleRow.Horizontal}" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Bottom">
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.AnimatedSingleRow.Horizontal}" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Left">
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.AnimatedSingleRow.Vertical}" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Right">
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.AnimatedSingleRow.Vertical}" />
            </Trigger>

        </Style.Triggers>
    </Style>

    <!--  MahApps.Styles.TabControl.Animated  -->

    <ControlTemplate x:Key="MahApps.Templates.TabControl.Animated" TargetType="{x:Type TabControl}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="ColumnDefinition0" />
                <ColumnDefinition x:Name="ColumnDefinition1" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition x:Name="RowDefinition0" Height="Auto" />
                <RowDefinition x:Name="RowDefinition1" Height="*" />
            </Grid.RowDefinitions>
            <Grid x:Name="HeaderPanelGrid"
                  Grid.Row="0"
                  Grid.Column="0"
                  Panel.ZIndex="1">
                <mah:Underline x:Name="Underline"
                               Background="Transparent"
                               BorderBrush="{TemplateBinding mah:TabControlHelper.UnderlineBrush}"
                               LineThickness="{DynamicResource TabControlUnderlineThickness}"
                               Placement="Bottom"
                               SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                               Visibility="Collapsed" />
                <mah:TabPanelEx x:Name="HeaderPanel"
                                IsItemsHost="true"
                                KeyboardNavigation.TabIndex="1"
                                TabWidthMode="{TemplateBinding mah:TabControlHelper.TabWidthMode}" />
            </Grid>
            <Border x:Name="ContentPanel"
                    Grid.Row="1"
                    Grid.Column="0"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    ClipToBounds="{TemplateBinding ClipToBounds}"
                    CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                    KeyboardNavigation.DirectionalNavigation="Contained"
                    KeyboardNavigation.TabIndex="2"
                    KeyboardNavigation.TabNavigation="Local"
                    SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                <mah:TransitioningContentControl behaviors:ReloadBehavior.OnSelectedTabChanged="True"
                                                 RestartTransitionOnContentChange="True"
                                                 Transition="{TemplateBinding mah:TabControlHelper.Transition}"
                                                 UseLayoutRounding="True">
                    <ContentPresenter x:Name="PART_SelectedContentHost"
                                      Margin="{TemplateBinding Padding}"
                                      ContentSource="SelectedContent"
                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"
                                      UseLayoutRounding="False" />
                </mah:TransitioningContentControl>
            </Border>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="mah:TabControlHelper.Underlined" Value="TabPanel">
                <Setter TargetName="Underline" Property="Visibility" Value="Visible" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Bottom">
                <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                <Setter TargetName="HeaderPanelGrid" Property="Grid.Row" Value="1" />
                <Setter TargetName="HeaderPanelGrid" Property="Margin" Value="2 0 2 2" />
                <Setter TargetName="RowDefinition0" Property="Height" Value="*" />
                <Setter TargetName="RowDefinition1" Property="Height" Value="Auto" />
                <Setter TargetName="Underline" Property="Placement" Value="Top" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Left">
                <Setter TargetName="ColumnDefinition0" Property="Width" Value="Auto" />
                <Setter TargetName="ColumnDefinition1" Property="Width" Value="*" />
                <Setter TargetName="ContentPanel" Property="Grid.Column" Value="1" />
                <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                <Setter TargetName="HeaderPanelGrid" Property="Grid.Column" Value="0" />
                <Setter TargetName="HeaderPanelGrid" Property="Grid.Row" Value="0" />
                <Setter TargetName="HeaderPanelGrid" Property="Margin" Value="2 2 0 2" />
                <Setter TargetName="RowDefinition0" Property="Height" Value="*" />
                <Setter TargetName="RowDefinition1" Property="Height" Value="0" />
                <Setter TargetName="Underline" Property="Placement" Value="Right" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Right">
                <Setter TargetName="ColumnDefinition0" Property="Width" Value="*" />
                <Setter TargetName="ColumnDefinition1" Property="Width" Value="Auto" />
                <Setter TargetName="ContentPanel" Property="Grid.Column" Value="0" />
                <Setter TargetName="ContentPanel" Property="Grid.Row" Value="0" />
                <Setter TargetName="HeaderPanelGrid" Property="Grid.Column" Value="1" />
                <Setter TargetName="HeaderPanelGrid" Property="Grid.Row" Value="0" />
                <Setter TargetName="HeaderPanelGrid" Property="Margin" Value="0 2 2 2" />
                <Setter TargetName="RowDefinition0" Property="Height" Value="*" />
                <Setter TargetName="RowDefinition1" Property="Height" Value="0" />
                <Setter TargetName="Underline" Property="Placement" Value="Left" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="MahApps.Styles.TabControl.Animated"
           BasedOn="{StaticResource MahApps.Styles.TabControl}"
           TargetType="{x:Type TabControl}">
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.Animated}" />
        <Setter Property="mah:TabControlHelper.Transition" Value="Left" />
    </Style>


    <Style x:Key="MahApps.Styles.TabControl.ColorPicker"
           BasedOn="{StaticResource MahApps.Styles.TabControl}"
           TargetType="TabControl">
        <Setter Property="mah:HeaderedControlHelper.HeaderFontSize" Value="{DynamicResource MahApps.Font.Size.ColorPicker.TabItemHeader}" />
    </Style>

    <!--
        Named rather than left to the implicit tab style, since a set such as the WinUI one hands
        tabs a look of their own that goes only with its own tab strip, and the strip of the picker
        is this one.
    -->
    <Style x:Key="MahApps.Styles.TabItem.ColorPicker"
           BasedOn="{StaticResource MahApps.Styles.TabItem}"
           TargetType="TabItem" />

    <!--
        The Windows 10 set of a tab strip. UWP never drew one: the Pivot it carries is a different
        control with a different job, so this set keeps the look the library has always drawn and
        the two keys below are here so that a set can hand a style over by name the way the others
        in it do.
    -->
    <Style x:Key="MahApps.Styles.TabControl.Win10"
           BasedOn="{StaticResource MahApps.Styles.TabControl}"
           TargetType="{x:Type TabControl}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.Win10}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Control.Win10}" />
    </Style>

    <Style x:Key="MahApps.Styles.TabItem.Win10"
           BasedOn="{StaticResource MahApps.Styles.TabItem}"
           TargetType="{x:Type TabItem}" />

    <!--  MahApps.Styles.TabControl.WinUI  -->

    <CornerRadius x:Key="MahApps.CornerRadius.TabItem.WinUI.Top">8 8 0 0</CornerRadius>
    <CornerRadius x:Key="MahApps.CornerRadius.TabItem.WinUI.Bottom">0 0 8 8</CornerRadius>
    <CornerRadius x:Key="MahApps.CornerRadius.TabItem.WinUI.Left">8 0 0 8</CornerRadius>
    <CornerRadius x:Key="MahApps.CornerRadius.TabItem.WinUI.Right">0 8 8 0</CornerRadius>

    <Thickness x:Key="MahApps.Thickness.TabItem.WinUI.SelectedBorder.Top">1 1 1 0</Thickness>
    <Thickness x:Key="MahApps.Thickness.TabItem.WinUI.SelectedBorder.Bottom">1 0 1 1</Thickness>
    <Thickness x:Key="MahApps.Thickness.TabItem.WinUI.SelectedBorder.Left">1 1 0 1</Thickness>
    <Thickness x:Key="MahApps.Thickness.TabItem.WinUI.SelectedBorder.Right">0 1 1 1</Thickness>

    <system:Double x:Key="MahApps.Font.Size.TabItem.WinUI">12</system:Double>

    <!--  the floor and the ceiling the TabView holds a tab between while it shares the room out between them  -->
    <system:Double x:Key="MahApps.Size.TabItem.WinUI.MinWidth">100</system:Double>
    <system:Double x:Key="MahApps.Size.TabItem.WinUI.MaxWidth">240</system:Double>

    <!--  the line between the strip and the page, drawn along the edge of the page that the strip is on  -->
    <Thickness x:Key="MahApps.Thickness.TabControl.WinUI.PageBorder.Top">0 1 0 0</Thickness>
    <Thickness x:Key="MahApps.Thickness.TabControl.WinUI.PageBorder.Bottom">0 0 0 1</Thickness>
    <Thickness x:Key="MahApps.Thickness.TabControl.WinUI.PageBorder.Left">1 0 0 0</Thickness>
    <Thickness x:Key="MahApps.Thickness.TabControl.WinUI.PageBorder.Right">0 0 1 0</Thickness>

    <!--  and what the card of the tab showing reaches over that line with, so that the line stops where the card begins  -->
    <Thickness x:Key="MahApps.Thickness.TabItem.WinUI.SelectedOverlap.Top">0 0 0 -1</Thickness>
    <Thickness x:Key="MahApps.Thickness.TabItem.WinUI.SelectedOverlap.Bottom">0 -1 0 0</Thickness>
    <Thickness x:Key="MahApps.Thickness.TabItem.WinUI.SelectedOverlap.Left">0 0 -1 0</Thickness>
    <Thickness x:Key="MahApps.Thickness.TabItem.WinUI.SelectedOverlap.Right">-1 0 0 0</Thickness>

    <!--  the button that closes a tab in the WinUI set: no ground of its own until the pointer reaches it, and the cross Segoe draws  -->
    <Style x:Key="MahApps.Styles.Button.TabItemClose.WinUI" TargetType="{x:Type Button}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.HeaderForeground}" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="4 0 0 0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Button}">
                    <Border x:Name="Border"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                            SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <mah:FontIcon HorizontalAlignment="Center"
                                      VerticalAlignment="Center"
                                      FontFamily="{DynamicResource MahApps.Fonts.Family.SymbolTheme}"
                                      FontSize="12"
                                      Foreground="{TemplateBinding Foreground}"
                                      Glyph="&#xE711;" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.CloseButtonBackgroundPointerOver}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Border" Property="Background" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.CloseButtonBackgroundPressed}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Width" Value="32" />
        <Setter Property="mah:ControlsHelper.CornerRadius" Value="{DynamicResource MahApps.CornerRadius.WinUI.Control}" />
    </Style>

    <!--
        The tab WinUI draws, read off the TabView rather than off a tab control, because a row of
        tabs is what that control is for. The tab that is showing is a card with its upper corners
        rounded, filled with the same colour as the page under it so that the two read as one
        surface, and the line along the strip passes behind it rather than under it. The others
        carry no fill until the pointer reaches them, with a hairline between two of them.
        
        What kind of underline the tab control asks for has nothing to say here, since a card
        leaves no room for one. MahApps.Styles.TabItem.WinUI.SelectorBar is the one that reads it.
        
        A close button appears where TabControlHelper.CloseButtonEnabled says so, the way the
        Visual Studio style does it, and it waits for the pointer unless this is the tab showing.
    -->
    <Style x:Key="MahApps.Styles.TabItem.WinUI"
           BasedOn="{StaticResource MahApps.Styles.TabItem.Win10}"
           TargetType="{x:Type TabItem}">
        <Setter Property="MaxWidth" Value="{DynamicResource MahApps.Size.TabItem.WinUI.MaxWidth}" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="MinWidth" Value="{DynamicResource MahApps.Size.TabItem.WinUI.MinWidth}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <!--  the ground is transparent rather than unpainted, so that the whole tab answers the pointer and not only the letters in it  -->
                    <Grid x:Name="LayoutRoot"
                          Background="Transparent"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border x:Name="TabContainer"
                                Grid.Column="0"
                                MinHeight="{TemplateBinding MinHeight}"
                                Background="{TemplateBinding mah:HeaderedControlHelper.HeaderBackground}"
                                BorderBrush="{DynamicResource MahApps.Brushes.TabControl.WinUI.BorderBrush}"
                                BorderThickness="0"
                                CornerRadius="{DynamicResource MahApps.CornerRadius.TabItem.WinUI.Top}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Grid Margin="{TemplateBinding Padding}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <mah:ContentControlEx x:Name="ContentSite"
                                                      Grid.Column="0"
                                                      HorizontalAlignment="{TemplateBinding mah:HeaderedControlHelper.HeaderHorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding mah:HeaderedControlHelper.HeaderVerticalContentAlignment}"
                                                      Content="{TemplateBinding Header}"
                                                      ContentCharacterCasing="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.ContentCharacterCasing)}"
                                                      ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                                      ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                      ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                                      FontFamily="{TemplateBinding mah:HeaderedControlHelper.HeaderFontFamily}"
                                                      FontSize="{TemplateBinding mah:HeaderedControlHelper.HeaderFontSize}"
                                                      FontStretch="{TemplateBinding mah:HeaderedControlHelper.HeaderFontStretch}"
                                                      FontStyle="{TemplateBinding FontStyle}"
                                                      FontWeight="{TemplateBinding mah:HeaderedControlHelper.HeaderFontWeight}"
                                                      Foreground="{TemplateBinding mah:HeaderedControlHelper.HeaderForeground}"
                                                      RecognizesAccessKey="{TemplateBinding mah:ControlsHelper.RecognizesAccessKey}"
                                                      SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                                <Button x:Name="PART_CloseButton"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        IsTabStop="False"
                                        Style="{DynamicResource MahApps.Styles.Button.TabItemClose.WinUI}"
                                        Visibility="Collapsed">
                                    <i:Interaction.Triggers>
                                        <i:EventTrigger EventName="Click">
                                            <actions:CloseTabItemAction Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:TabControlHelper.CloseTabCommand), Mode=OneWay}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:TabControlHelper.CloseTabCommandParameter), Mode=OneWay}" />
                                        </i:EventTrigger>
                                    </i:Interaction.Triggers>
                                </Button>
                            </Grid>
                        </Border>
                        <!--
                            The hairline that keeps two tabs apart while neither of them is lit. It
                            goes away on the tab under the pointer and on the one that is showing.
                            WinUI drops the one in front of the showing tab as well, which a style
                            on its own cannot do, since a tab is told nothing about its neighbour.
                        -->
                        <Border x:Name="TabSeparator"
                                Grid.Column="1"
                                Width="1"
                                Margin="0 8"
                                Background="{DynamicResource MahApps.Brushes.TabItem.WinUI.Separator}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="TabStripPlacement" Value="Bottom">
                            <Setter TargetName="TabContainer" Property="CornerRadius" Value="{DynamicResource MahApps.CornerRadius.TabItem.WinUI.Bottom}" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Left">
                            <Setter TargetName="TabContainer" Property="CornerRadius" Value="{DynamicResource MahApps.CornerRadius.TabItem.WinUI.Left}" />
                            <Setter TargetName="TabSeparator" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                        <Trigger Property="TabStripPlacement" Value="Right">
                            <Setter TargetName="TabContainer" Property="CornerRadius" Value="{DynamicResource MahApps.CornerRadius.TabItem.WinUI.Right}" />
                            <Setter TargetName="TabSeparator" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:HeaderedControlHelper.HeaderForegroundMouseOver), Mode=OneWay}" />
                            <Setter TargetName="TabContainer" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:HeaderedControlHelper.HeaderBackgroundMouseOver), Mode=OneWay}" />
                            <Setter TargetName="TabSeparator" Property="Visibility" Value="Hidden" />
                        </Trigger>

                        <!--  the tab that is showing: a card, its text at full strength and a touch heavier, and no line under it, since the card is what it stands on  -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ContentSite" Property="FontWeight" Value="SemiBold" />
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:HeaderedControlHelper.HeaderForegroundSelected), Mode=OneWay}" />
                            <Setter TargetName="TabContainer" Property="Background" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.HeaderBackgroundSelected}" />
                            <Setter TargetName="TabContainer" Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabItem.WinUI.SelectedBorder.Top}" />
                            <Setter TargetName="TabContainer" Property="Margin" Value="{DynamicResource MahApps.Thickness.TabItem.WinUI.SelectedOverlap.Top}" />
                            <Setter TargetName="TabSeparator" Property="Visibility" Value="Hidden" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="TabStripPlacement" Value="Bottom" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TabContainer" Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabItem.WinUI.SelectedBorder.Bottom}" />
                            <Setter TargetName="TabContainer" Property="Margin" Value="{DynamicResource MahApps.Thickness.TabItem.WinUI.SelectedOverlap.Bottom}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="TabStripPlacement" Value="Left" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TabContainer" Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabItem.WinUI.SelectedBorder.Left}" />
                            <Setter TargetName="TabContainer" Property="Margin" Value="{DynamicResource MahApps.Thickness.TabItem.WinUI.SelectedOverlap.Left}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="TabStripPlacement" Value="Right" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="TabContainer" Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabItem.WinUI.SelectedBorder.Right}" />
                            <Setter TargetName="TabContainer" Property="Margin" Value="{DynamicResource MahApps.Thickness.TabItem.WinUI.SelectedOverlap.Right}" />
                        </MultiTrigger>

                        <!--
                            The button is on every tab that can be closed rather than only on the
                            one showing. That is what the TabView does unless it is told to wait
                            for the pointer, and waiting is the way the look this library has
                            always drawn does it.
                        -->
                        <Trigger Property="mah:TabControlHelper.CloseButtonEnabled" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.HeaderForegroundDisabled}" />
                            <Setter TargetName="PART_CloseButton" Property="IsEnabled" Value="False" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The tab control the tab above belongs in: the page it shows carries the same fill as the
        card, so the two read as one surface, and a line runs along the whole strip. That line is
        the one the tab control already draws for the TabPanel kind of underline, which is why the
        kind is set here rather than left to whatever came down from the application.
    -->
    <Style x:Key="MahApps.Styles.TabControl.WinUI"
           BasedOn="{StaticResource MahApps.Styles.TabControl.Win10}"
           TargetType="{x:Type TabControl}">
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.TabControl.WinUI.Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.TabControl.WinUI.BorderBrush}" />
        <!--
            The line between the strip and the page is the edge of the page rather than the
            underline of the strip. That is what the TabView does, and it is the reason the kind of
            underline asked for has nothing to say in this style: the line is there either way, and
            the card of the tab showing reaches a unit over it so that it stops where the card
            begins. Setting the kind to TabPanel still adds the underline of the strip on top.
        -->
        <Setter Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabControl.WinUI.PageBorder.Top}" />
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.WinUI}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Control.WinUI}" />
        <!--  the tab this control hands its items, which is written for a plain one and therefore fits the one that can be closed as well  -->
        <Setter Property="ItemContainerStyle" Value="{StaticResource MahApps.Styles.TabItem.WinUI}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderBackground" Value="{x:Null}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderBackgroundMouseOver" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.HeaderBackgroundPointerOver}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderFontSize" Value="{DynamicResource MahApps.Font.Size.TabItem.WinUI}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderForeground" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.HeaderForeground}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderForegroundMouseOver" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.HeaderForegroundPointerOver}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderForegroundSelected" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.HeaderForegroundSelected}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderMargin" Value="8 3 8 3" />
        <Setter Property="mah:TabControlHelper.TabWidthMode" Value="Equal" />
        <Setter Property="mah:TabControlHelper.UnderlineBrush" Value="{DynamicResource MahApps.Brushes.TabControl.WinUI.BorderBrush}" />
        <Style.Triggers>
            <!--  the line goes along whichever edge of the page the strip is on, and an underline placement of its own moves it off that edge  -->
            <Trigger Property="TabStripPlacement" Value="Bottom">
                <Setter Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabControl.WinUI.PageBorder.Bottom}" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Left">
                <Setter Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabControl.WinUI.PageBorder.Left}" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Right">
                <Setter Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabControl.WinUI.PageBorder.Right}" />
            </Trigger>
            <Trigger Property="mah:TabControlHelper.UnderlinePlacement" Value="Top">
                <Setter Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabControl.WinUI.PageBorder.Top}" />
            </Trigger>
            <Trigger Property="mah:TabControlHelper.UnderlinePlacement" Value="Bottom">
                <Setter Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabControl.WinUI.PageBorder.Bottom}" />
            </Trigger>
            <Trigger Property="mah:TabControlHelper.UnderlinePlacement" Value="Left">
                <Setter Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabControl.WinUI.PageBorder.Left}" />
            </Trigger>
            <Trigger Property="mah:TabControlHelper.UnderlinePlacement" Value="Right">
                <Setter Property="BorderThickness" Value="{DynamicResource MahApps.Thickness.TabControl.WinUI.PageBorder.Right}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The two variants of the tab control in both WinUI sets. Each keeps the template its variant
        is about, the one that slides the page in or the one that holds the strip on a single line,
        and takes everything else from the set it belongs to.
    -->
    <Style x:Key="MahApps.Styles.TabControl.Animated.WinUI"
           BasedOn="{StaticResource MahApps.Styles.TabControl.WinUI}"
           TargetType="{x:Type TabControl}">
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.Animated}" />
        <Setter Property="mah:TabControlHelper.Transition" Value="Left" />
    </Style>

    <Style x:Key="MahApps.Styles.TabControl.AnimatedSingleRow.WinUI"
           BasedOn="{StaticResource MahApps.Styles.TabControl.WinUI}"
           TargetType="{x:Type TabControl}">
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.AnimatedSingleRow.Horizontal}" />
        <Setter Property="mah:ScrollViewerHelper.IsHorizontalScrollWheelEnabled" Value="True" />
        <Setter Property="mah:TabControlHelper.Transition" Value="Left" />
        <Style.Triggers>
            <Trigger Property="TabStripPlacement" Value="Left">
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.AnimatedSingleRow.Vertical}" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Right">
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.AnimatedSingleRow.Vertical}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  MahApps.Styles.TabControl.WinUI.SelectorBar  -->

    <system:Double x:Key="MahApps.Size.TabItem.WinUI.SelectorBar.PillLength">16</system:Double>
    <system:Double x:Key="MahApps.Size.TabItem.WinUI.SelectorBar.PillThickness">3</system:Double>
    <CornerRadius x:Key="MahApps.CornerRadius.TabItem.WinUI.SelectorBar.Pill">1.5</CornerRadius>

    <!--
        The second WinUI reading of a tab strip, this one taken from the SelectorBar: no card and
        no frame, just the headers next to each other with a short bar of the accent under the one
        that is showing. The bar grows out of the middle as a tab takes over, which is the thing
        a SelectorBar is recognised by.
        
        This is the style that reads the kind of underline asked for. None leaves the bar off
        altogether, the selected item is the SelectorBar's own behaviour, and either of the other
        two puts a bar under every header with the accent kept for the one showing. TabPanel adds
        the line along the strip on top of that, which the tab control draws.
    -->
    <Style x:Key="MahApps.Styles.TabItem.WinUI.SelectorBar"
           BasedOn="{StaticResource MahApps.Styles.TabItem.Win10}"
           TargetType="{x:Type TabItem}">
        <Setter Property="Margin" Value="0 0 8 0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type TabItem}">
                    <!--  the ground is transparent rather than unpainted, so that the whole header answers the pointer and not only the letters in it  -->
                    <Grid x:Name="LayoutRoot"
                          Background="Transparent"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border x:Name="Fill"
                                Grid.RowSpan="3"
                                Grid.ColumnSpan="3"
                                Background="{TemplateBinding mah:HeaderedControlHelper.HeaderBackground}"
                                CornerRadius="{TemplateBinding mah:ControlsHelper.CornerRadius}"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        <Grid Grid.Row="1" Grid.Column="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <mah:ContentControlEx x:Name="ContentSite"
                                                  Grid.Column="0"
                                                  Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="{TemplateBinding mah:HeaderedControlHelper.HeaderHorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding mah:HeaderedControlHelper.HeaderVerticalContentAlignment}"
                                                  Content="{TemplateBinding Header}"
                                                  ContentCharacterCasing="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:ControlsHelper.ContentCharacterCasing)}"
                                                  ContentStringFormat="{TemplateBinding HeaderStringFormat}"
                                                  ContentTemplate="{TemplateBinding HeaderTemplate}"
                                                  ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                                  FontFamily="{TemplateBinding mah:HeaderedControlHelper.HeaderFontFamily}"
                                                  FontSize="{TemplateBinding mah:HeaderedControlHelper.HeaderFontSize}"
                                                  FontStretch="{TemplateBinding mah:HeaderedControlHelper.HeaderFontStretch}"
                                                  FontStyle="{TemplateBinding FontStyle}"
                                                  FontWeight="{TemplateBinding mah:HeaderedControlHelper.HeaderFontWeight}"
                                                  Foreground="{TemplateBinding mah:HeaderedControlHelper.HeaderForeground}"
                                                  RecognizesAccessKey="{TemplateBinding mah:ControlsHelper.RecognizesAccessKey}"
                                                  SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    IsTabStop="False"
                                    Style="{DynamicResource MahApps.Styles.Button.TabItemClose.WinUI}"
                                    Visibility="Collapsed">
                                <i:Interaction.Triggers>
                                    <i:EventTrigger EventName="Click">
                                        <actions:CloseTabItemAction Command="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:TabControlHelper.CloseTabCommand), Mode=OneWay}" CommandParameter="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:TabControlHelper.CloseTabCommandParameter), Mode=OneWay}" />
                                    </i:EventTrigger>
                                </i:Interaction.Triggers>
                            </Button>
                        </Grid>
                        <!--
                            The bar itself. It starts under the header, which is where it belongs
                            for a strip along the top, and the triggers below move it to whichever
                            side was asked for. Only the one lying flat grows out of the middle as
                            a tab takes over, since the transform scales along x.
                        -->
                        <Border x:Name="Pill"
                                Grid.Row="2"
                                Grid.Column="1"
                                Width="{DynamicResource MahApps.Size.TabItem.WinUI.SelectorBar.PillLength}"
                                Height="{DynamicResource MahApps.Size.TabItem.WinUI.SelectorBar.PillThickness}"
                                Margin="{TemplateBinding mah:TabControlHelper.UnderlineMargin}"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Bottom"
                                Background="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:TabControlHelper.UnderlineBrush), Mode=OneWay}"
                                CornerRadius="{DynamicResource MahApps.CornerRadius.TabItem.WinUI.SelectorBar.Pill}"
                                IsHitTestVisible="False"
                                Opacity="0"
                                RenderTransformOrigin="0.5 0.5"
                                SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--
                            Where the bar goes. Without a placement of its own it takes the side
                            the content is on, the same way the shared tab reads it, and with one
                            it goes to that side whatever the strip is doing.
                        -->
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}, Path=(mah:TabControlHelper.UnderlinePlacement), Converter={x:Static mahConverters:IsNullConverter.Instance}}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=TabStripPlacement}" Value="Bottom" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Pill" Property="Grid.Column" Value="1" />
                            <Setter TargetName="Pill" Property="Grid.Row" Value="0" />
                            <Setter TargetName="Pill" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Pill" Property="VerticalAlignment" Value="Top" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}, Path=(mah:TabControlHelper.UnderlinePlacement), Converter={x:Static mahConverters:IsNullConverter.Instance}}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=TabStripPlacement}" Value="Left" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Pill" Property="Grid.Column" Value="2" />
                            <Setter TargetName="Pill" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Pill" Property="Height" Value="{DynamicResource MahApps.Size.TabItem.WinUI.SelectorBar.PillLength}" />
                            <Setter TargetName="Pill" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Pill" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Pill" Property="Width" Value="{DynamicResource MahApps.Size.TabItem.WinUI.SelectorBar.PillThickness}" />
                        </MultiDataTrigger>
                        <MultiDataTrigger>
                            <MultiDataTrigger.Conditions>
                                <Condition Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}, Path=(mah:TabControlHelper.UnderlinePlacement), Converter={x:Static mahConverters:IsNullConverter.Instance}}" Value="True" />
                                <Condition Binding="{Binding RelativeSource={RelativeSource Self}, Path=TabStripPlacement}" Value="Right" />
                            </MultiDataTrigger.Conditions>
                            <Setter TargetName="Pill" Property="Grid.Column" Value="0" />
                            <Setter TargetName="Pill" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Pill" Property="Height" Value="{DynamicResource MahApps.Size.TabItem.WinUI.SelectorBar.PillLength}" />
                            <Setter TargetName="Pill" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="Pill" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Pill" Property="Width" Value="{DynamicResource MahApps.Size.TabItem.WinUI.SelectorBar.PillThickness}" />
                        </MultiDataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}, Path=(mah:TabControlHelper.UnderlinePlacement)}" Value="Top">
                            <Setter TargetName="Pill" Property="Grid.Column" Value="1" />
                            <Setter TargetName="Pill" Property="Grid.Row" Value="0" />
                            <Setter TargetName="Pill" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Pill" Property="VerticalAlignment" Value="Top" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}, Path=(mah:TabControlHelper.UnderlinePlacement)}" Value="Bottom">
                            <Setter TargetName="Pill" Property="Grid.Column" Value="1" />
                            <Setter TargetName="Pill" Property="Grid.Row" Value="2" />
                            <Setter TargetName="Pill" Property="HorizontalAlignment" Value="Center" />
                            <Setter TargetName="Pill" Property="VerticalAlignment" Value="Bottom" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}, Path=(mah:TabControlHelper.UnderlinePlacement)}" Value="Left">
                            <Setter TargetName="Pill" Property="Grid.Column" Value="0" />
                            <Setter TargetName="Pill" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Pill" Property="Height" Value="{DynamicResource MahApps.Size.TabItem.WinUI.SelectorBar.PillLength}" />
                            <Setter TargetName="Pill" Property="HorizontalAlignment" Value="Left" />
                            <Setter TargetName="Pill" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Pill" Property="Width" Value="{DynamicResource MahApps.Size.TabItem.WinUI.SelectorBar.PillThickness}" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}, Path=(mah:TabControlHelper.UnderlinePlacement)}" Value="Right">
                            <Setter TargetName="Pill" Property="Grid.Column" Value="2" />
                            <Setter TargetName="Pill" Property="Grid.Row" Value="1" />
                            <Setter TargetName="Pill" Property="Height" Value="{DynamicResource MahApps.Size.TabItem.WinUI.SelectorBar.PillLength}" />
                            <Setter TargetName="Pill" Property="HorizontalAlignment" Value="Right" />
                            <Setter TargetName="Pill" Property="VerticalAlignment" Value="Center" />
                            <Setter TargetName="Pill" Property="Width" Value="{DynamicResource MahApps.Size.TabItem.WinUI.SelectorBar.PillThickness}" />
                        </DataTrigger>

                        <!--  every header but the one showing carries a bar as soon as the kind of underline asks for one  -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}, Path=(mah:TabControlHelper.Underlined)}" Value="TabItems">
                            <Setter TargetName="Pill" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}, Path=(mah:TabControlHelper.Underlined)}" Value="TabPanel">
                            <Setter TargetName="Pill" Property="Opacity" Value="1" />
                        </DataTrigger>
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type TabControl}}, Path=(mah:TabControlHelper.Underlined)}" Value="None">
                            <Setter TargetName="Pill" Property="Visibility" Value="Collapsed" />
                        </DataTrigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:HeaderedControlHelper.HeaderForegroundMouseOver), Mode=OneWay}" />
                            <Setter TargetName="Fill" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:HeaderedControlHelper.HeaderBackgroundMouseOver), Mode=OneWay}" />
                            <Setter TargetName="Pill" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:TabControlHelper.UnderlineMouseOverBrush), Mode=OneWay}" />
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="mah:HeaderedControlHelper.HeaderBackgroundMouseOver" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Fill" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:HeaderedControlHelper.HeaderBackground), Mode=OneWay}" />
                        </MultiTrigger>

                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:HeaderedControlHelper.HeaderForegroundSelected), Mode=OneWay}" />
                            <Setter TargetName="Pill" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:TabControlHelper.UnderlineSelectedBrush), Mode=OneWay}" />
                            <Setter TargetName="Pill" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation Storyboard.TargetName="Pill"
                                                         Storyboard.TargetProperty="RenderTransform.ScaleX"
                                                         From="0.25"
                                                         To="1"
                                                         Duration="0:0:0.167">
                                            <DoubleAnimation.EasingFunction>
                                                <CubicEase EasingMode="EaseOut" />
                                            </DoubleAnimation.EasingFunction>
                                        </DoubleAnimation>
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:HeaderedControlHelper.HeaderForegroundMouseOver), Mode=OneWay}" />
                            <Setter TargetName="Pill" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:TabControlHelper.UnderlineMouseOverSelectedBrush), Mode=OneWay}" />
                        </MultiTrigger>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsSelected" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="mah:TabControlHelper.UnderlineMouseOverSelectedBrush" Value="{x:Null}" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Pill" Property="Background" Value="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(mah:TabControlHelper.UnderlineSelectedBrush), Mode=OneWay}" />
                        </MultiTrigger>

                        <!--
                            The button is on every tab that can be closed rather than only on the
                            one showing. That is what the TabView does unless it is told to wait
                            for the pointer, and waiting is the way the look this library has
                            always drawn does it.
                        -->
                        <Trigger Property="mah:TabControlHelper.CloseButtonEnabled" Value="True">
                            <Setter TargetName="PART_CloseButton" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="ContentSite" Property="TextElement.Foreground" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.SelectorBar.ForegroundDisabled}" />
                            <Setter TargetName="PART_CloseButton" Property="IsEnabled" Value="False" />
                            <Setter TargetName="Pill" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="MahApps.Styles.TabControl.WinUI.SelectorBar"
           BasedOn="{StaticResource MahApps.Styles.TabControl.Win10}"
           TargetType="{x:Type TabControl}">
        <Setter Property="FontFamily" Value="{DynamicResource MahApps.Fonts.Family.Control.WinUI}" />
        <Setter Property="FontSize" Value="{DynamicResource MahApps.Font.Size.Control.WinUI}" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource MahApps.Styles.TabItem.WinUI.SelectorBar}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderBackground" Value="{x:Null}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderFontSize" Value="{DynamicResource MahApps.Font.Size.ControlContentTheme}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderForeground" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.SelectorBar.Foreground}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderForegroundMouseOver" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.SelectorBar.ForegroundPointerOver}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderForegroundSelected" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.SelectorBar.Foreground}" />
        <Setter Property="mah:HeaderedControlHelper.HeaderMargin" Value="12 10 12 7" />
        <Setter Property="mah:TabControlHelper.UnderlineBrush" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.SelectorBar.PillFillPointerOver}" />
        <Setter Property="mah:TabControlHelper.UnderlineMouseOverBrush" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.SelectorBar.PillFillPointerOver}" />
        <Setter Property="mah:TabControlHelper.UnderlineSelectedBrush" Value="{DynamicResource MahApps.Brushes.TabItem.WinUI.SelectorBar.PillFill}" />
        <Setter Property="mah:TabControlHelper.Underlined" Value="SelectedTabItem" />
    </Style>

    <Style x:Key="MahApps.Styles.TabControl.Animated.WinUI.SelectorBar"
           BasedOn="{StaticResource MahApps.Styles.TabControl.WinUI.SelectorBar}"
           TargetType="{x:Type TabControl}">
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.Animated}" />
        <Setter Property="mah:TabControlHelper.Transition" Value="Left" />
    </Style>

    <Style x:Key="MahApps.Styles.TabControl.AnimatedSingleRow.WinUI.SelectorBar"
           BasedOn="{StaticResource MahApps.Styles.TabControl.WinUI.SelectorBar}"
           TargetType="{x:Type TabControl}">
        <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.AnimatedSingleRow.Horizontal}" />
        <Setter Property="mah:ScrollViewerHelper.IsHorizontalScrollWheelEnabled" Value="True" />
        <Setter Property="mah:TabControlHelper.Transition" Value="Left" />
        <Style.Triggers>
            <Trigger Property="TabStripPlacement" Value="Left">
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.AnimatedSingleRow.Vertical}" />
            </Trigger>
            <Trigger Property="TabStripPlacement" Value="Right">
                <Setter Property="Template" Value="{StaticResource MahApps.Templates.TabControl.AnimatedSingleRow.Vertical}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--
        The two WinUI sets for the tab that can be closed. They add nothing to the shared tab: that
        control hands its three answers about closing to the matching attached properties itself,
        which is what the button in the template above reads. They stand here rather than beside
        the control, since the tab controls that name them are read before that file is.
    -->
    <Style x:Key="MahApps.Styles.MetroTabItem.WinUI"
           BasedOn="{StaticResource MahApps.Styles.TabItem.WinUI}"
           TargetType="{x:Type mah:MetroTabItem}" />

    <Style x:Key="MahApps.Styles.MetroTabItem.WinUI.SelectorBar"
           BasedOn="{StaticResource MahApps.Styles.TabItem.WinUI.SelectorBar}"
           TargetType="{x:Type mah:MetroTabItem}" />

</ResourceDictionary>