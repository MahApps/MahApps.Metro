<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:core="clr-namespace:MahApps.Metro.Gallery.Core"
                    xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls">

    <core:NumberConverter x:Key="NumberConverter" />

    <!--
        The editors a ControlExample puts in front of the properties it watches. Which one a property
        gets is decided by ExamplePropertyTemplateSelector from the type the property takes, so a page
        says what to watch and nothing about how to edit it.
    -->

    <DataTemplate x:Key="MahApps.Gallery.Templates.Option.Boolean">
        <mah:ToggleSwitch Margin="0 4"
                          ContentDirection="RightToLeft"
                          Header="{Binding Name, Mode=OneTime}"
                          IsOn="{Binding Value, Mode=TwoWay}" />
    </DataTemplate>

    <DataTemplate x:Key="MahApps.Gallery.Templates.Option.Number">
        <mah:MetroHeader Margin="0 4" Header="{Binding Name, Mode=OneTime}">
            <mah:NumericUpDown HorizontalAlignment="Stretch"
                               Interval="1"
                               Value="{Binding Value, Mode=TwoWay, Converter={StaticResource NumberConverter}}" />
        </mah:MetroHeader>
    </DataTemplate>

    <DataTemplate x:Key="MahApps.Gallery.Templates.Option.Choice">
        <mah:MetroHeader Margin="0 4" Header="{Binding Name, Mode=OneTime}">
            <ComboBox HorizontalAlignment="Stretch"
                      ItemsSource="{Binding Values, Mode=OneTime}"
                      SelectedItem="{Binding Value, Mode=TwoWay}" />
        </mah:MetroHeader>
    </DataTemplate>

    <DataTemplate x:Key="MahApps.Gallery.Templates.Option.Text">
        <mah:MetroHeader Margin="0 4" Header="{Binding Name, Mode=OneTime}">
            <TextBox HorizontalAlignment="Stretch" Text="{Binding Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </mah:MetroHeader>
    </DataTemplate>

</ResourceDictionary>
