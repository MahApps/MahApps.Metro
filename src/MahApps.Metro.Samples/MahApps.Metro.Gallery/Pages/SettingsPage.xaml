<UserControl x:Class="MahApps.Metro.Gallery.Pages.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:core="clr-namespace:MahApps.Metro.Gallery.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style x:Key="Gallery.Styles.TextBlock.SettingsSection" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.WinUI.TextPrimary}" />
            <Setter Property="Margin" Value="1 24 0 8" />
        </Style>

        <!--  a row inside the about card, under a line of its own and with its text in line with the header above  -->
        <Style x:Key="Gallery.Styles.Border.AboutRow" TargetType="{x:Type Border}">
            <Setter Property="BorderBrush" Value="{DynamicResource MahApps.Brushes.WinUI.CardStrokeDefault}" />
            <Setter Property="BorderThickness" Value="0 1 0 0" />
            <Setter Property="MinHeight" Value="56" />
            <Setter Property="Padding" Value="60 12 16 12" />
        </Style>

        <Style x:Key="Gallery.Styles.TextBlock.Secondary" TargetType="{x:Type TextBlock}">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.WinUI.TextSecondary}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <ScrollViewer Padding="24 0 24 24" VerticalScrollBarVisibility="Auto">
        <!--  a column of a thousand at most, standing in the middle once the window is wider, as the WinUI Gallery has it  -->
        <StackPanel MaxWidth="1000">

            <TextBlock Margin="1 20 0 0"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource MahApps.Brushes.WinUI.TextPrimary}"
                       Text="Settings" />

            <TextBlock Margin="1 12 0 0"
                       Style="{DynamicResource MahApps.Styles.TextBlock}"
                       Text="The gallery follows Windows until you pick something here, which is also how a MahApps application behaves out of the box."
                       TextWrapping="Wrap" />

            <TextBlock Style="{StaticResource Gallery.Styles.TextBlock.SettingsSection}" Text="Appearance" />

            <controls:SettingsCard Description="Light, dark, or whichever of the two Windows is set to."
                                   Header="App theme"
                                   Icon="{iconPacks:Material Kind=ThemeLightDark, Width=20, Height=20}">
                <ComboBox x:Name="BaseColors"
                          MinWidth="200"
                          SelectionChanged="OnBaseColorChanged" />
            </controls:SettingsCard>

            <controls:SettingsCard Description="Any colour makes a theme of its own. The swatches under MahApps are the accents that come with the library."
                                   Header="Accent colour"
                                   Icon="{iconPacks:Material Kind=Palette, Width=20, Height=20}">
                <mah:ColorPicker x:Name="Accent"
                                 Width="200"
                                 CustomColorPalette01Header="MahApps"
                                 IsCustomColorPalette01Visible="True"
                                 SelectedColorChanged="OnAccentChanged" />
            </controls:SettingsCard>

            <controls:SettingsCard Description="Takes the accent colour of Windows and changes along with it. Picking a colour above turns this off."
                                   Header="Windows accent"
                                   Icon="{iconPacks:Material Kind=MicrosoftWindows, Width=20, Height=20}">
                <mah:ToggleSwitch x:Name="FollowWindowsAccent"
                                  MinWidth="0"
                                  ContentDirection="RightToLeft"
                                  Toggled="OnFollowWindowsAccentToggled" />
            </controls:SettingsCard>

            <TextBlock Style="{StaticResource Gallery.Styles.TextBlock.SettingsSection}" Text="About" />

            <Expander Padding="0"
                      HorizontalContentAlignment="Stretch"
                      Style="{StaticResource MahApps.Styles.Expander.WinUI}">
                <Expander.Header>
                    <Grid MinHeight="66">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Image Width="20"
                               Height="20"
                               Margin="4 0 20 0"
                               VerticalAlignment="Center"
                               Source="/MahApps.Metro.Gallery;component/mahapps.metro.logo2.ico" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock FontSize="14"
                                       Foreground="{DynamicResource MahApps.Brushes.WinUI.TextPrimary}"
                                       Text="MahApps.Metro Gallery" />
                            <TextBlock Style="{StaticResource Gallery.Styles.TextBlock.Secondary}" Text="© .NET Foundation and Contributors. All rights reserved." />
                        </StackPanel>
                        <TextBlock x:Name="Version"
                                   Grid.Column="2"
                                   Margin="16 0 0 0"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource Gallery.Styles.TextBlock.Secondary}" />
                    </Grid>
                </Expander.Header>

                <StackPanel TextElement.FontSize="14">
                    <Border Style="{StaticResource Gallery.Styles.Border.AboutRow}">
                        <DockPanel>
                            <Button VerticalAlignment="Center"
                                    Command="{x:Static core:GalleryCommands.CopyText}"
                                    CommandParameter="{Binding Text, ElementName=CloneCommand}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource MahApps.Gallery.Styles.Button.CardLink}"
                                    ToolTip="Copy">
                                <iconPacks:PackIconMaterial Width="14"
                                                            Height="14"
                                                            Kind="ContentCopy" />
                            </Button>
                            <TextBlock x:Name="CloneCommand"
                                       Margin="16 0 8 0"
                                       VerticalAlignment="Center"
                                       DockPanel.Dock="Right"
                                       FontFamily="Consolas"
                                       Foreground="{DynamicResource MahApps.Brushes.WinUI.TextPrimary}"
                                       Text="git clone https://github.com/MahApps/MahApps.Metro" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource MahApps.Brushes.WinUI.TextPrimary}"
                                       Text="To clone this repository" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Gallery.Styles.Border.AboutRow}">
                        <DockPanel>
                            <Button VerticalAlignment="Center"
                                    Command="{x:Static core:GalleryCommands.OpenLink}"
                                    CommandParameter="https://github.com/MahApps/MahApps.Metro/issues/new/choose"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource MahApps.Gallery.Styles.Button.CardLink}"
                                    ToolTip="Open the issues on GitHub">
                                <iconPacks:PackIconMaterial Width="14"
                                                            Height="14"
                                                            Kind="OpenInNew" />
                            </Button>
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{DynamicResource MahApps.Brushes.WinUI.TextPrimary}"
                                       Text="File a bug or ask for a new sample" />
                        </DockPanel>
                    </Border>

                    <Border Style="{StaticResource Gallery.Styles.Border.AboutRow}">
                        <StackPanel>
                            <TextBlock Margin="0 0 0 8"
                                       Foreground="{DynamicResource MahApps.Brushes.WinUI.TextPrimary}"
                                       Text="Dependencies &amp; references" />
                            <ItemsControl x:Name="Dependencies" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type core:GalleryLink}">
                                        <TextBlock Margin="0 6">
                                            <Hyperlink Command="{x:Static core:GalleryCommands.OpenLink}" CommandParameter="{Binding Uri}">
                                                <Run Text="{Binding Text, Mode=OneWay}" />
                                            </Hyperlink>
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Gallery.Styles.Border.AboutRow}">
                        <StackPanel>
                            <TextBlock Margin="0 0 0 8"
                                       Foreground="{DynamicResource MahApps.Brushes.WinUI.TextPrimary}"
                                       Text="THE SOFTWARE IS PROVIDED &quot;AS IS&quot;, WITHOUT WARRANTY OF ANY KIND, EXPRESS OR IMPLIED, INCLUDING BUT NOT LIMITED TO THE WARRANTIES OF MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE AND NONINFRINGEMENT."
                                       TextWrapping="Wrap" />
                            <TextBlock Margin="0 6">
                                <Hyperlink Command="{x:Static core:GalleryCommands.OpenLink}" CommandParameter="https://github.com/MahApps/MahApps.Metro/blob/develop/LICENSE">MIT License</Hyperlink>
                            </TextBlock>
                            <TextBlock Margin="0 6">
                                <Hyperlink Command="{x:Static core:GalleryCommands.OpenLink}" CommandParameter="https://github.com/MahApps/MahApps.Metro/blob/develop/CODE_OF_CONDUCT.md">Code of Conduct</Hyperlink>
                            </TextBlock>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Expander>

        </StackPanel>
    </ScrollViewer>
</UserControl>
