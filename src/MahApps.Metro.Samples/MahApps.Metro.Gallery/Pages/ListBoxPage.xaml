<UserControl x:Class="MahApps.Metro.Gallery.Pages.ListBoxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="ListExample"
                                     Description="Two implicit styles at work, one for the list and one for the items in it. The accent marks what is selected, an item that is switched off stays visible but greyed, and SelectionMode decides whether more than one can be marked at once."
                                     Header="A list of items">
                <smtx:XamlDisplay UniqueKey="ListBox.Items">
                    <ListBox x:Name="List"
                             Width="280"
                             Height="180"
                             HorizontalAlignment="Left">
                        <ListBoxItem Content="Ada Lovelace" />
                        <ListBoxItem Content="Grace Hopper" IsSelected="True" />
                        <ListBoxItem Content="Alan Turing" />
                        <ListBoxItem Content="Edsger Dijkstra" IsEnabled="False" />
                        <ListBoxItem Content="Barbara Liskov" />
                    </ListBox>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="BorderExample"
                                     Description="The same list with a frame around it. A MahApps list has none, which catches people coming from WPF, and its BorderBrush is the theme foreground, so switching the thickness on alone gives a black box. Both belong together."
                                     Header="A list with a border">
                <smtx:XamlDisplay UniqueKey="ListBox.Border">
                    <ListBox x:Name="Bordered"
                             Width="280"
                             Height="180"
                             HorizontalAlignment="Left"
                             BorderBrush="{DynamicResource MahApps.Brushes.Control.Border}"
                             BorderThickness="1">
                        <ListBoxItem Content="Ada Lovelace" />
                        <ListBoxItem Content="Grace Hopper" />
                        <ListBoxItem Content="Alan Turing" />
                    </ListBox>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="LongExample"
                                     Description="A list virtualises without being asked to: only the rows that are on screen exist as controls. What this style changes is what becomes of a row that scrolls out of view. VirtualizationMode goes from Standard to Recycling, so its container is handed to the line coming in rather than thrown away and built again, and IsVirtualizingWhenGrouping keeps that going once the list is grouped. The base style already builds a VirtualizingStackPanel carrying those settings, which is not enough on its own: WPF reads them from the list rather than from the panel, and the keyed style is what puts them on the list. The items come from the code behind, 4200 of them."
                                     Header="A list with more in it than fits">
                <smtx:XamlDisplay UniqueKey="ListBox.Virtualized">
                    <ListBox x:Name="Long"
                             Width="280"
                             Height="180"
                             HorizontalAlignment="Left"
                             Style="{StaticResource MahApps.Styles.ListBox.Virtualized}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
