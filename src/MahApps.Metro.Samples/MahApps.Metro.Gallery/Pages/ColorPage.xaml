<UserControl x:Class="MahApps.Metro.Gallery.Pages.ColorPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <TextBlock Margin="0 0 0 8"
                       Style="{DynamicResource MahApps.Styles.TextBlock.Body.WinUI}"
                       TextWrapping="Wrap">
                The brushes below come with every theme of MahApps.Metro, change with it, and can be referenced by their key. For example:
            </TextBlock>

            <TextBlock Margin="0 0 0 16"
                       FontFamily="Consolas"
                       Foreground="{DynamicResource MahApps.Brushes.WinUI.TextSecondary}"
                       Text="&lt;TextBlock Text=&quot;...&quot; Foreground=&quot;{DynamicResource MahApps.Brushes.WinUI.TextPrimary}&quot; /&gt;"
                       TextWrapping="Wrap" />

            <!--  the groups sit on the page itself, as in the WinUI 3 Gallery, rather than on the ground of a tab  -->
            <mah:MetroTabControl x:Name="Tabs"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Style="{DynamicResource MahApps.Styles.MetroTabControl.WinUI.SelectorBar}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
