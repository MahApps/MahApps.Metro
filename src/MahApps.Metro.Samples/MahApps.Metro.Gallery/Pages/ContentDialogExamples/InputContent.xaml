<UserControl x:Class="MahApps.Metro.Gallery.Pages.ContentDialogExamples.InputContent"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <TextBlock Text="{Binding Question}" TextWrapping="Wrap" />
        <TextBox Margin="0 12 0 0" Text="{Binding Text, UpdateSourceTrigger=PropertyChanged}" />
    </StackPanel>
</UserControl>
