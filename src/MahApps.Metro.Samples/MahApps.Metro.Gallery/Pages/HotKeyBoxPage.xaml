<UserControl x:Class="MahApps.Metro.Gallery.Pages.HotKeyBoxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="HotKeyExample"
                                     Description="Click into the box and press the keys you want. It takes the combination rather than the letters, which is how an application asks somebody which shortcut they would like."
                                     Header="A box that takes a shortcut">
                <smtx:XamlDisplay UniqueKey="HotKeyBox.Shortcut">
                    <mah:HotKeyBox x:Name="HotKey"
                                   Width="280"
                                   HorizontalAlignment="Left"
                                   mah:TextBoxHelper.ClearTextButton="True"
                                   mah:TextBoxHelper.Watermark="Press a shortcut"
                                   AreModifierKeysRequired="True" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="Win10Example"
                                     Description="The box in the Windows 10 look, which is the text box of that set: the same fill, the same two units of frame, the same padding and the same delete button, and a frame that turns into the accent once the caret is in."
                                     Header="The Windows 10 look">
                <smtx:XamlDisplay UniqueKey="HotKeyBox.Win10">
                    <mah:HotKeyBox x:Name="Win10"
                                   Width="280"
                                   HorizontalAlignment="Left"
                                   mah:TextBoxHelper.ClearTextButton="True"
                                   mah:TextBoxHelper.Watermark="Press a shortcut"
                                   AreModifierKeysRequired="True"
                                   Style="{DynamicResource MahApps.Styles.HotKeyBox.Win10}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="WinUIExample"
                                     Description="And the WinUI one: rounded corners and a border a touch stronger along its bottom edge, which turns into the accent there while the caret is in. That edge is a border of its own, two units thick either way, so the box stays as tall as it was and nothing under it moves."
                                     Header="The WinUI look">
                <smtx:XamlDisplay UniqueKey="HotKeyBox.WinUI">
                    <mah:HotKeyBox x:Name="WinUI"
                                   Width="280"
                                   HorizontalAlignment="Left"
                                   mah:TextBoxHelper.ClearTextButton="True"
                                   mah:TextBoxHelper.Watermark="Press a shortcut"
                                   AreModifierKeysRequired="True"
                                   Style="{DynamicResource MahApps.Styles.HotKeyBox.WinUI}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
