<UserControl x:Class="MahApps.Metro.Gallery.Pages.HyperlinkPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="LinkExample"
                                     Description="A hyperlink is an inline rather than a control, so it lives inside a TextBlock and is styled rather than templated. Note the colour: at rest it takes the colour of the words around it and leaves the underline to say what it is, and only under the pointer does it take the accent."
                                     Header="A link in running text">
                <smtx:XamlDisplay UniqueKey="Hyperlink.Inline">
                    <TextBlock Width="420"
                               HorizontalAlignment="Left"
                               Style="{DynamicResource MahApps.Styles.TextBlock}"
                               TextWrapping="Wrap">
                        Every control and style in here is built from the source, which is<Hyperlink x:Name="Link"
                                   NavigateUri="https://github.com/MahApps/MahApps.Metro"
                                   RequestNavigate="OnNavigate">
                            hosted on GitHub
                        </Hyperlink>
                        along with the gallery you are reading this in.</TextBlock>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
