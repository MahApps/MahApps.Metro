<UserControl x:Class="MahApps.Metro.Gallery.Pages.MetroWindowPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample Description="The window you are looking at is one of these, and so is the one behind this button. What is shown below is the file that window is built from, all of it, since a window is the root of its own markup and cannot be a sample inside a card."
                                     Header="A window with its title bar drawn"
                                     MarkupResource="MahApps.Metro.Gallery.Windows.SampleWindow.xaml">
                <Button Width="200"
                        HorizontalAlignment="Left"
                        Click="OnOpenWindow"
                        Content="Open the window" />
            </controls:ControlExample>

            <controls:ControlExample Description="A window can have one of the materials Windows draws behind a window, which it asks for with the attached property of ControlzEx. A material is see through, and WPF draws no ClearType onto anything see through, so a window that has one gives its content a fill of its own and says that the sub pixel rendering is back on. The window behind this button switches between the materials while it is open, and shows the one thing that still costs a line its sub pixels."
                                     Header="A window with a material behind it"
                                     MarkupResource="MahApps.Metro.Gallery.Windows.BackdropWindow.xaml">
                <Button Width="200"
                        HorizontalAlignment="Left"
                        Click="OnOpenBackdropWindow"
                        Content="Open the window" />
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
