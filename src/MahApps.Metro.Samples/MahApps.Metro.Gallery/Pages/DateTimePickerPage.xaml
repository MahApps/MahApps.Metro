<UserControl x:Class="MahApps.Metro.Gallery.Pages.DateTimePickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="BothExample"
                                     Description="A date and a time in one box, with a calendar and a clock behind the drop down."
                                     Header="A date with a time">
                <smtx:XamlDisplay UniqueKey="DateTimePicker.Both">
                    <mah:DateTimePicker x:Name="Both"
                                        Width="280"
                                        HorizontalAlignment="Left"
                                        mah:TextBoxHelper.Watermark="When" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="Win10Example"
                                     Description="The Windows 10 look. The field takes the chrome of a UWP text box, the time half of the drop down becomes three columns with no clock behind them, and the calendar beside it is the square Windows 10 one, which the style hands over through CalendarStyle."
                                     Header="The Windows 10 look">
                <smtx:XamlDisplay UniqueKey="DateTimePicker.Win10">
                    <mah:DateTimePicker x:Name="Win10"
                                        Width="280"
                                        HorizontalAlignment="Left"
                                        mah:TextBoxHelper.Watermark="When"
                                        Style="{DynamicResource MahApps.Styles.DateTimePicker.Win10}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="WinUIExample"
                                     Description="And the WinUI one, which stands on it: rounded corners that the drop down follows, a border a touch stronger along its bottom edge, the selected row of an open column drawn as a rounded pill, and the rounded calendar with its round day cells."
                                     Header="The WinUI look">
                <smtx:XamlDisplay UniqueKey="DateTimePicker.WinUI">
                    <mah:DateTimePicker x:Name="WinUI"
                                        Width="280"
                                        HorizontalAlignment="Left"
                                        mah:TextBoxHelper.Watermark="When"
                                        Style="{DynamicResource MahApps.Styles.DateTimePicker.WinUI}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
