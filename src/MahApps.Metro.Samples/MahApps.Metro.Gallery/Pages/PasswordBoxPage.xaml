<UserControl x:Class="MahApps.Metro.Gallery.Pages.PasswordBoxPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="PlainExample"
                                     Description="The password box WPF ships with, wearing the MahApps style, with the watermark and the clear button coming from the same attached properties a text box uses. It also warns when caps lock is on, which is the mistake that costs people the most attempts."
                                     Header="A password box">
                <smtx:XamlDisplay UniqueKey="PasswordBox.Plain">
                    <PasswordBox x:Name="Plain"
                                 Width="280"
                                 HorizontalAlignment="Left"
                                 mah:TextBoxHelper.ClearTextButton="True"
                                 mah:TextBoxHelper.Watermark="The one you never write down" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="RevealExample"
                                     Description="The revealed style puts a button next to it that shows the password while it is held down. It is based on the plain one, so the watermark and the caps lock warning keep working, and the Win8 style on top of it differs in three settings only."
                                     Header="A password you can look at">
                <smtx:XamlDisplay UniqueKey="PasswordBox.Revealed">
                    <PasswordBox x:Name="Reveal"
                                 Width="280"
                                 HorizontalAlignment="Left"
                                 mah:TextBoxHelper.Watermark="Hold the eye to read it"
                                 Password="42 lets you in"
                                 Style="{StaticResource MahApps.Styles.PasswordBox.Revealed}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
