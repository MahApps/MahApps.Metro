<UserControl x:Class="MahApps.Metro.Gallery.Pages.HamburgerMenuPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:navigation="clr-namespace:MahApps.Metro.Gallery.Navigation"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!--  one row for every list on this page, since an option is a row of the same kind as an item  -->
        <DataTemplate x:Key="MenuItem" DataType="{x:Type mah:HamburgerMenuIconItem}">
            <Grid Height="40">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type mah:HamburgerMenu}}, Path=CompactPaneLength}" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{Binding Icon}"
                                Focusable="False"
                                IsTabStop="False" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           Text="{Binding Label}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="MenuExample"
                                     Description="The navigation down the side of this gallery is one of these. It shows its items next to the content, or narrowed down to their icons, or over them, which is what DisplayMode decides. There are more items in this one than fit, so its scroll bar has something to do: on Auto it waits for the pointer, on Visible it stays. The options at the foot of the pane stay put while the list above them scrolls, and picking one of them lets go of whatever was picked in the list. Under it the same menu in the WinUI set, MahApps.Styles.HamburgerMenu.WinUI, which is read off the NavigationView, and every option here moves both."
                                     Header="A navigation down the side">
                <smtx:XamlDisplay UniqueKey="HamburgerMenu.Navigation">
                    <StackPanel smtx:XamlDisplay.Ignore="This">
                        <mah:HamburgerMenu x:Name="Menu"
                                           Width="480"
                                           Height="320"
                                           HorizontalAlignment="Left"
                                           DisplayMode="CompactInline"
                                           IsPaneOpen="True"
                                           ItemInvoked="OnItemInvoked"
                                           ItemTemplate="{DynamicResource MenuItem}"
                                           OpenPaneLength="160"
                                           OptionsItemTemplate="{DynamicResource MenuItem}"
                                           SelectedIndex="0">
                            <mah:HamburgerMenu.ItemsSource>
                                <mah:HamburgerMenuItemCollection>
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=Home, Width=18, Height=18}"
                                                               Label="Home"
                                                               Tag="What the first item shows" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=Email, Width=18, Height=18}"
                                                               Label="Mail"
                                                               Tag="And the second one" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=CalendarMonthOutline, Width=18, Height=18}"
                                                               Label="Calendar"
                                                               Tag="The third one" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=AccountOutline, Width=18, Height=18}"
                                                               Label="People"
                                                               Tag="And the fourth" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=FileOutline, Width=18, Height=18}"
                                                               Label="Files"
                                                               Tag="There are more items here than room for them, which is what the scroll bar is about" />
                                    <mah:HamburgerMenuSeparatorItem />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=ImageOutline, Width=18, Height=18}"
                                                               Label="Photos"
                                                               Tag="Number six, and the list keeps going" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=MusicNoteOutline, Width=18, Height=18}"
                                                               Label="Music"
                                                               Tag="Number seven" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=DownloadOutline, Width=18, Height=18}"
                                                               Label="Downloads"
                                                               Tag="The last of them, and the two options below stayed where they were while you scrolled down here" />
                                </mah:HamburgerMenuItemCollection>
                            </mah:HamburgerMenu.ItemsSource>
                            <mah:HamburgerMenu.OptionsItemsSource>
                                <mah:HamburgerMenuItemCollection>
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=CogOutline, Width=18, Height=18}"
                                                               Label="Settings"
                                                               Tag="An option is what belongs to the menu rather than to what it navigates: the settings, the account, the help" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=InformationOutline, Width=18, Height=18}"
                                                               Label="About"
                                                               Tag="OptionsVisibility takes both of them away, and OptionsItemsSource is where they come from" />
                                </mah:HamburgerMenuItemCollection>
                            </mah:HamburgerMenu.OptionsItemsSource>
                        </mah:HamburgerMenu>
                        <mah:HamburgerMenu x:Name="MenuWinUI"
                                           Width="{Binding ElementName=Menu, Path=Width}"
                                           Height="{Binding ElementName=Menu, Path=Height}"
                                           Margin="0 16 0 0"
                                           HorizontalAlignment="Left"
                                           smtx:XamlDisplay.Ignore="ThisAndChildren"
                                           CanResizeOpenPane="{Binding ElementName=Menu, Path=CanResizeOpenPane}"
                                           CompactPaneLength="{Binding ElementName=Menu, Path=CompactPaneLength}"
                                           Content="{Binding ElementName=Menu, Path=Content}"
                                           DisplayMode="{Binding ElementName=Menu, Path=DisplayMode}"
                                           HamburgerVisibility="{Binding ElementName=Menu, Path=HamburgerVisibility}"
                                           IsPaneOpen="{Binding ElementName=Menu, Path=IsPaneOpen}"
                                           ItemInvoked="OnItemInvoked"
                                           ItemTemplate="{DynamicResource MenuItem}"
                                           OpenPaneLength="{Binding ElementName=Menu, Path=OpenPaneLength}"
                                           OptionsItemTemplate="{DynamicResource MenuItem}"
                                           OptionsVisibility="{Binding ElementName=Menu, Path=OptionsVisibility}"
                                           PanePlacement="{Binding ElementName=Menu, Path=PanePlacement}"
                                           SelectedIndex="{Binding ElementName=Menu, Path=SelectedIndex}"
                                           SelectedOptionsIndex="{Binding ElementName=Menu, Path=SelectedOptionsIndex}"
                                           ShowSelectionIndicator="{Binding ElementName=Menu, Path=ShowSelectionIndicator}"
                                           Style="{DynamicResource MahApps.Styles.HamburgerMenu.WinUI}"
                                           VerticalScrollBarVisibility="{Binding ElementName=Menu, Path=VerticalScrollBarVisibility}">
                            <mah:HamburgerMenu.ItemsSource>
                                <mah:HamburgerMenuItemCollection>
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=Home, Width=18, Height=18}"
                                                               Label="Home"
                                                               Tag="What the first item shows" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=Email, Width=18, Height=18}"
                                                               Label="Mail"
                                                               Tag="And the second one" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=CalendarMonthOutline, Width=18, Height=18}"
                                                               Label="Calendar"
                                                               Tag="The third one" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=AccountOutline, Width=18, Height=18}"
                                                               Label="People"
                                                               Tag="And the fourth" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=FileOutline, Width=18, Height=18}"
                                                               Label="Files"
                                                               Tag="There are more items here than room for them, which is what the scroll bar is about" />
                                    <mah:HamburgerMenuSeparatorItem />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=ImageOutline, Width=18, Height=18}"
                                                               Label="Photos"
                                                               Tag="Number six, and the list keeps going" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=MusicNoteOutline, Width=18, Height=18}"
                                                               Label="Music"
                                                               Tag="Number seven" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=DownloadOutline, Width=18, Height=18}"
                                                               Label="Downloads"
                                                               Tag="The last of them, and the two options below stayed where they were while you scrolled down here" />
                                </mah:HamburgerMenuItemCollection>
                            </mah:HamburgerMenu.ItemsSource>
                            <mah:HamburgerMenu.OptionsItemsSource>
                                <mah:HamburgerMenuItemCollection>
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=CogOutline, Width=18, Height=18}"
                                                               Label="Settings"
                                                               Tag="An option is what belongs to the menu rather than to what it navigates: the settings, the account, the help" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=InformationOutline, Width=18, Height=18}"
                                                               Label="About"
                                                               Tag="OptionsVisibility takes both of them away, and OptionsItemsSource is where they come from" />
                                </mah:HamburgerMenuItemCollection>
                            </mah:HamburgerMenu.OptionsItemsSource>
                        </mah:HamburgerMenu>
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>


            <controls:ControlExample Description="A HamburgerMenu is a ContentControl, so its content can be a Frame, and a Frame keeps a journal. The items then navigate rather than hand the menu an object, which buys a step back and a step forward over everything that has been shown, the pages a link inside a page leads to included. Two things are worth copying. A navigation only happens when the page is not the one already there, since the pane and the frame keep each other in step and would otherwise push one another round in circles. And on Navigated the pane follows the journal rather than the other way round, which is what lights the right row up again when you walk back, options included. The frame hides its own navigation UI, and the two arrows above it are the ones a MetroNavigationWindow would otherwise draw for you." Header="Pages behind the items, and a journal to walk back through">
                <smtx:XamlDisplay UniqueKey="HamburgerMenu.Journal">
                    <mah:HamburgerMenu x:Name="JournalMenu"
                                       Width="560"
                                       Height="360"
                                       HorizontalAlignment="Left"
                                       DisplayMode="CompactInline"
                                       IsPaneOpen="True"
                                       ItemInvoked="OnJournalItemInvoked"
                                       ItemTemplate="{DynamicResource MenuItem}"
                                       OpenPaneLength="160"
                                       OptionsItemTemplate="{DynamicResource MenuItem}">
                        <mah:HamburgerMenu.ItemsSource>
                            <mah:HamburgerMenuItemCollection>
                                <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=TagOutline, Width=18, Height=18}"
                                                           Label="Release"
                                                           Tag="{x:Type navigation:ReleasePage}" />
                                <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=BugOutline, Width=18, Height=18}"
                                                           Label="Issues"
                                                           Tag="{x:Type navigation:IssuesPage}" />
                                <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=AccountGroupOutline, Width=18, Height=18}"
                                                           Label="Team"
                                                           Tag="{x:Type navigation:TeamPage}" />
                            </mah:HamburgerMenuItemCollection>
                        </mah:HamburgerMenu.ItemsSource>
                        <mah:HamburgerMenu.OptionsItemsSource>
                            <mah:HamburgerMenuItemCollection>
                                <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=CogOutline, Width=18, Height=18}"
                                                           Label="Settings"
                                                           Tag="{x:Type navigation:SettingsPage}" />
                            </mah:HamburgerMenuItemCollection>
                        </mah:HamburgerMenu.OptionsItemsSource>

                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Button Width="34"
                                        Height="34"
                                        Margin="4 4 2 4"
                                        VerticalAlignment="Center"
                                        Click="OnJournalBack"
                                        IsEnabled="{Binding ElementName=JournalFrame, Mode=OneWay, Path=CanGoBack}"
                                        Style="{DynamicResource MahApps.Styles.Button.Circle}"
                                        ToolTip="Back">
                                    <mah:FontIcon FontFamily="{DynamicResource MahApps.Fonts.Family.SymbolTheme}"
                                                  FontSize="20"
                                                  Glyph="&#xE112;" />
                                </Button>
                                <Button Width="34"
                                        Height="34"
                                        Margin="2 4 4 4"
                                        VerticalAlignment="Center"
                                        Click="OnJournalForward"
                                        IsEnabled="{Binding ElementName=JournalFrame, Mode=OneWay, Path=CanGoForward}"
                                        Style="{DynamicResource MahApps.Styles.Button.Circle}"
                                        ToolTip="Forward">
                                    <mah:FontIcon FontFamily="{DynamicResource MahApps.Fonts.Family.SymbolTheme}"
                                                  FontSize="20"
                                                  Glyph="&#xE111;" />
                                </Button>
                                <TextBlock Margin="8 0 0 0"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource MahApps.Font.Size.SubHeader}"
                                           Text="{Binding ElementName=JournalFrame, Mode=OneWay, Path=Content.Title}" />
                            </StackPanel>
                            <Frame x:Name="JournalFrame"
                                   JournalOwnership="OwnsJournal"
                                   Navigated="OnJournalNavigated"
                                   NavigationUIVisibility="Hidden" />
                        </DockPanel>
                    </mah:HamburgerMenu>
                </smtx:XamlDisplay>
            </controls:ControlExample>


            <controls:ControlExample x:Name="TransitionExample"
                                     Description="The same thing again, with the pages sliding in. A frame shows what it has navigated to in a plain presenter, so the swap is instant and nothing animates. Give the frame a template whose presenter is the TransitioningContentControl this library already ships, and every navigation animates with nothing behind it: no handler on Navigating, no storyboard of your own, no walk through the visual tree to find the thing to run it on. Transition is an attached property, so it can be written on the frame and the template reads it off there. It has to read it rather than inherit it, since a frame is where property value inheritance stops, which is the same reason a page inside one needs the page style. RestartTransitionOnContentChange keeps a quick second click from waiting for the first one to finish. Pick Custom in the option and a visual state of the template&apos;s own plays instead: the arriving page fades in over 150 ms and slides up from 200 units with an ease on the way, which is the animation this started out as in a sample of its own years ago. There it took a storyboard, an attached property and a handler on Navigating to run it. Here it is a VisualState in CustomVisualStates, named after CustomVisualStatesName, and the control runs it. The page on its way out fades with it, because the control keeps two presenters rather than one."
                                     Header="The same, with the pages sliding in">
                <smtx:XamlDisplay UniqueKey="HamburgerMenu.Transition">
                    <mah:HamburgerMenu x:Name="TransitionMenu"
                                       Width="480"
                                       Height="360"
                                       HorizontalAlignment="Left"
                                       DisplayMode="CompactInline"
                                       IsPaneOpen="True"
                                       ItemInvoked="OnTransitionItemInvoked"
                                       ItemTemplate="{DynamicResource MenuItem}"
                                       OpenPaneLength="160">
                        <mah:HamburgerMenu.Resources>
                            <Style x:Key="FrameWithATransition" TargetType="{x:Type Frame}">
                                <Setter Property="ClipToBounds" Value="True" />
                                <Setter Property="JournalOwnership" Value="OwnsJournal" />
                                <Setter Property="NavigationUIVisibility" Value="Hidden" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="{x:Type Frame}">
                                            <mah:TransitioningContentControl Content="{TemplateBinding Content}"
                                                                             RestartTransitionOnContentChange="True"
                                                                             Transition="{TemplateBinding mah:TransitioningContentControl.Transition}">
                                                <mah:TransitioningContentControl.CustomVisualStates>
                                                    <VisualState x:Name="CustomTransition">
                                                        <Storyboard>
                                                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                                                                           Storyboard.TargetName="CurrentContentPresentationSite"
                                                                                           Storyboard.TargetProperty="(UIElement.Opacity)">
                                                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="0" />
                                                                <SplineDoubleKeyFrame KeyTime="00:00:00.150" Value="1" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                                                                           Storyboard.TargetName="CurrentContentPresentationSite"
                                                                                           Storyboard.TargetProperty="(UIElement.RenderTransform).(TransformGroup.Children)[3].(TranslateTransform.Y)">
                                                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="200" />
                                                                <SplineDoubleKeyFrame KeySpline="0.1,0.9 0.2,1"
                                                                                      KeyTime="00:00:00.300"
                                                                                      Value="0" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                            <DoubleAnimationUsingKeyFrames BeginTime="00:00:00"
                                                                                           Storyboard.TargetName="PreviousContentPresentationSite"
                                                                                           Storyboard.TargetProperty="(UIElement.Opacity)">
                                                                <SplineDoubleKeyFrame KeyTime="00:00:00" Value="1" />
                                                                <SplineDoubleKeyFrame KeyTime="00:00:00.150" Value="0" />
                                                            </DoubleAnimationUsingKeyFrames>
                                                        </Storyboard>
                                                    </VisualState>
                                                </mah:TransitioningContentControl.CustomVisualStates>
                                            </mah:TransitioningContentControl>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </mah:HamburgerMenu.Resources>
                        <mah:HamburgerMenu.ItemsSource>
                            <mah:HamburgerMenuItemCollection>
                                <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=TagOutline, Width=18, Height=18}"
                                                           Label="Release"
                                                           Tag="{x:Type navigation:ReleasePage}" />
                                <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=BugOutline, Width=18, Height=18}"
                                                           Label="Issues"
                                                           Tag="{x:Type navigation:IssuesPage}" />
                                <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=AccountGroupOutline, Width=18, Height=18}"
                                                           Label="Team"
                                                           Tag="{x:Type navigation:TeamPage}" />
                            </mah:HamburgerMenuItemCollection>
                        </mah:HamburgerMenu.ItemsSource>

                        <DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                                <Button Width="34"
                                        Height="34"
                                        Margin="4 4 2 4"
                                        VerticalAlignment="Center"
                                        Click="OnTransitionBack"
                                        IsEnabled="{Binding ElementName=TransitionFrame, Mode=OneWay, Path=CanGoBack}"
                                        Style="{DynamicResource MahApps.Styles.Button.Circle}"
                                        ToolTip="Back">
                                    <mah:FontIcon FontFamily="{DynamicResource MahApps.Fonts.Family.SymbolTheme}"
                                                  FontSize="20"
                                                  Glyph="&#xE112;" />
                                </Button>
                                <Button Width="34"
                                        Height="34"
                                        Margin="2 4 4 4"
                                        VerticalAlignment="Center"
                                        Click="OnTransitionForward"
                                        IsEnabled="{Binding ElementName=TransitionFrame, Mode=OneWay, Path=CanGoForward}"
                                        Style="{DynamicResource MahApps.Styles.Button.Circle}"
                                        ToolTip="Forward">
                                    <mah:FontIcon FontFamily="{DynamicResource MahApps.Fonts.Family.SymbolTheme}"
                                                  FontSize="20"
                                                  Glyph="&#xE111;" />
                                </Button>
                                <TextBlock Margin="8 0 0 0"
                                           VerticalAlignment="Center"
                                           FontSize="{DynamicResource MahApps.Font.Size.SubHeader}"
                                           Text="{Binding ElementName=TransitionFrame, Mode=OneWay, Path=Content.Title}" />
                            </StackPanel>
                            <Frame x:Name="TransitionFrame"
                                   mah:TransitioningContentControl.Transition="LeftReplace"
                                   Navigated="OnTransitionNavigated"
                                   Style="{DynamicResource FrameWithATransition}" />
                        </DockPanel>
                    </mah:HamburgerMenu>
                </smtx:XamlDisplay>
            </controls:ControlExample>


            <controls:ControlExample x:Name="LanguageExample"
                                     Description="An app that carries its words in a resource dictionary swaps that dictionary when the language changes, and every label written as a DynamicResource follows. A menu item is not a plain data object for exactly this reason: the menu takes it into its logical tree, so it sees the dictionaries above it and hears about it when one of them is exchanged. Pick another language and watch the pane, including the options at its foot."
                                     Header="Labels that come out of a language dictionary">
                <smtx:XamlDisplay UniqueKey="HamburgerMenu.Language">
                    <StackPanel HorizontalAlignment="Left">
                        <ComboBox x:Name="LanguagePicker"
                                  Width="160"
                                  Margin="0 0 0 12"
                                  HorizontalAlignment="Left"
                                  mah:TextBoxHelper.UseFloatingWatermark="True"
                                  mah:TextBoxHelper.Watermark="Language"
                                  SelectedIndex="0"
                                  SelectionChanged="OnLanguageChanged">
                            <system:String>English</system:String>
                            <system:String>Deutsch</system:String>
                            <system:String>Français</system:String>
                        </ComboBox>
                        <mah:HamburgerMenu x:Name="LanguageMenu"
                                           Width="400"
                                           Height="260"
                                           DisplayMode="Inline"
                                           IsPaneOpen="True"
                                           ItemTemplate="{DynamicResource MenuItem}"
                                           OpenPaneLength="180"
                                           OptionsItemTemplate="{DynamicResource MenuItem}"
                                           SelectedIndex="0">
                            <mah:HamburgerMenu.ItemsSource>
                                <mah:HamburgerMenuItemCollection>
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=Home, Width=18, Height=18}" Label="{DynamicResource Gallery.Menu.Home}" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=Email, Width=18, Height=18}" Label="{DynamicResource Gallery.Menu.Mail}" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=CalendarMonthOutline, Width=18, Height=18}" Label="{DynamicResource Gallery.Menu.Calendar}" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=AccountOutline, Width=18, Height=18}" Label="{DynamicResource Gallery.Menu.People}" />
                                </mah:HamburgerMenuItemCollection>
                            </mah:HamburgerMenu.ItemsSource>
                            <mah:HamburgerMenu.OptionsItemsSource>
                                <mah:HamburgerMenuItemCollection>
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=CogOutline, Width=18, Height=18}" Label="{DynamicResource Gallery.Menu.Settings}" />
                                    <mah:HamburgerMenuIconItem Icon="{iconPacks:Material Kind=InformationOutline, Width=18, Height=18}" Label="{DynamicResource Gallery.Menu.About}" />
                                </mah:HamburgerMenuItemCollection>
                            </mah:HamburgerMenu.OptionsItemsSource>
                        </mah:HamburgerMenu>
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
