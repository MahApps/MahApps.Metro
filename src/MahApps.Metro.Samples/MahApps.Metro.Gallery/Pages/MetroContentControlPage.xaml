<UserControl x:Class="MahApps.Metro.Gallery.Pages.MetroContentControlPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="EntranceExample"
                                     Description="A content control that plays a short entrance when it appears, which is what gives a MahApps page its arrival. Two things run at once and both live in the template as visual states: the opacity goes from nothing to full in 0.4 seconds, and the content drifts in over 30 units in 0.7 with an easing on it. ReverseTransition turns the drift around so that it comes in from the left instead. It runs when the control is loaded and when it becomes visible again, and Reload asks for it in between, which is what the button does. Reload turns the ask down when the transitions are off, and also when OnlyLoadTransition was on while the control loaded, because that latches after the first run."
                                     Header="Content that arrives rather than appears">
                <smtx:XamlDisplay UniqueKey="MetroContentControl.Entrance">
                    <StackPanel HorizontalAlignment="Left">
                        <Border Width="320"
                                Height="120"
                                Background="{DynamicResource MahApps.Brushes.Gray10}">
                            <mah:MetroContentControl x:Name="Entrance"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center">
                                <TextBlock FontSize="20" Text="42 of them, all at once" />
                            </mah:MetroContentControl>
                        </Border>
                        <Button Width="160"
                                Margin="0 12 0 0"
                                HorizontalAlignment="Left"
                                Click="OnReload"
                                Content="Play it again" />
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="ContentExample"
                                     Description="What it does not do. Nothing in this control watches its content: there is no override and no callback, so a new content is simply there, and the entrance is about the control arriving rather than about what it holds. The one below the line is a TransitioningContentControl, which is the one that animates one content into the next. The button hands both of them the same new text."
                                     Header="A new content is not an arrival">
                <smtx:XamlDisplay UniqueKey="MetroContentControl.Content">
                    <StackPanel HorizontalAlignment="Left">
                        <Border Width="320"
                                Height="80"
                                Background="{DynamicResource MahApps.Brushes.Gray10}">
                            <mah:MetroContentControl x:Name="Swapped"
                                                     HorizontalContentAlignment="Center"
                                                     VerticalContentAlignment="Center"
                                                     Content="Page 1 of 3" />
                        </Border>
                        <Border Width="320"
                                Height="80"
                                Margin="0 12 0 0"
                                Background="{DynamicResource MahApps.Brushes.Gray10}">
                            <mah:TransitioningContentControl x:Name="Animated"
                                                             HorizontalContentAlignment="Center"
                                                             VerticalContentAlignment="Center"
                                                             Content="Page 1 of 3"
                                                             Transition="LeftReplace" />
                        </Border>
                        <Button Width="160"
                                Margin="0 12 0 0"
                                HorizontalAlignment="Left"
                                Click="OnNext"
                                Content="Next" />
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
