<UserControl x:Class="MahApps.Metro.Gallery.Pages.ExpanderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="PlainExample"
                                     Description="The header band in the accent colour, an arrow that turns, and a quarter second fade on the content. ExpandDirection decides which edge the content unfolds from, and the header turns with it."
                                     Header="Content behind a header">
                <smtx:XamlDisplay UniqueKey="Expander.Plain">
                    <Expander x:Name="Plain"
                              Width="320"
                              HorizontalAlignment="Left"
                              Header="What is in here"
                              IsExpanded="True">
                        <TextBlock Margin="8"
                                   Style="{DynamicResource MahApps.Styles.TextBlock}"
                                   Text="42 of them, and room for more."
                                   TextWrapping="Wrap" />
                    </Expander>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="Win10Example"
                                     Description="The Windows 10 set, where the header is a list row rather than a band of the accent: the page underneath until the pointer arrives, with a line around header and content and a rule between the two. The chevron sits at the far end and turns as the content comes out."
                                     Header="The Windows 10 look">
                <smtx:XamlDisplay UniqueKey="Expander.Win10">
                    <Expander x:Name="Win10"
                              Width="360"
                              HorizontalAlignment="Left"
                              Header="This text is in the header"
                              IsExpanded="True"
                              Style="{StaticResource MahApps.Styles.Expander.Win10}">
                        <TextBlock Text="And this text is in the content area." TextWrapping="Wrap" />
                    </Expander>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="WinUIExample"
                                     Description="And the WinUI set, where the same control is two cards: the header on the card fill of that set with the chevron in a rounded square at its end, and the content on the quieter fill below it. What answers the pointer there is that square rather than the whole of the header. Both looks come from merging Styles/WinUI/Controls.xaml; the styles are named here because the gallery itself wears the Metro look."
                                     Header="The WinUI look">
                <smtx:XamlDisplay UniqueKey="Expander.WinUI">
                    <Expander x:Name="WinUI"
                              Width="360"
                              HorizontalAlignment="Left"
                              Header="This text is in the header"
                              IsExpanded="True"
                              Style="{StaticResource MahApps.Styles.Expander.WinUI}">
                        <TextBlock Text="And this text is in the content area." TextWrapping="Wrap" />
                    </Expander>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="AlignmentExample"
                                     Description="Where the words stand is two properties: HeaderedControlHelper.HeaderHorizontalContentAlignment for the header, HorizontalContentAlignment for what is behind it. The header keeps the room the chevron takes, so a centred header is centred in what is left of the row."
                                     Header="Where the words stand">
                <smtx:XamlDisplay UniqueKey="Expander.Alignment">
                    <Expander x:Name="Alignment"
                              Width="360"
                              HorizontalAlignment="Left"
                              HorizontalContentAlignment="Left"
                              mah:HeaderedControlHelper.HeaderHorizontalContentAlignment="Center"
                              Header="This text is centered"
                              IsExpanded="True"
                              Style="{StaticResource MahApps.Styles.Expander.WinUI}">
                        <TextBlock Text="And this text is left aligned" TextWrapping="Wrap" />
                    </Expander>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="StudioExample"
                                     Description="The Visual Studio variant, which is drawn for the dark Visual Studio theme and therefore sits on a dark strip here. Controls.xaml does not merge it, so the two dictionaries it needs come in on the expander itself."
                                     Header="The Visual Studio look">
                <smtx:XamlDisplay UniqueKey="Expander.VisualStudio">
                    <Border Width="360"
                            Padding="16"
                            HorizontalAlignment="Left"
                            Background="#FF2D2D30">
                        <Expander x:Name="Studio"
                                  Header="What is in here"
                                  IsExpanded="True"
                                  Style="{DynamicResource MahApps.Styles.Expander.VisualStudio}">
                            <Expander.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/VS/Controls.xaml" />
                                        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/VS/Colors.xaml" />
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </Expander.Resources>
                            <TextBlock Margin="8"
                                       Text="42 of them, and room for more."
                                       TextWrapping="Wrap" />
                        </Expander>
                    </Border>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
