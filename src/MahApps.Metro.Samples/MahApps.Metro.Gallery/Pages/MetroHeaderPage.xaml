<UserControl x:Class="MahApps.Metro.Gallery.Pages.MetroHeaderPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="AboveExample"
                                     Description="A label that belongs to the control under it. Every option in this gallery is one of these, which is why they all line up."
                                     Header="A label over a control">
                <smtx:XamlDisplay UniqueKey="MetroHeader.Above">
                    <mah:MetroHeader x:Name="Above"
                                     Width="280"
                                     HorizontalAlignment="Left"
                                     Header="How many">
                        <mah:NumericUpDown Value="42" />
                    </mah:MetroHeader>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="BesideExample"
                                     Description="The same thing turned sideways, for a form that reads better in two columns."
                                     Header="A label beside a control">
                <smtx:XamlDisplay UniqueKey="MetroHeader.Beside">
                    <mah:MetroHeader x:Name="Beside"
                                     HorizontalAlignment="Left"
                                     mah:HeaderedControlHelper.HeaderMargin="0 0 8 0"
                                     mah:HeaderedControlHelper.HeaderVerticalContentAlignment="Center"
                                     Header="How many"
                                     Orientation="Horizontal">
                        <mah:NumericUpDown Width="160" Value="42" />
                    </mah:MetroHeader>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
