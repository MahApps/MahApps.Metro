<UserControl x:Class="MahApps.Metro.Gallery.Pages.SplitButtonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="SplitExample"
                                     Description="One half does what is selected and the other half offers the rest. The selected item stays selected, so the next click repeats it without opening the list again."
                                     Header="A button split in two">
                <smtx:XamlDisplay UniqueKey="SplitButton.Items">
                    <mah:SplitButton x:Name="Split"
                                     Width="220"
                                     HorizontalAlignment="Left"
                                     DisplayMemberPath="Header"
                                     SelectedIndex="0">
                        <mah:SplitButton.Items>
                            <MenuItem Header="Save" />
                            <MenuItem Header="Save as" />
                            <MenuItem Header="Save a copy" />
                        </mah:SplitButton.Items>
                    </mah:SplitButton>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="IconExample"
                                     Description="The same button with an icon in front of the selection, which is what Icon is for."
                                     Header="A split button with an icon">
                <smtx:XamlDisplay UniqueKey="SplitButton.Icon">
                    <mah:SplitButton x:Name="WithIcon"
                                     Width="220"
                                     HorizontalAlignment="Left"
                                     DisplayMemberPath="Header"
                                     SelectedIndex="0">
                        <mah:SplitButton.Icon>
                            <iconPacks:PackIconMaterial Width="14"
                                                        Height="14"
                                                        Kind="ContentSave" />
                        </mah:SplitButton.Icon>
                        <mah:SplitButton.Items>
                            <MenuItem Header="Save" />
                            <MenuItem Header="Save as" />
                        </mah:SplitButton.Items>
                    </mah:SplitButton>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
