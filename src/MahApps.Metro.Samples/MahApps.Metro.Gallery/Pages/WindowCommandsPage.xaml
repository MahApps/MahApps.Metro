<UserControl x:Class="MahApps.Metro.Gallery.Pages.WindowCommandsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <!--
                No sample in the card itself: the template of a WindowCommands reads the title bar
                of the window it is in, so anywhere but in a MetroWindow it draws itself against
                bindings that cannot be resolved.
            -->
            <controls:ControlExample Description="A row of buttons for the title bar, on either side of the title, which a MetroWindow takes as LeftWindowCommands and RightWindowCommands. It is a ToolBar underneath, so what goes in are buttons, and what is left over goes into an overflow of its own. The window behind this button has one on each side, the right one with two buttons and the separator between them."
                                     Header="Commands beside the title"
                                     MarkupResource="MahApps.Metro.Gallery.Windows.TitleBarWindow.xaml">
                <Button Width="200"
                        HorizontalAlignment="Left"
                        Click="OnOpenWindow"
                        Content="Open the window" />
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
