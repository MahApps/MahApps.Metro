<UserControl x:Class="MahApps.Metro.Gallery.Pages.ScrollBarPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="ViewerExample"
                                     Description="Anything larger than the space it sits in gets a bar, and the MahApps one is two arrows and a thumb over whatever is behind them. Nothing paints a groove, which is also why setting Background on a ScrollBar does nothing: the track is the two repeat buttons either side of the thumb, and they are transparent. The gallery wears the WinUI bar everywhere, so this example pins the default style and the one below it to show what a plain Controls.xaml draws."
                                     Header="More than fits">
                <smtx:XamlDisplay UniqueKey="ScrollBar.Viewer">
                    <ScrollViewer x:Name="Viewer"
                                  Width="300"
                                  Height="140"
                                  HorizontalAlignment="Left"
                                  HorizontalScrollBarVisibility="Auto"
                                  Style="{DynamicResource MahApps.Styles.ScrollViewer}"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style BasedOn="{StaticResource MahApps.Styles.ScrollBar}" TargetType="{x:Type ScrollBar}" />
                        </ScrollViewer.Resources>
                        <Border Width="460"
                                Height="240"
                                Background="{DynamicResource MahApps.Brushes.Gray9}">
                            <TextBlock Margin="8"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Text="460 by 240 in half the room" />
                        </Border>
                    </ScrollViewer>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="BarExample"
                                     Description="The bar on its own, which is where the missing track shows. Turning it off is worth a look too: the whole bar goes to half opacity and the thumb to none at all, so a disabled scrollbar is two faint arrows with a gap between them."
                                     Header="The bar on its own">
                <smtx:XamlDisplay UniqueKey="ScrollBar.Bar">
                    <ScrollBar x:Name="Bar"
                               Width="300"
                               HorizontalAlignment="Left"
                               Maximum="100"
                               Minimum="0"
                               Orientation="Horizontal"
                               Style="{DynamicResource MahApps.Styles.ScrollBar}"
                               ViewportSize="20"
                               Value="42" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="SizeExample"
                                     Description="Four resources decide how thick a bar is, twelve units by default, two for the bar itself and two for the arrow buttons, and a change needs all four. Override the first pair alone and the bar gets wider while the arrows stay small in the middle of it."
                                     Header="How thick it is">
                <smtx:XamlDisplay UniqueKey="ScrollBar.Size">
                    <ScrollViewer xmlns:system="clr-namespace:System;assembly=mscorlib"
                                  x:Name="Thick"
                                  Width="300"
                                  Height="140"
                                  HorizontalAlignment="Left"
                                  HorizontalScrollBarVisibility="Auto"
                                  Style="{DynamicResource MahApps.Styles.ScrollViewer}"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style BasedOn="{StaticResource MahApps.Styles.ScrollBar}" TargetType="{x:Type ScrollBar}" />
                            <system:Double x:Key="MahApps.Sizes.ScrollBar.Width">22</system:Double>
                            <system:Double x:Key="MahApps.Sizes.ScrollBar.Height">22</system:Double>
                            <system:Double x:Key="MahApps.Sizes.ScrollBar.HorizontalRepeatButton.Width">22</system:Double>
                            <system:Double x:Key="MahApps.Sizes.ScrollBar.VerticalRepeatButton.Height">22</system:Double>
                        </ScrollViewer.Resources>
                        <Border Width="460"
                                Height="240"
                                Background="{DynamicResource MahApps.Brushes.Gray9}">
                            <TextBlock Margin="8"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Text="The same box behind 22-unit bars" />
                        </Border>
                    </ScrollViewer>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="Win10Example"
                                     Description="The Windows 10 bar is sixteen units, square, and everything the default leaves out is there: a filled track, a thumb that grows when the pointer is on it and a chevron button at either end. It sits beside the content the way the desktop bar does, so the column it needs is reserved whether or not anything is scrollable."
                                     Header="The Windows 10 look">
                <smtx:XamlDisplay UniqueKey="ScrollBar.Win10">
                    <ScrollViewer x:Name="Win10"
                                  Width="300"
                                  Height="140"
                                  HorizontalAlignment="Left"
                                  HorizontalScrollBarVisibility="Auto"
                                  Style="{DynamicResource MahApps.Styles.ScrollViewer}"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style BasedOn="{StaticResource MahApps.Styles.ScrollBar.Win10}" TargetType="{x:Type ScrollBar}" />
                        </ScrollViewer.Resources>
                        <Border Width="460"
                                Height="240"
                                Background="{DynamicResource MahApps.Brushes.Gray9}">
                            <TextBlock Margin="8"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Text="460 by 240 behind the Windows 10 bar" />
                        </Border>
                    </ScrollViewer>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="WinUIExample"
                                     Description="The WinUI bar is two things rather than one state. With the pointer elsewhere it is a two unit line at the edge of the content, and under the pointer it grows inwards into a six unit thumb on a rounded panel with a chevron at each end. MahApps.Styles.ScrollViewer.WinUI lays it over the content instead of beside it, which is what the guidance asks for and the reason the bar costs no room while nobody is pointing at it. This is the bar the rest of the gallery uses."
                                     Header="The WinUI look">
                <smtx:XamlDisplay UniqueKey="ScrollBar.WinUI">
                    <ScrollViewer x:Name="WinUI"
                                  Width="300"
                                  Height="140"
                                  HorizontalAlignment="Left"
                                  HorizontalScrollBarVisibility="Auto"
                                  Style="{DynamicResource MahApps.Styles.ScrollViewer.WinUI}"
                                  VerticalScrollBarVisibility="Auto">
                        <ScrollViewer.Resources>
                            <Style BasedOn="{StaticResource MahApps.Styles.ScrollBar.WinUI}" TargetType="{x:Type ScrollBar}" />
                        </ScrollViewer.Resources>
                        <Border Width="460"
                                Height="240"
                                Background="{DynamicResource MahApps.Brushes.Gray9}">
                            <TextBlock Margin="8"
                                       HorizontalAlignment="Left"
                                       VerticalAlignment="Top"
                                       Text="460 by 240 under the WinUI bar" />
                        </Border>
                    </ScrollViewer>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="StudioExample"
                                     Description="The Visual Studio bar is 18 units instead of twelve, and unlike the default it does draw a track and puts its arrows in boxes. It is drawn for the dark shell, which is why it sits on a dark strip here, and it needs the colours of that theme alongside the style."
                                     Header="The Visual Studio look">
                <smtx:XamlDisplay UniqueKey="ScrollBar.VisualStudio">
                    <Border Width="360"
                            Padding="16"
                            HorizontalAlignment="Left"
                            Background="#FF2D2D30">
                        <ScrollBar x:Name="Studio"
                                   Maximum="100"
                                   Minimum="0"
                                   Orientation="Horizontal"
                                   Style="{DynamicResource MahApps.Styles.ScrollBar.VisualStudio}"
                                   ViewportSize="20"
                                   Value="42">
                            <ScrollBar.Resources>
                                <ResourceDictionary>
                                    <ResourceDictionary.MergedDictionaries>
                                        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/VS/ScrollBar.xaml" />
                                        <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/VS/Colors.xaml" />
                                    </ResourceDictionary.MergedDictionaries>
                                </ResourceDictionary>
                            </ScrollBar.Resources>
                        </ScrollBar>
                    </Border>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
