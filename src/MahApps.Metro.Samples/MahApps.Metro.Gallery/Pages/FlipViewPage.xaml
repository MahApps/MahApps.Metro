<UserControl x:Class="MahApps.Metro.Gallery.Pages.FlipViewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="FlipExample"
                                     Description="One item at a time with a banner over it, and the arrows appear as soon as the mouse is over the control."
                                     Header="A page at a time">
                <smtx:XamlDisplay UniqueKey="FlipView.Pages">
                    <mah:FlipView x:Name="Flip"
                                  Width="420"
                                  Height="220"
                                  HorizontalAlignment="Left"
                                  BannerText="The first one">
                        <Grid Background="{DynamicResource MahApps.Brushes.Accent3}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="28"
                                       Text="42" />
                        </Grid>
                        <Grid Background="{DynamicResource MahApps.Brushes.Accent2}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="28"
                                       Text="The middle one" />
                        </Grid>
                        <Grid Background="{DynamicResource MahApps.Brushes.Accent}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="28"
                                       Text="And the last" />
                        </Grid>
                    </mah:FlipView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
