<UserControl x:Class="MahApps.Metro.Gallery.Pages.WindowButtonCommandsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample Description="The three buttons at the end of a title bar. A MetroWindow puts them there by itself, and declaring them is for when the tooltips or the styles should be your own rather than the ones Windows hands out. The window behind this button says all four tooltips itself, so hold the mouse over one of them."
                                     Header="Minimize, maximize and close"
                                     MarkupResource="MahApps.Metro.Gallery.Windows.TitleBarWindow.xaml">
                <Button Width="200"
                        HorizontalAlignment="Left"
                        Click="OnOpenWindow"
                        Content="Open the window" />
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
