<UserControl x:Class="MahApps.Metro.Gallery.Pages.ButtonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="PlainExample"
                                     Description="The button every WPF application starts with, wearing the MahApps style."
                                     Header="A button">
                <smtx:XamlDisplay UniqueKey="Button.Plain">
                    <Button x:Name="Plain"
                            Width="160"
                            HorizontalAlignment="Left"
                            Content="Click me" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="SquareExample"
                                     Description="The square style drops the rounded corners for a two unit border and a semibold, lower-cased content. The casing is no accident: the style sets ControlsHelper.ContentCharacterCasing from MahApps.CharacterCasing.Button.Square, which is Lower, the way the default button takes Upper from MahApps.CharacterCasing.Button. Both are resources rather than fixed values, so overriding the key changes every button in the application and setting the property changes this one. MahApps.Styles.Button.Square.Highlight is the same style with the darker accent behind it."
                                     Header="The square one">
                <smtx:XamlDisplay UniqueKey="Button.Square">
                    <Button x:Name="Square"
                            Width="160"
                            HorizontalAlignment="Left"
                            Content="Save"
                            Style="{StaticResource MahApps.Styles.Button.Square}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="AccentExample"
                                     Description="The square style with the accent colour behind it, for the one button on a page that matters most."
                                     Header="A button in the accent colour">
                <smtx:XamlDisplay UniqueKey="Button.Accent">
                    <Button x:Name="Accent"
                            Width="160"
                            HorizontalAlignment="Left"
                            Content="Save"
                            Style="{StaticResource MahApps.Styles.Button.Square.Accent}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="CircleExample"
                                     Description="A round button holding an icon, which is what the circle style is for."
                                     Header="A button with an icon">
                <smtx:XamlDisplay UniqueKey="Button.Circle">
                    <Button x:Name="Circle"
                            Width="48"
                            Height="48"
                            HorizontalAlignment="Left"
                            Style="{StaticResource MahApps.Styles.Button.Circle}">
                        <iconPacks:PackIconMaterial Width="18"
                                                    Height="18"
                                                    Kind="Heart" />
                    </Button>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="FlatExample"
                                     Description="No border at all and the flat background brush behind it. The other half of the difference is the writing: the default button comes bold, upper-cased and at 10, the flat one leaves the casing alone and sits at 14. Styles/Controls.FlatButton.xaml still exists and is often handed out as the way to get this look, but all that dictionary does is make the style implicit for every Button in scope. The key itself lives in Controls.Buttons.xaml, which Controls.xaml already merges, so it works without any extra import."
                                     Header="The flat one">
                <smtx:XamlDisplay UniqueKey="Button.Flat">
                    <Button x:Name="Flat"
                            Width="160"
                            HorizontalAlignment="Left"
                            Content="Save"
                            Style="{StaticResource MahApps.Styles.Button.Flat}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="ChromelessExample"
                                     Description="Transparent, no border, no padding: the content, the hit area and nothing else. It is what the library reaches for whenever a button has to read as part of another control rather than as a button of its own. The delete button in a text box, the reveal button of a PasswordBox and the toggle of the HamburgerMenu are all based on it."
                                     Header="The one without any chrome">
                <smtx:XamlDisplay UniqueKey="Button.Chromeless">
                    <Button x:Name="Chromeless"
                            HorizontalAlignment="Left"
                            Content="Forgot your password?"
                            Style="{StaticResource MahApps.Styles.Button.Chromeless}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="Win10Example"
                                     Description="MahApps.Styles.Button.Win10 is the flat button with a two unit border and the content font at its normal weight, instead of the bold, upper-cased button font the older styles use, and MahApps.Styles.Button.Accent.Win10 is the same filled with the accent colour. Neither of the two is in 2.4.11; both arrived on develop."
                                     Header="The pair in the Windows 10 look">
                <smtx:XamlDisplay UniqueKey="Button.Win10">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="Win10"
                                Width="160"
                                Content="Cancel"
                                Style="{StaticResource MahApps.Styles.Button.Win10}" />
                        <Button x:Name="AccentWin10"
                                Width="160"
                                Margin="8 0 0 0"
                                Content="Save"
                                Style="{StaticResource MahApps.Styles.Button.Accent.Win10}" />
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="FlatAccentExample"
                                     Description="MahApps.Styles.Button.Flat.Accent is built on the accented Windows 10 button and then paints the ordinary button colours back over it, so the accent is not where the name puts it. At rest this is the plain button with a one unit border, hovering moves that border to the accent colour, and the fill arrives only while the button is really held down. It is on develop and not in 2.4.11 either."
                                     Header="The one that keeps its accent for the press">
                <smtx:XamlDisplay UniqueKey="Button.FlatAccent">
                    <Button x:Name="FlatAccent"
                            Width="160"
                            HorizontalAlignment="Left"
                            Content="Save"
                            Style="{StaticResource MahApps.Styles.Button.Flat.Accent}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
