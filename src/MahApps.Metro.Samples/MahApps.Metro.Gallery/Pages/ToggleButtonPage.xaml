<UserControl x:Class="MahApps.Metro.Gallery.Pages.ToggleButtonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="PlainExample"
                                     Description="A button that stays pressed, drawn like the ordinary buttons and filled with a dark grey while it is checked rather than with the accent colour, which is what the other two do. Three states are allowed, and there is a catch in them: the style draws the indeterminate state exactly like the unchecked one, so nobody can tell the two apart. Where the third state has to be visible, a CheckBox has a dash of its own for it."
                                     Header="A button that stays pressed">
                <smtx:XamlDisplay UniqueKey="ToggleButton.Plain">
                    <ToggleButton x:Name="Plain"
                                  MinWidth="100"
                                  HorizontalAlignment="Left"
                                  Content="Bold"
                                  IsChecked="True" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="CircleExample"
                                     Description="The round one is transparent until it is checked and then fills with the accent colour. It brings no content of its own and is meant to carry an icon, and the template swaps the foreground to the ideal one while checked, so an icon painted in the accent colour would disappear against the fill."
                                     Header="The round one">
                <smtx:XamlDisplay UniqueKey="ToggleButton.Circle">
                    <ToggleButton x:Name="Circle"
                                  Width="48"
                                  Height="48"
                                  HorizontalAlignment="Left"
                                  IsChecked="True"
                                  Style="{DynamicResource MahApps.Styles.ToggleButton.Circle}">
                        <iconPacks:PackIconMaterial Width="20"
                                                    Height="20"
                                                    Kind="Star" />
                    </ToggleButton>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="FlatExample"
                                     Description="And the flat one, which drops the border and fills with the accent colour while checked, ideal foreground and all. It is the one for a row of latching buttons that should read as a strip rather than as separate controls."
                                     Header="The flat one">
                <smtx:XamlDisplay UniqueKey="ToggleButton.Flat">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <ToggleButton x:Name="Flat"
                                      MinWidth="60"
                                      Content="Bold"
                                      IsChecked="True"
                                      Style="{DynamicResource MahApps.Styles.ToggleButton.Flat}" />
                        <ToggleButton MinWidth="60"
                                      Content="Italic"
                                      Style="{DynamicResource MahApps.Styles.ToggleButton.Flat}" />
                        <ToggleButton MinWidth="60"
                                      Content="42"
                                      Style="{DynamicResource MahApps.Styles.ToggleButton.Flat}" />
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="Win10Example"
                                     Description="MahApps.Styles.ToggleButton.Win10 is that set's button for as long as the toggle is up and that set's accent button once it is down, down to the frame that appears under the pointer and the grey it drops to while it is held. A toggle and a button standing beside each other are the same control until one of them latches. The third state is drawn like the unchecked one, the way Windows draws it. It is on develop and not in 2.4.11."
                                     Header="The one in the Windows 10 look">
                <smtx:XamlDisplay UniqueKey="ToggleButton.Win10">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <ToggleButton x:Name="Win10"
                                      MinWidth="72"
                                      Content="Bold"
                                      IsChecked="True"
                                      Style="{StaticResource MahApps.Styles.ToggleButton.Win10}" />
                        <ToggleButton MinWidth="72"
                                      Margin="8 0 0 0"
                                      Content="Italic"
                                      Style="{StaticResource MahApps.Styles.ToggleButton.Win10}" />
                        <ToggleButton MinWidth="72"
                                      Margin="8 0 0 0"
                                      Content="42"
                                      Style="{StaticResource MahApps.Styles.ToggleButton.Win10}" />
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="WinUIExample"
                                     Description="MahApps.Styles.ToggleButton.WinUI is the same story in the WinUI look: the colours of that set's button while the toggle is up and the ones of its accent button while it is down. So the rounded corners, the one unit of frame and the line a shade stronger along the bottom are all the button's, and once the toggle is checked that line goes over to the accent with the rest of it. It is on develop and not in 2.4.11."
                                     Header="The one in the WinUI look">
                <smtx:XamlDisplay UniqueKey="ToggleButton.WinUI">
                    <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                        <ToggleButton x:Name="WinUI"
                                      MinWidth="72"
                                      Content="Bold"
                                      IsChecked="True"
                                      Style="{StaticResource MahApps.Styles.ToggleButton.WinUI}" />
                        <ToggleButton MinWidth="72"
                                      Margin="8 0 0 0"
                                      Content="Italic"
                                      Style="{StaticResource MahApps.Styles.ToggleButton.WinUI}" />
                        <ToggleButton MinWidth="72"
                                      Margin="8 0 0 0"
                                      Content="42"
                                      Style="{StaticResource MahApps.Styles.ToggleButton.WinUI}" />
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
