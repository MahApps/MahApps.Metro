<UserControl x:Class="MahApps.Metro.Gallery.Pages.DataGridPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="GridExample"
                                     Description="The grid WPF ships with, wearing the MahApps style. Along with the look the style sets a few habits: no grid lines, column headers but no row headers, and a minimum row height. The rows here are the pages of this gallery, and the prefix for that list is declared on the grid itself."
                                     Header="A table of rows">
                <smtx:XamlDisplay UniqueKey="DataGrid.Rows">
                    <DataGrid xmlns:core="clr-namespace:MahApps.Metro.Gallery.Core"
                              x:Name="Rows"
                              Width="560"
                              Height="240"
                              HorizontalAlignment="Left"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{x:Static core:GalleryPages.All}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*"
                                                Binding="{Binding Title}"
                                                Header="Page" />
                            <DataGridTextColumn Width="*"
                                                Binding="{Binding Category}"
                                                Header="Category" />
                            <DataGridTextColumn Width="3*"
                                                Binding="{Binding Keywords}"
                                                Header="What it is about" />
                        </DataGrid.Columns>
                    </DataGrid>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="AzureExample"
                                     Description="The Azure variant, modelled on the grids in the Azure portal. It tints whichever column is in front with the accent colour, and the row style with the margin separates the rows into cards rather than a continuous table."
                                     Header="The Azure look">
                <smtx:XamlDisplay UniqueKey="DataGrid.Azure">
                    <DataGrid xmlns:core="clr-namespace:MahApps.Metro.Gallery.Core"
                              x:Name="Azure"
                              Width="560"
                              Height="240"
                              HorizontalAlignment="Left"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{x:Static core:GalleryPages.All}"
                              RowStyle="{StaticResource MahApps.Styles.DataGridRow.AzureWithMargin}"
                              Style="{StaticResource MahApps.Styles.DataGrid.Azure}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="2*"
                                                Binding="{Binding Title}"
                                                Header="Page" />
                            <DataGridTextColumn Width="*"
                                                Binding="{Binding Category}"
                                                Header="Category" />
                        </DataGrid.Columns>
                    </DataGrid>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
