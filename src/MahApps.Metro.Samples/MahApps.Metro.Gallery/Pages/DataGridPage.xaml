<UserControl x:Class="MahApps.Metro.Gallery.Pages.DataGridPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:core="clr-namespace:MahApps.Metro.Gallery.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!--  one view each, since grids sharing a view also share how it is sorted and which row is the current one  -->
        <CollectionViewSource x:Key="BasicLanguages" Source="{x:Static core:SampleLanguages.All}" />
        <CollectionViewSource x:Key="GroupedLanguages" Source="{x:Static core:SampleLanguages.All}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Paradigm" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="TemplatedLanguages" Source="{x:Static core:SampleLanguages.All}" />
    </UserControl.Resources>

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="BasicExample"
                                     Description="Bind a collection to ItemsSource and define its columns. Click a header to sort, a row to select it, and drag the edge of a header to resize. FrozenColumnCount keeps the ID in place while the rest scrolls sideways. Which set of styles the grid wears is picked at the top of the page."
                                     Header="A basic table">
                <smtx:XamlDisplay UniqueKey="DataGrid.Basic">
                    <StackPanel>
                        <DataGrid x:Name="Basic"
                                  Height="280"
                                  MaxWidth="480"
                                  HorizontalAlignment="Left"
                                  AutoGenerateColumns="False"
                                  CanUserSortColumns="True"
                                  FrozenColumnCount="1"
                                  IsReadOnly="True"
                                  IsSynchronizedWithCurrentItem="False"
                                  ItemsSource="{Binding Source={StaticResource BasicLanguages}}"
                                  SelectionChanged="BasicSelectionChanged"
                                  SelectionMode="Single"
                                  Sorting="BasicSorting">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="60"
                                                    Binding="{Binding Id}"
                                                    CanUserResize="False"
                                                    CanUserSort="False"
                                                    Header="ID" />
                                <DataGridTextColumn Width="140"
                                                    Binding="{Binding Name}"
                                                    Header="Name" />
                                <DataGridTextColumn Width="180"
                                                    Binding="{Binding Designer}"
                                                    Header="Designer" />
                                <DataGridTextColumn Width="140"
                                                    Binding="{Binding Paradigm}"
                                                    Header="Paradigm" />
                                <DataGridTextColumn Width="100"
                                                    Binding="{Binding Year}"
                                                    Header="Year" />
                            </DataGrid.Columns>
                        </DataGrid>
                        <TextBlock Margin="0 12 0 0" Text="ID cannot be sorted or resized. The third click on a header puts the rows back into source order." />
                        <TextBlock x:Name="SortStatus"
                                   Margin="0 8 0 0"
                                   Text="Rows are in source order." />
                        <TextBlock x:Name="SelectionStatus"
                                   Margin="0 8 0 0"
                                   Text="No row selected." />
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="GroupingExample"
                                     Description="One view filters and groups the same collection. Filter by name or paradigm, then change the grouping without losing the filter. The header over each group comes with the set, so there is no GroupStyle to write, and a click on it folds the group."
                                     Header="Filtering and grouping rows">
                <controls:ControlExample.Options>
                    <StackPanel>
                        <mah:MetroHeader Margin="0 4" Header="Group by">
                            <ComboBox x:Name="GroupBy"
                                      HorizontalAlignment="Stretch"
                                      SelectedIndex="1"
                                      SelectionChanged="GroupByChanged">
                                <ComboBoxItem Content="None" />
                                <ComboBoxItem Content="Paradigm" />
                                <ComboBoxItem Content="Status" />
                            </ComboBox>
                        </mah:MetroHeader>
                        <Button Margin="0 8 0 0"
                                HorizontalAlignment="Left"
                                Click="ExpandAllGroups"
                                Content="Expand all groups" />
                        <Button Margin="0 8 0 0"
                                HorizontalAlignment="Left"
                                Click="CollapseAllGroups"
                                Content="Collapse all groups" />
                    </StackPanel>
                </controls:ControlExample.Options>
                <smtx:XamlDisplay UniqueKey="DataGrid.Grouping">
                    <StackPanel>
                        <TextBlock Margin="0 0 0 8" Text="Filter by name or paradigm" />
                        <TextBox x:Name="Filter"
                                 Width="300"
                                 HorizontalAlignment="Left"
                                 mah:TextBoxHelper.ClearTextButton="True"
                                 mah:TextBoxHelper.Watermark="Try Functional or Lisp"
                                 TextChanged="FilterChanged" />
                        <DataGrid x:Name="Grouping"
                                  Width="480"
                                  Height="320"
                                  Margin="0 12 0 0"
                                  HorizontalAlignment="Left"
                                  AutoGenerateColumns="False"
                                  CanUserResizeColumns="False"
                                  CanUserSortColumns="False"
                                  IsReadOnly="True"
                                  IsSynchronizedWithCurrentItem="False"
                                  ItemsSource="{Binding Source={StaticResource GroupedLanguages}}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="*"
                                                    Binding="{Binding Name}"
                                                    Header="Name" />
                                <DataGridTextColumn Width="140"
                                                    Binding="{Binding Paradigm}"
                                                    Header="Paradigm" />
                                <DataGridTextColumn Width="100"
                                                    Binding="{Binding Status}"
                                                    Header="Status" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="TemplatesExample"
                                     Description="A text column next to cells of their own: a monogram with two lines of text, a status badge, the year on a timeline and a read-only rating. SortMemberPath lets the template columns sort by the values underneath."
                                     Header="Customizing cells with data templates">
                <smtx:XamlDisplay UniqueKey="DataGrid.Templates">
                    <DataGrid x:Name="Templates"
                              Height="360"
                              HorizontalAlignment="Left"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              IsSynchronizedWithCurrentItem="False"
                              ItemsSource="{Binding Source={StaticResource TemplatedLanguages}}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Width="72"
                                                Binding="{Binding Id}"
                                                Header="ID" />
                            <DataGridTemplateColumn Width="220"
                                                    Header="Language"
                                                    SortMemberPath="Name">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0 6" Orientation="Horizontal">
                                            <Border Width="32"
                                                    Height="32"
                                                    Background="{DynamicResource MahApps.Brushes.Gray9}"
                                                    CornerRadius="16">
                                                <TextBlock HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontWeight="SemiBold"
                                                           Text="{Binding Monogram}" />
                                            </Border>
                                            <StackPanel Margin="12 0 0 0" VerticalAlignment="Center">
                                                <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                                <TextBlock FontSize="12"
                                                           Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                                           Text="{Binding Designer}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="110"
                                                    Header="Status"
                                                    SortMemberPath="Status">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Padding="8 2"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource MahApps.Brushes.Gray9}"
                                                CornerRadius="4">
                                            <TextBlock FontSize="12" Text="{Binding Status}" />
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="220"
                                                    Header="First appeared"
                                                    SortMemberPath="Year">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Grid VerticalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="56" />
                                            </Grid.ColumnDefinitions>
                                            <ProgressBar Grid.Column="0"
                                                         VerticalAlignment="Center"
                                                         Maximum="{x:Static core:SampleLanguages.LastYear}"
                                                         Minimum="{x:Static core:SampleLanguages.FirstYear}"
                                                         Value="{Binding Year, Mode=OneWay}" />
                                            <TextBlock Grid.Column="1"
                                                       Margin="0 0 8 0"
                                                       VerticalAlignment="Center"
                                                       Text="{Binding Year}"
                                                       TextAlignment="Right" />
                                        </Grid>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Width="180"
                                                    Header="Influence"
                                                    SortMemberPath="Influence">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <mah:RatingControl VerticalAlignment="Center"
                                                           IsReadOnly="True"
                                                           Value="{Binding Influence, Mode=OneWay}" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
