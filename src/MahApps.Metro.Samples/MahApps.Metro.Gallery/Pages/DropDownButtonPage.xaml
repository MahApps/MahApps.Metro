<UserControl x:Class="MahApps.Metro.Gallery.Pages.DropDownButtonPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             xmlns:system="clr-namespace:System;assembly=mscorlib"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="DropDownExample"
                                     Description="A button that opens a menu instead of doing something itself."
                                     Header="A button with a menu">
                <smtx:XamlDisplay UniqueKey="DropDownButton.Menu">
                    <mah:DropDownButton x:Name="DropDown"
                                        Width="200"
                                        HorizontalAlignment="Left"
                                        Content="Export">
                        <mah:DropDownButton.Items>
                            <MenuItem Header="As a picture" />
                            <MenuItem Header="As a table" />
                            <Separator />
                            <MenuItem Header="As it is" />
                        </mah:DropDownButton.Items>
                    </mah:DropDownButton>
                </smtx:XamlDisplay>
            </controls:ControlExample>


            <controls:ControlExample x:Name="Win10Example"
                                     Description="The same button in the Windows 10 set, which is that set's button with a chevron after the word. The menu under it is that set's menu, so its rows are the rows of a list. The left button is filled with menu items, the right one from an ItemsSource."
                                     Header="The Windows 10 look">
                <smtx:XamlDisplay UniqueKey="DropDownButton.Win10">
                    <StackPanel Orientation="Horizontal">
                        <mah:DropDownButton x:Name="Win10DropDown"
                                            Content="Export"
                                            Style="{StaticResource MahApps.Styles.DropDownButton.Win10}">
                            <mah:DropDownButton.Resources>
                                <Style BasedOn="{StaticResource MahApps.Styles.MenuItem.Win10}" TargetType="{x:Type MenuItem}" />
                                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
                                       BasedOn="{StaticResource MahApps.Styles.Separator.Menu.Win10}"
                                       TargetType="{x:Type Separator}" />
                            </mah:DropDownButton.Resources>
                            <mah:DropDownButton.Items>
                                <MenuItem Header="As a picture" />
                                <MenuItem Header="As a table" />
                                <Separator />
                                <MenuItem Header="As it is" />
                            </mah:DropDownButton.Items>
                        </mah:DropDownButton>
                        <mah:DropDownButton x:Name="Win10Bound"
                                            Margin="12 0 0 0"
                                            Content="Open with"
                                            Style="{StaticResource MahApps.Styles.DropDownButton.Win10}">
                            <mah:DropDownButton.Resources>
                                <Style BasedOn="{StaticResource MahApps.Styles.MenuItem.Win10}" TargetType="{x:Type MenuItem}" />
                            </mah:DropDownButton.Resources>
                            <mah:DropDownButton.ItemsSource>
                                <x:Array Type="{x:Type system:String}">
                                    <system:String>Notepad</system:String>
                                    <system:String>Visual Studio</system:String>
                                    <system:String>Paint</system:String>
                                </x:Array>
                            </mah:DropDownButton.ItemsSource>
                        </mah:DropDownButton>
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="WinUIExample"
                                     Description="And the WinUI set, where the button is rounded and carries the stronger edge along its bottom, and the menu comes up as a rounded flyout with a shadow under it. Both looks come from merging Styles/WinUI/Controls.xaml; the styles are named here because the gallery itself wears the Metro look."
                                     Header="The WinUI look">
                <smtx:XamlDisplay UniqueKey="DropDownButton.WinUI">
                    <StackPanel Orientation="Horizontal">
                        <mah:DropDownButton x:Name="WinUIDropDown"
                                            Content="Export"
                                            Style="{StaticResource MahApps.Styles.DropDownButton.WinUI}">
                            <mah:DropDownButton.Resources>
                                <Style BasedOn="{StaticResource MahApps.Styles.MenuItem.WinUI}" TargetType="{x:Type MenuItem}" />
                                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}"
                                       BasedOn="{StaticResource MahApps.Styles.Separator.Menu.WinUI}"
                                       TargetType="{x:Type Separator}" />
                            </mah:DropDownButton.Resources>
                            <mah:DropDownButton.Items>
                                <MenuItem Header="As a picture" />
                                <MenuItem Header="As a table" />
                                <Separator />
                                <MenuItem Header="As it is" />
                            </mah:DropDownButton.Items>
                        </mah:DropDownButton>
                        <mah:DropDownButton x:Name="WinUIBound"
                                            Margin="12 0 0 0"
                                            Content="Open with"
                                            Style="{StaticResource MahApps.Styles.DropDownButton.WinUI}">
                            <mah:DropDownButton.Resources>
                                <Style BasedOn="{StaticResource MahApps.Styles.MenuItem.WinUI}" TargetType="{x:Type MenuItem}" />
                            </mah:DropDownButton.Resources>
                            <mah:DropDownButton.ItemsSource>
                                <x:Array Type="{x:Type system:String}">
                                    <system:String>Notepad</system:String>
                                    <system:String>Visual Studio</system:String>
                                    <system:String>Paint</system:String>
                                </x:Array>
                            </mah:DropDownButton.ItemsSource>
                        </mah:DropDownButton>
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>
        </StackPanel>
    </ScrollViewer>
</UserControl>
