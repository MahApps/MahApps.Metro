<UserControl x:Class="MahApps.Metro.Gallery.Pages.ListViewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="ColumnsExample"
                                     Description="A list view with a GridView in it, which is the one WPF gives you columns with. The column headers get their own style, and the rows are the pages of this gallery so the sample carries no data of its own. The prefix for that list is declared on the view itself."
                                     Header="A list with columns">
                <smtx:XamlDisplay UniqueKey="ListView.Columns">
                    <ListView xmlns:core="clr-namespace:MahApps.Metro.Gallery.Core"
                              x:Name="Columns"
                              Width="520"
                              Height="200"
                              HorizontalAlignment="Left"
                              ItemsSource="{x:Static core:GalleryPages.All}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="200"
                                                DisplayMemberBinding="{Binding Title}"
                                                Header="Page" />
                                <GridViewColumn Width="120"
                                                DisplayMemberBinding="{Binding Category}"
                                                Header="Category" />
                                <GridViewColumn Width="180"
                                                DisplayMemberBinding="{Binding Keywords}"
                                                Header="What it is about" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="ReadExample"
                                     Description="The same list to read rather than to pick from. The non selectable item style takes the hover and the selection off, so the rows stay quiet under the pointer."
                                     Header="A list that is only read">
                <smtx:XamlDisplay UniqueKey="ListView.NonSelectable">
                    <ListView x:Name="Reading"
                              Width="280"
                              Height="150"
                              HorizontalAlignment="Left"
                              ItemContainerStyle="{StaticResource MahApps.Styles.ListViewItem.NonSelectable}">
                        <ListViewItem Content="Ada Lovelace" />
                        <ListViewItem Content="Grace Hopper" />
                        <ListViewItem Content="Alan Turing" />
                    </ListView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
