<UserControl x:Class="MahApps.Metro.Gallery.Pages.ListViewPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:core="clr-namespace:MahApps.Metro.Gallery.Core"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <UserControl.Resources>
        <!--  one view each, since two lists sharing a view also share which row is the current one  -->
        <CollectionViewSource x:Key="Win10People" Source="{x:Static core:SamplePeople.All}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Initial" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="WinUIPeople" Source="{x:Static core:SamplePeople.All}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Initial" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>
    </UserControl.Resources>

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="ColumnsExample"
                                     Description="A list view with a GridView in it, which is the one WPF gives you columns with. The column headers get their own style, and the rows are the pages of this gallery so the sample carries no data of its own. Turn SelectionMode to Multiple and every row shows a box saying whether it is picked, the same box the two Windows sets show, and the headers move along by as much as it takes so every column keeps its own name over it."
                                     Header="A list with columns">
                <smtx:XamlDisplay UniqueKey="ListView.Columns">
                    <ListView x:Name="Columns"
                              Width="520"
                              Height="200"
                              HorizontalAlignment="Left"
                              mah:ItemHelper.IsMultiSelectCheckBoxEnabled="True"
                              ItemsSource="{x:Static core:GalleryPages.All}"
                              SelectionMode="Multiple">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="200"
                                                DisplayMemberBinding="{Binding Title}"
                                                Header="Page" />
                                <GridViewColumn Width="120"
                                                DisplayMemberBinding="{Binding Category}"
                                                Header="Category" />
                                <GridViewColumn Width="180"
                                                DisplayMemberBinding="{Binding Keywords}"
                                                Header="What it is about" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="Win10ColumnsExample"
                                     Description="The same columns in the Windows 10 look. The header row carries no fill of its own, a line runs under it the whole way across, and the name of a column is written the way it was given rather than shouted in capitals, which is what the Metro header does and Windows does not. A header answers the pointer the way a row does, and it stands as tall as one."
                                     Header="Columns in the Windows 10 look">
                <smtx:XamlDisplay UniqueKey="ListView.Win10.Columns">
                    <ListView x:Name="Win10Columns"
                              Width="420"
                              Height="200"
                              HorizontalAlignment="Left"
                              mah:ItemHelper.IsMultiSelectCheckBoxEnabled="True"
                              ItemsSource="{x:Static core:SamplePeople.All}"
                              SelectionMode="Multiple"
                              Style="{DynamicResource MahApps.Styles.ListView.Win10}">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource MahApps.Styles.GridViewColumnHeader.Win10}">
                                <GridViewColumn Width="180"
                                                DisplayMemberBinding="{Binding Name}"
                                                Header="Name" />
                                <GridViewColumn Width="200"
                                                DisplayMemberBinding="{Binding Company}"
                                                Header="Where they worked" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="WinUIColumnsExample"
                                     Description="And in the WinUI look, which is the same header with the room and the colours of that set. A box beside every row moves the cells along, so the headers over them move by the same amount and stay where they belong. The header the row of them ends with stands for no column of its own, so it carries the line and nothing else: no handle for pulling a column wider, which would only show as a stray line at the right edge."
                                     Header="Columns in the WinUI look">
                <smtx:XamlDisplay UniqueKey="ListView.WinUI.Columns">
                    <ListView x:Name="WinUIColumns"
                              Width="420"
                              Height="200"
                              HorizontalAlignment="Left"
                              mah:ItemHelper.IsMultiSelectCheckBoxEnabled="True"
                              ItemsSource="{x:Static core:SamplePeople.All}"
                              SelectionMode="Multiple"
                              Style="{DynamicResource MahApps.Styles.ListView.WinUI}">
                        <ListView.View>
                            <GridView ColumnHeaderContainerStyle="{StaticResource MahApps.Styles.GridViewColumnHeader.WinUI}">
                                <GridViewColumn Width="180"
                                                DisplayMemberBinding="{Binding Name}"
                                                Header="Name" />
                                <GridViewColumn Width="200"
                                                DisplayMemberBinding="{Binding Company}"
                                                Header="Where they worked" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="Win10Example"
                                     Description="The list in the Windows 10 look: a neutral a step off the page rather than the page itself, rows taller than the Metro ones and square, and the accent turned right down behind the row that is picked rather than the accent itself, which keeps the text on it readable without a colour of its own. Turn SelectionMode to Multiple and every row shows a box saying whether it is picked, the way Windows does. The box only says so; it is still the row under it that answers the pointer."
                                     Header="The Windows 10 look">
                <smtx:XamlDisplay UniqueKey="ListView.Win10">
                    <ListView x:Name="Win10"
                              Width="280"
                              Height="180"
                              HorizontalAlignment="Left"
                              mah:ItemHelper.IsMultiSelectCheckBoxEnabled="True"
                              SelectionMode="Multiple"
                              Style="{DynamicResource MahApps.Styles.ListView.Win10}">
                        <ListViewItem Content="Ada Lovelace" />
                        <ListViewItem Content="Grace Hopper" IsSelected="True" />
                        <ListViewItem Content="Alan Turing" />
                        <ListViewItem Content="Edsger Dijkstra" IsEnabled="False" />
                        <ListViewItem Content="Barbara Liskov" />
                    </ListView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="WinUIExample"
                                     Description="And the WinUI one, which is the row every Windows 11 list is drawn with: a rounded tile filled a shade off the ground, the same fill whether the row is picked or only under the pointer, the text the same colour throughout, and the accent kept for the short bar along the left edge. That bar gives way to the box once more than one row can be picked, since the two say the same thing. Both of these also scroll by the pixel rather than by the row, the way Windows does."
                                     Header="The WinUI look">
                <smtx:XamlDisplay UniqueKey="ListView.WinUI">
                    <ListView x:Name="WinUI"
                              Width="280"
                              Height="180"
                              HorizontalAlignment="Left"
                              mah:ItemHelper.IsMultiSelectCheckBoxEnabled="True"
                              SelectionMode="Multiple"
                              Style="{DynamicResource MahApps.Styles.ListView.WinUI}">
                        <ListViewItem Content="Ada Lovelace" />
                        <ListViewItem Content="Grace Hopper" IsSelected="True" />
                        <ListViewItem Content="Alan Turing" />
                        <ListViewItem Content="Edsger Dijkstra" IsEnabled="False" />
                        <ListViewItem Content="Barbara Liskov" />
                    </ListView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="Win10GroupExample"
                                     Description="The same list in groups, by the letter the surname starts with. The grouping itself is a CollectionViewSource with a PropertyGroupDescription on it, and the header over each group comes with the set, so there is no GroupStyle to write here. IsHeaderSticky holds that header at the top while the rows of its group pass under it and lets the next group push it out of the way. The box in the header stands for the whole group: ticking it picks every row of the group, clearing it lets them all go, and it shows neither state while only some of them are picked. A list that brings a GroupStyle of its own keeps it."
                                     Header="The Windows 10 look, in groups">
                <smtx:XamlDisplay UniqueKey="ListView.Win10.Grouping">
                    <ListView x:Name="Win10Grouped"
                              Width="360"
                              Height="300"
                              HorizontalAlignment="Left"
                              mah:GroupItemHelper.CanSelectAllItems="True"
                              mah:GroupItemHelper.IsHeaderSticky="True"
                              mah:ItemHelper.IsMultiSelectCheckBoxEnabled="True"
                              ItemsSource="{Binding Source={StaticResource Win10People}}"
                              SelectionMode="Multiple"
                              Style="{DynamicResource MahApps.Styles.ListView.Win10}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="28"
                                             Height="28"
                                             Margin="0 0 12 0"
                                             Fill="{DynamicResource MahApps.Brushes.Gray7}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Opacity="0.75" Text="{Binding Company}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="WinUIGroupExample"
                                     Description="The WinUI set does the same, with the letter of the group written larger over a line and the rows given the room WinUI gives them. Each set brings the header that belongs to it, both are held at the top by the same property, and both can be let go of by turning it off."
                                     Header="The WinUI look, in groups">
                <smtx:XamlDisplay UniqueKey="ListView.WinUI.Grouping">
                    <ListView x:Name="WinUIGrouped"
                              Width="360"
                              Height="300"
                              HorizontalAlignment="Left"
                              mah:GroupItemHelper.CanSelectAllItems="True"
                              mah:GroupItemHelper.IsHeaderSticky="True"
                              mah:ItemHelper.IsMultiSelectCheckBoxEnabled="True"
                              ItemsSource="{Binding Source={StaticResource WinUIPeople}}"
                              SelectionMode="Multiple"
                              Style="{DynamicResource MahApps.Styles.ListView.WinUI}">
                        <ListView.ItemTemplate>
                            <DataTemplate>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="28"
                                             Height="28"
                                             Margin="0 0 12 0"
                                             Fill="{DynamicResource MahApps.Brushes.Gray7}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock FontWeight="SemiBold" Text="{Binding Name}" />
                                        <TextBlock Opacity="0.75" Text="{Binding Company}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="ReadExample"
                                     Description="The same list to read rather than to pick from. The non selectable item style takes the hover and the selection off, so the rows stay quiet under the pointer."
                                     Header="A list that is only read">
                <smtx:XamlDisplay UniqueKey="ListView.NonSelectable">
                    <ListView x:Name="Reading"
                              Width="280"
                              Height="150"
                              HorizontalAlignment="Left"
                              ItemContainerStyle="{StaticResource MahApps.Styles.ListViewItem.NonSelectable}">
                        <ListViewItem Content="Ada Lovelace" />
                        <ListViewItem Content="Grace Hopper" />
                        <ListViewItem Content="Alan Turing" />
                    </ListView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="LongExample"
                                     Description="Columns over a list long enough for virtualisation to matter. A list view virtualises anyway, so what this style brings is the recycling: VirtualizationMode goes from Standard to Recycling and a row that leaves the view is handed to the one arriving instead of being built from scratch, and IsVirtualizingWhenGrouping holds that once the rows are grouped. Unlike the list box, the base style of a list view sets none of this anywhere, so the key is the only way to it. The rows come from the code behind, 4200 files with a size each."
                                     Header="Columns over more rows than fit">
                <smtx:XamlDisplay UniqueKey="ListView.Virtualized">
                    <ListView x:Name="LongView"
                              Width="320"
                              Height="200"
                              HorizontalAlignment="Left"
                              Style="{StaticResource MahApps.Styles.ListView.Virtualized}">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Width="180"
                                                DisplayMemberBinding="{Binding Key}"
                                                Header="File" />
                                <GridViewColumn Width="100"
                                                DisplayMemberBinding="{Binding Value}"
                                                Header="Size" />
                            </GridView>
                        </ListView.View>
                    </ListView>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
