<UserControl x:Class="MahApps.Metro.Gallery.Pages.ToggleSwitchPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="SwitchExample"
                                     Description="A switch for something that takes effect at once, rather than a check box waiting for an OK. Header says what is being switched and IsOn says which way it stands."
                                     Header="On or off">
                <smtx:XamlDisplay UniqueKey="ToggleSwitch.IsOn">
                    <mah:ToggleSwitch x:Name="Switch"
                                      HorizontalAlignment="Left"
                                      Header="Show the ribbon"
                                      IsOn="True" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="ContentExample"
                                     Description="OnContent and OffContent are what the switch reads beside the knob, so it can say what each side means in its own words. ContentDirection puts the knob on the other end."
                                     Header="A switch that says which side it is on">
                <smtx:XamlDisplay UniqueKey="ToggleSwitch.Content">
                    <mah:ToggleSwitch x:Name="Sides"
                                      HorizontalAlignment="Left"
                                      Header="Notifications"
                                      OffContent="Silent"
                                      OnContent="Audible" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="Win10Example"
                                     Description="MahApps.Styles.ToggleSwitch.Win10 is the switch Windows 10 draws: a pill in outline while it is off and filled with the accent once it is on, with a 10 unit knob that is the theme foreground over the one and white over the other. The knob holds that size throughout, which is the whole of the difference to the card below. It is on develop and not in 2.4.11."
                                     Header="The one in the Windows 10 look">
                <smtx:XamlDisplay UniqueKey="ToggleSwitch.Win10">
                    <StackPanel HorizontalAlignment="Left">
                        <mah:ToggleSwitch x:Name="Win10"
                                          Header="Show the ribbon"
                                          IsOn="True"
                                          Style="{DynamicResource MahApps.Styles.ToggleSwitch.Win10}" />
                        <mah:ToggleSwitch Margin="0 8 0 0"
                                          OffContent="Silent"
                                          OnContent="Audible"
                                          Style="{DynamicResource MahApps.Styles.ToggleSwitch.Win10}" />
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="WinUIExample"
                                     Description="MahApps.Styles.ToggleSwitch.WinUI is the switch Windows 11 draws, built the same way as the one above and differing only in the knob: a 12 unit circle rather than a 10 unit one, which grows to 14 under the pointer and stretches into a pill towards the middle of the track while the button is held. It is on develop and not in 2.4.11."
                                     Header="The one in the WinUI look">
                <smtx:XamlDisplay UniqueKey="ToggleSwitch.WinUI">
                    <StackPanel HorizontalAlignment="Left">
                        <mah:ToggleSwitch x:Name="WinUI"
                                          Header="Show the ribbon"
                                          IsOn="True"
                                          Style="{DynamicResource MahApps.Styles.ToggleSwitch.WinUI}" />
                        <mah:ToggleSwitch Margin="0 8 0 0"
                                          OffContent="Silent"
                                          OnContent="Audible"
                                          Style="{DynamicResource MahApps.Styles.ToggleSwitch.WinUI}" />
                    </StackPanel>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
