<UserControl x:Class="MahApps.Metro.Gallery.Pages.GridSplitterPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="ColumnsExample"
                                     Description="The bar between two columns. Pull it and the panes change size, and since the style asks for a preview the panes follow on release rather than during the drag. Give it a Width, because the style stretches both alignments and WPF then decides what to resize from the rendered size."
                                     Header="Between two columns">
                <smtx:XamlDisplay UniqueKey="GridSplitter.Columns">
                    <Grid Width="520"
                          Height="160"
                          HorizontalAlignment="Left">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{DynamicResource MahApps.Brushes.Gray10}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{DynamicResource MahApps.Styles.TextBlock}"
                                       Text="Left" />
                        </Border>
                        <GridSplitter x:Name="Columns"
                                      Grid.Column="1"
                                      Width="6" />
                        <Border Grid.Column="2" Background="{DynamicResource MahApps.Brushes.Gray10}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{DynamicResource MahApps.Styles.TextBlock}"
                                       Text="Right" />
                        </Border>
                    </Grid>
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="RowsExample"
                                     Description="The same bar between two rows, where it is a Height rather than a Width that says so. ResizeDirection settles it outright for whoever would rather not rely on the size."
                                     Header="Between two rows">
                <smtx:XamlDisplay UniqueKey="GridSplitter.Rows">
                    <Grid Width="520"
                          Height="200"
                          HorizontalAlignment="Left">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border Background="{DynamicResource MahApps.Brushes.Gray10}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{DynamicResource MahApps.Styles.TextBlock}"
                                       Text="Above" />
                        </Border>
                        <GridSplitter x:Name="Rows"
                                      Grid.Row="1"
                                      Height="6"
                                      ResizeDirection="Rows" />
                        <Border Grid.Row="2" Background="{DynamicResource MahApps.Brushes.Gray10}">
                            <TextBlock HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Style="{DynamicResource MahApps.Styles.TextBlock}"
                                       Text="Below" />
                        </Border>
                    </Grid>
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
