<UserControl x:Class="MahApps.Metro.Gallery.Pages.DatePickerPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:MahApps.Metro.Gallery.Controls"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
             d:DesignHeight="600"
             d:DesignWidth="900"
             mc:Ignorable="d">

    <ScrollViewer Padding="24 8 24 24" VerticalScrollBarVisibility="Auto">
        <StackPanel>

            <controls:ControlExample x:Name="PickExample"
                                     Description="A date picker is three controls at once: the picker, the text box inside it and the calendar in the drop down, each with a style of its own. Along with the look the style sets three habits worth knowing about, the short date format, today highlighted, and the calendar it drops out."
                                     Header="A date out of a calendar">
                <smtx:XamlDisplay UniqueKey="DatePicker.Pick">
                    <DatePicker x:Name="Pick"
                                Width="280"
                                HorizontalAlignment="Left"
                                mah:TextBoxHelper.ClearTextButton="True"
                                mah:TextBoxHelper.Watermark="When it is due" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="Win10Example"
                                     Description="The picker in the Windows 10 look, which is the text box of that set with a calendar behind the button: the same fill, the same two-unit frame and the accent around it once the caret is in. The drop down is the calendar of that set as well, square cells and all."
                                     Header="The Windows 10 look">
                <smtx:XamlDisplay UniqueKey="DatePicker.Win10">
                    <DatePicker x:Name="Win10"
                                Width="280"
                                HorizontalAlignment="Left"
                                mah:TextBoxHelper.ClearTextButton="True"
                                Style="{DynamicResource MahApps.Styles.DatePicker.Win10}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

            <controls:ControlExample x:Name="WinUIExample"
                                     Description="And the WinUI one: the translucent fill, rounded corners, a border that is a touch stronger along its bottom edge and turns into the accent there while the caret is in, and round day cells in the drop down. That edge is a border of its own, two units thick either way, so the picker stays as tall as it was and nothing under it moves."
                                     Header="The WinUI look">
                <smtx:XamlDisplay UniqueKey="DatePicker.WinUI">
                    <DatePicker x:Name="WinUI"
                                Width="280"
                                HorizontalAlignment="Left"
                                mah:TextBoxHelper.ClearTextButton="True"
                                Style="{DynamicResource MahApps.Styles.DatePicker.WinUI}" />
                </smtx:XamlDisplay>
            </controls:ControlExample>

        </StackPanel>
    </ScrollViewer>
</UserControl>
