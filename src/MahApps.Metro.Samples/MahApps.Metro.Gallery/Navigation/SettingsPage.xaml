<Page x:Class="MahApps.Metro.Gallery.Navigation.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="Settings"
      d:DesignHeight="300"
      d:DesignWidth="600"
      Style="{DynamicResource MahApps.Styles.Page}"
      mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock FontSize="{DynamicResource MahApps.Font.Size.SubHeader}"
                       Text="Nothing to set here"
                       TextWrapping="Wrap" />
            <TextBlock Margin="0 12 0 0"
                       Style="{DynamicResource MahApps.Styles.TextBlock}"
                       TextWrapping="Wrap">
                <Run Text="This page hangs on an option at the foot of the pane rather than on an item in the list above, and the two let go of each other: the row that was lit up there went out when you came here. Step back and it swaps round again, which is the part worth testing when you build this yourself." />
                <LineBreak />
                <LineBreak />
                <Run Text="Everything else on this page is " /><Hyperlink NavigateUri="ReleasePage.xaml">a release</Hyperlink><Run Text=" away." />
            </TextBlock>
        </StackPanel>
    </ScrollViewer>
</Page>
