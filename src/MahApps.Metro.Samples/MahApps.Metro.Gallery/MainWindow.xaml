<mah:MetroWindow x:Class="MahApps.Metro.Gallery.MainWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:controlzex="urn:controlzex"
                 xmlns:core="clr-namespace:MahApps.Metro.Gallery.Core"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 Title="MahApps.Metro Gallery"
                 Width="1200"
                 Height="800"
                 MinWidth="800"
                 MinHeight="500"
                 controlzex:WindowBackdropManager.BackdropType="Mica"
                 Icon="mahapps.metro.logo2.ico"
                 ResizeMode="CanResizeWithGrip"
                 Style="{DynamicResource MahApps.Styles.MetroWindow.WinUI}"
                 WindowStartupLocation="CenterScreen"
                 mc:Ignorable="d">

    <mah:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibility" />

        <!--  the menu hands out the container style a row of its pane wears, and the submenus ask it for the same one  -->
        <mah:HamburgerMenuItemStyleSelector x:Key="MenuItemStyleSelector" />

        <!--  one row of the pane: the icon in the column the compact pane keeps free, and the label beside it  -->
        <DataTemplate x:Key="MenuRow" DataType="{x:Type mah:HamburgerMenuIconItem}">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type mah:HamburgerMenu}}, Path=CompactPaneLength}" />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <ContentControl Grid.Column="0"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Content="{Binding Icon}"
                                Focusable="False"
                                IsTabStop="False" />
                <TextBlock Grid.Column="1"
                           VerticalAlignment="Center"
                           FontSize="14"
                           Text="{Binding Label}" />
            </Grid>
        </DataTemplate>
    </mah:MetroWindow.Resources>

    <!--  where a page hangs the flyouts it wants to show, since a flyout belongs to the window  -->
    <mah:MetroWindow.Flyouts>
        <mah:FlyoutsControl />
    </mah:MetroWindow.Flyouts>

    <DockPanel>

        <!--
            The strip at the bottom says where the reader is. It is the library's own StatusBar, which
            reaches up to the window for its background and comes out in the title colour, so the
            gallery shows that control off by wearing it rather than by talking about it.
        -->
        <StatusBar DataContext="{Binding ElementName=Menu, Path=Content}" DockPanel.Dock="Bottom">
            <StatusBar.Resources>
                <core:PagePositionConverter x:Key="PagePosition" />

                <!--  a status bar hands every separator a reference to this key, which beats an implicit style, so the style has to sit under it  -->
                <Style x:Key="{x:Static StatusBar.SeparatorStyleKey}"
                       BasedOn="{StaticResource MahApps.Styles.Separator.StatusBar}"
                       TargetType="{x:Type Separator}" />
            </StatusBar.Resources>

            <StatusBar.ItemsPanel>
                <ItemsPanelTemplate>
                    <!--  a status bar lays its items out in a DockPanel and lets the last of them have whatever is left, so the one docked to the right would stretch across the bar rather than sit at its end  -->
                    <DockPanel LastChildFill="False" />
                </ItemsPanelTemplate>
            </StatusBar.ItemsPanel>

            <StatusBarItem>
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconMaterial Width="14"
                                                Height="14"
                                                VerticalAlignment="Center"
                                                Kind="{Binding Icon}" />
                    <TextBlock Margin="10 0 0 0"
                               VerticalAlignment="Center"
                               Opacity="0.75"
                               Text="{Binding Category}" />
                    <iconPacks:PackIconMaterial Width="9"
                                                Height="9"
                                                Margin="8 1 8 0"
                                                VerticalAlignment="Center"
                                                Kind="ChevronRight"
                                                Opacity="0.6" />
                    <TextBlock VerticalAlignment="Center"
                               FontWeight="SemiBold"
                               Text="{Binding Title}" />
                </StackPanel>
            </StatusBarItem>

            <Separator>
                <Separator.Style>
                    <!--  the settings page carries no keywords, and a separator in front of nothing is a line in the middle of the bar  -->
                    <Style BasedOn="{StaticResource MahApps.Styles.Separator.StatusBar}" TargetType="{x:Type Separator}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Keywords}" Value="{x:Null}">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Separator.Style>
            </Separator>

            <StatusBarItem>
                <TextBlock Style="{StaticResource MahApps.Styles.TextBlock.AutoCollapsing}" Text="{Binding Keywords}" />
            </StatusBarItem>

            <StatusBarItem Margin="0 0 18 0" DockPanel.Dock="Right">
                <TextBlock Style="{StaticResource MahApps.Styles.TextBlock.AutoCollapsing}" Text="{Binding Converter={StaticResource PagePosition}}" />
            </StatusBarItem>
        </StatusBar>

        <mah:HamburgerMenu x:Name="Menu"
                           CompactPaneLength="48"
                           DisplayMode="CompactInline"
                           IsPaneOpen="True"
                           ItemInvoked="OnItemInvoked"
                           OpenPaneLength="260"
                           ShowSelectionIndicator="True">

            <!--  the search, which is a job for the control this gallery is showing off two pages later  -->
            <mah:HamburgerMenu.HamburgerMenuHeaderTemplate>
                <DataTemplate>
                    <mah:AutoSuggestBox x:Name="Search"
                                        Margin="12 8 12 12"
                                        mah:TextBoxHelper.ClearTextButton="True"
                                        mah:TextBoxHelper.Watermark="Search"
                                        DisplayMemberPath="Title"
                                        QuerySubmitted="OnSearchQuerySubmitted"
                                        TextChanged="OnSearchTextChanged" />
                </DataTemplate>
            </mah:HamburgerMenu.HamburgerMenuHeaderTemplate>

            <!--
                A category is a row that holds pages rather than being one, so it comes out as an
                expander with a menu of its own under it. That menu is a HamburgerMenuListBox like
                the one the pane itself uses, and it asks the menu above for the container style, so
                a page in a submenu looks and answers the pointer like any other row.
            -->
            <mah:HamburgerMenu.ItemTemplate>
                <DataTemplate DataType="{x:Type core:GalleryCategoryItem}">
                    <Expander x:Name="Card"
                              Margin="0 2"
                              Padding="12 0 0 6"
                              mah:HeaderedControlHelper.HeaderMargin="0"
                              Collapsed="OnCategoryToggled"
                              Expanded="OnCategoryToggled"
                              IsExpanded="{Binding IsExpanded, Mode=TwoWay}"
                              Style="{StaticResource MahApps.Styles.Expander.WinUI}">
                        <Expander.Header>
                            <Grid Height="44">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="{Binding RelativeSource={RelativeSource AncestorType={x:Type mah:HamburgerMenu}}, Path=CompactPaneLength}" />
                                    <ColumnDefinition />
                                </Grid.ColumnDefinitions>
                                <ContentControl Grid.Column="0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Content="{Binding Icon}"
                                                Focusable="False"
                                                IsTabStop="False" />
                                <TextBlock Grid.Column="1"
                                           VerticalAlignment="Center"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Text="{Binding Label}" />
                            </Grid>
                        </Expander.Header>

                        <mah:HamburgerMenuListBox ItemContainerStyleSelector="{StaticResource MenuItemStyleSelector}"
                                                  ItemTemplate="{StaticResource MenuRow}"
                                                  ItemsSource="{Binding Pages}"
                                                  Loaded="OnSubMenuLoaded"
                                                  PreviewMouseWheel="OnSubMenuMouseWheel"
                                                  SelectionChanged="OnSubMenuSelectionChanged"
                                                  SelectionMode="Single"
                                                  Visibility="{Binding RelativeSource={RelativeSource AncestorType={x:Type mah:HamburgerMenu}}, Path=IsPaneOpen, Converter={StaticResource BooleanToVisibility}}" />
                    </Expander>
                    <DataTemplate.Triggers>
                        <!--  a closed pane is 48 pixels wide, which is no place for a card, so what is left of it there is the icon  -->
                        <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType={x:Type mah:HamburgerMenu}}, Path=IsPaneOpen}" Value="False">
                            <Setter TargetName="Card" Property="Background" Value="Transparent" />
                            <Setter TargetName="Card" Property="BorderThickness" Value="0" />
                            <Setter TargetName="Card" Property="mah:HeaderedControlHelper.HeaderBackground" Value="Transparent" />
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </mah:HamburgerMenu.ItemTemplate>

            <mah:HamburgerMenu.OptionsItemTemplate>
                <StaticResource ResourceKey="MenuRow" />
            </mah:HamburgerMenu.OptionsItemTemplate>

            <!--
                The page itself, with the heading and the two links above it. They sit here rather than on
                every card, because they belong to the control and not to one sample of it.
            -->
            <mah:HamburgerMenu.ContentTemplate>
                <DataTemplate DataType="{x:Type core:GalleryPage}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <DockPanel Grid.Row="0" Margin="24 20 20 4">
                            <DockPanel.Style>
                                <Style TargetType="{x:Type DockPanel}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasOwnHeading}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </DockPanel.Style>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button Command="{x:Static core:GalleryCommands.OpenLink}"
                                        CommandParameter="{Binding Documentation}"
                                        Style="{StaticResource MahApps.Gallery.Styles.Button.CardLink}"
                                        ToolTip="Read the documentation on mahapps.com">
                                    <iconPacks:PackIconMaterial Width="16"
                                                                Height="16"
                                                                Kind="BookOpenPageVariantOutline" />
                                </Button>
                                <Button Command="{x:Static core:GalleryCommands.OpenLink}"
                                        CommandParameter="{Binding ControlSource}"
                                        Style="{StaticResource MahApps.Gallery.Styles.Button.CardLink}"
                                        ToolTip="See the control itself on GitHub">
                                    <iconPacks:PackIconMaterial Width="16"
                                                                Height="16"
                                                                Kind="CodeBraces" />
                                </Button>
                                <Button Command="{x:Static core:GalleryCommands.OpenLink}"
                                        CommandParameter="{Binding PageSource}"
                                        Style="{StaticResource MahApps.Gallery.Styles.Button.CardLink}"
                                        ToolTip="See the XAML of this page on GitHub">
                                    <iconPacks:PackIconMaterial Width="16"
                                                                Height="16"
                                                                Kind="CodeTags" />
                                </Button>
                            </StackPanel>

                            <TextBlock VerticalAlignment="Center"
                                       FontSize="26"
                                       Foreground="{DynamicResource MahApps.Brushes.ThemeForeground}"
                                       Text="{Binding Title}" />
                        </DockPanel>

                        <ContentControl Grid.Row="1"
                                        Content="{Binding View}"
                                        Focusable="False"
                                        IsTabStop="False" />
                    </Grid>
                </DataTemplate>
            </mah:HamburgerMenu.ContentTemplate>
        </mah:HamburgerMenu>
    </DockPanel>
</mah:MetroWindow>
