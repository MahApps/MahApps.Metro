<Page x:Class="MahApps.Metro.Gallery.Windows.NavigationSampleSecondPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="And where it goes"
      d:DesignHeight="300"
      d:DesignWidth="600"
      mc:Ignorable="d">

    <StackPanel Margin="24">
        <TextBlock Style="{DynamicResource MahApps.Styles.TextBlock}"
                   Text="The title in the bar has changed with the page, the back button is live and the forward one waits for a step back. Both buttons are the window's, and the same journal is behind GoBack and GoForward on it."
                   TextWrapping="Wrap" />
        <Button Margin="0 16 0 0"
                HorizontalAlignment="Left"
                Click="OnBack"
                Content="Back, from here rather than from the bar" />
    </StackPanel>
</Page>
