<mah:MetroWindow x:Class="MahApps.Metro.Gallery.Windows.BackdropWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:controlzex="urn:controlzex"
                 xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                 xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                 xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                 xmlns:system="clr-namespace:System;assembly=mscorlib"
                 Title="A window with a material behind it"
                 Width="740"
                 Height="520"
                 Icon="../mahapps.metro.logo2.ico"
                 ShowIconOnTitleBar="True"
                 TitleCharacterCasing="Normal"
                 WindowStartupLocation="CenterOwner"
                 mc:Ignorable="d">

    <mah:MetroWindow.Resources>
        <ObjectDataProvider x:Key="BackdropTypes"
                            MethodName="GetValues"
                            ObjectType="{x:Type system:Enum}">
            <ObjectDataProvider.MethodParameters>
                <x:Type TypeName="controlzex:WindowBackdropType" />
            </ObjectDataProvider.MethodParameters>
        </ObjectDataProvider>

        <!--  the same colour as the line above it, with a quarter of it taken away, and taken away in the brush  -->
        <SolidColorBrush x:Key="Quiet" Opacity="0.75" Color="{DynamicResource MahApps.Colors.ThemeForeground}" />
    </mah:MetroWindow.Resources>

    <DockPanel Margin="20">

        <!--  a window asks for its material itself, with the attached property of ControlzEx  -->
        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
            <TextBlock VerticalAlignment="Center" Text="Backdrop" />
            <ComboBox Width="160"
                      Margin="8 0 0 0"
                      ItemsSource="{Binding Source={StaticResource BackdropTypes}}"
                      SelectedItem="{Binding Path=(controlzex:WindowBackdropManager.BackdropType), RelativeSource={RelativeSource AncestorType={x:Type mah:MetroWindow}}, Mode=TwoWay}" />
        </StackPanel>

        <TextBlock Margin="0 14 0 0"
                   DockPanel.Dock="Top"
                   Text="A material shows through the window, and WPF draws no ClearType onto anything see through. A MetroWindow gives its content a fill of its own and says that the sub pixel rendering is back on, and that word reaches everything under it, so the first two lines read the same whichever material is picked. The third one does not: an opacity on the text itself puts that text on a layer, and a layer starts over. Put the same quarter into the brush instead and it is a drawing again."
                   TextWrapping="Wrap" />

        <StackPanel VerticalAlignment="Top">

            <TextBlock Margin="0 24 0 0"
                       FontSize="16"
                       Text="Forty two lines of text, as it comes" />

            <Button Margin="0 12 0 0"
                    HorizontalAlignment="Left"
                    Content="Forty two lines of text, in a button" />

            <TextBlock Margin="0 20 0 0"
                       FontSize="16"
                       Opacity="0.75"
                       Text="Forty two lines of text, with an opacity of its own" />

            <TextBlock Margin="0 12 0 0"
                       FontSize="16"
                       Foreground="{StaticResource Quiet}"
                       Text="Forty two lines of text, with that quarter in the brush" />

        </StackPanel>
    </DockPanel>
</mah:MetroWindow>
