<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:avalonEdit="http://icsharpcode.net/sharpdevelop/avalonedit"
                    xmlns:core="clr-namespace:MetroDemo.Core"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:smtx="clr-namespace:ShowMeTheXAML;assembly=ShowMeTheXAML"
                    xmlns:smtxAvalonEdit="clr-namespace:ShowMeTheXAML.AvalonEdit;assembly=ShowMeTheXAML.AvalonEdit">

    <!--
        Every XamlDisplay in this demo shows its content and, below it, the XAML that content is
        written as. The markup itself is put into the assembly at build time by ShowMeTheXAML.MSBuild
        and looked up by the UniqueKey, so all a sample has to do is wrap what it wants to show.
    -->

    <smtxAvalonEdit:TextDocumentValueConverter x:Key="TextDocumentValueConverter" />

    <!--
        One attribute per line, as the XAML in this repository is written anyway. Left alone the
        formatter puts a whole element on one line, and a sample with a handful of attributes then
        needs the horizontal scroll bar to be read at all.
    -->
    <smtx:XamlFormatter x:Key="XamlFormatter" NewLineOnAttributes="True" />

    <Style x:Key="MahApps.Styles.TextEditor.XamlDisplay" TargetType="{x:Type avalonEdit:TextEditor}">
        <!--  Gray10 sits a shade away from the background of the window, which is what marks the block out as code  -->
        <Setter Property="Background" Value="{DynamicResource MahApps.Brushes.Gray10}" />
        <Setter Property="FontFamily" Value="Consolas, Courier New, monospace" />
        <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.ThemeForeground}" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="IsReadOnly" Value="True" />
        <!--  a namespace looks like a link, and AvalonEdit would underline every one of them  -->
        <Setter Property="Options">
            <Setter.Value>
                <avalonEdit:TextEditorOptions EnableEmailHyperlinks="False" EnableHyperlinks="False" />
            </Setter.Value>
        </Setter>
        <Setter Property="Padding" Value="8 8 40 8" />
        <Setter Property="ShowLineNumbers" Value="False" />
        <!--  the colours follow the theme, which is what this one is for  -->
        <Setter Property="SyntaxHighlighting" Value="{Binding Definition, Source={x:Static core:XamlSyntaxHighlighting.Current}}" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <!--  wrapping beats a horizontal scroll bar under a sample nobody asked to scroll  -->
        <Setter Property="WordWrap" Value="True" />
    </Style>

    <Style x:Key="MahApps.Styles.Button.XamlDisplay.Copy"
           BasedOn="{StaticResource MahApps.Styles.Button.Chromeless}"
           TargetType="{x:Type Button}">
        <Setter Property="Height" Value="28" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Margin" Value="4" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ToolTip" Value="Copy the XAML to the clipboard" />
        <Setter Property="VerticalAlignment" Value="Top" />
        <Setter Property="Width" Value="28" />
    </Style>

    <Style TargetType="{x:Type smtx:XamlDisplay}">
        <Setter Property="Formatter" Value="{StaticResource XamlFormatter}" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type smtx:XamlDisplay}">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <ContentPresenter Grid.Row="0"
                                          Margin="{TemplateBinding Padding}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />

                        <Expander Grid.Row="1"
                                  Margin="0 4 0 0"
                                  Header="XAML"
                                  IsExpanded="False">
                            <Border BorderBrush="{DynamicResource MahApps.Brushes.Gray8}" BorderThickness="1">
                                <Grid>
                                    <avalonEdit:TextEditor MaxHeight="400"
                                                           Document="{Binding Xaml, RelativeSource={RelativeSource TemplatedParent}, Converter={StaticResource TextDocumentValueConverter}}"
                                                           Style="{StaticResource MahApps.Styles.TextEditor.XamlDisplay}" />
                                    <Button Command="{x:Static core:XamlDisplayCommands.CopyXaml}"
                                            CommandParameter="{Binding Xaml, RelativeSource={RelativeSource TemplatedParent}}"
                                            Style="{StaticResource MahApps.Styles.Button.XamlDisplay.Copy}">
                                        <iconPacks:PackIconMaterial Width="14"
                                                                    Height="14"
                                                                    Kind="ContentCopy" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Expander>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalContentAlignment" Value="Stretch" />
    </Style>

</ResourceDictionary>
