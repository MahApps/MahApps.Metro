<UserControl x:Class="MetroDemo.ExampleViews.OtherExamples"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:MetroDemo"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MetroDemo.Models"
             xmlns:mx="clr-namespace:MetroDemo.Markup"
             xmlns:vc="clr-namespace:MetroDemo.ValueConverter"
             d:DataContext="{d:DesignInstance local:MainWindowViewModel}"
             d:DesignHeight="600"
             d:DesignWidth="800"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>

            <DataTemplate x:Key="ImageDataTemplate" x:Shared="False">
                <Image Source="{Binding Mode=OneWay, FallbackValue={x:Static DependencyProperty.UnsetValue}, Converter={mah:NullToUnsetValueConverter}}" Stretch="Fill" />
            </DataTemplate>

            <!--  A FlipViewItem inside the item template is where an item out of a source names its own banner.  -->
            <DataTemplate x:Key="GalleryDataTemplate" DataType="{x:Type models:Photo}">
                <mah:FlipViewItem Background="#FF202020"
                                  BannerText="{Binding Title, Mode=OneWay}"
                                  BorderThickness="0">
                    <Grid>
                        <!--  Uniform, so a picture is shown whole rather than cropped to the frame, whatever shape it is  -->
                        <Image Source="{Binding Image, Mode=OneWay}" Stretch="Uniform" />
                        <!--  along the top, because the banner of the FlipView has the bottom  -->
                        <Border Padding="14 12 14 18" VerticalAlignment="Top">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#CC000000" />
                                    <GradientStop Offset="1" Color="#00000000" />
                                </LinearGradientBrush>
                            </Border.Background>
                            <TextBlock Foreground="White"
                                       Text="{Binding Caption, Mode=OneWay}"
                                       TextWrapping="Wrap" />
                        </Border>
                    </Grid>
                </mah:FlipViewItem>
            </DataTemplate>

        </ResourceDictionary>
    </UserControl.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" MaxWidth="500" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0" Margin="0 0 20 0">

            <Label Content="Context menu" Style="{DynamicResource DescriptionHeaderStyle}" />

            <TextBlock Margin="0 4 0 8"
                       Text="A ContextMenu takes the MahApps look from the implicit style, with the icon column, the input gesture column and the check mark the templates bring along. Both areas below carry the same menu and differ only in what is set on the ContextMenu itself."
                       TextWrapping="Wrap" />

            <Border Height="110"
                    Padding="8"
                    Background="{DynamicResource MahApps.Brushes.Gray10}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                    BorderThickness="1">
                <Border.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="Cut" InputGestureText="Ctrl+X">
                            <MenuItem.Icon>
                                <iconPacks:PackIconMaterial Kind="ContentCut" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C">
                            <MenuItem.Icon>
                                <iconPacks:PackIconMaterial Kind="ContentCopy" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Paste" InputGestureText="Ctrl+V">
                            <MenuItem.Icon>
                                <iconPacks:PackIconMaterial Kind="ContentPaste" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Show line numbers"
                                  IsCheckable="True"
                                  IsChecked="True" />
                        <MenuItem Header="Word wrap" IsCheckable="True" />
                        <Separator />
                        <MenuItem Header="Open with">
                            <MenuItem Header="Editor" />
                            <MenuItem Header="Browser" />
                            <Separator />
                            <MenuItem Header="Choose another app" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Delete"
                                  InputGestureText="Del"
                                  IsEnabled="False">
                            <MenuItem.Icon>
                                <iconPacks:PackIconMaterial Kind="DeleteOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Properties" InputGestureText="Alt+Enter" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Width="24"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                                Kind="CursorDefaultClickOutline" />
                    <TextBlock Margin="0 6 0 0"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               Text="Right click here" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               Text="square corners, drop shadow" />
                </StackPanel>
            </Border>

            <Border Height="110"
                    Margin="0 8 0 0"
                    Padding="8"
                    mah:ControlsHelper.CornerRadius="8"
                    Background="{DynamicResource MahApps.Brushes.Gray10}"
                    BorderBrush="{DynamicResource MahApps.Brushes.Gray7}"
                    BorderThickness="1">
                <Border.ContextMenu>
                    <ContextMenu mah:ControlsHelper.CornerRadius="8" HasDropShadow="False">
                        <MenuItem Header="Cut" InputGestureText="Ctrl+X">
                            <MenuItem.Icon>
                                <iconPacks:PackIconMaterial Kind="ContentCut" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Copy" InputGestureText="Ctrl+C">
                            <MenuItem.Icon>
                                <iconPacks:PackIconMaterial Kind="ContentCopy" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Paste" InputGestureText="Ctrl+V">
                            <MenuItem.Icon>
                                <iconPacks:PackIconMaterial Kind="ContentPaste" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Show line numbers"
                                  IsCheckable="True"
                                  IsChecked="True" />
                        <MenuItem Header="Word wrap" IsCheckable="True" />
                        <Separator />
                        <MenuItem Header="Open with">
                            <MenuItem Header="Editor" />
                            <MenuItem Header="Browser" />
                            <Separator />
                            <MenuItem Header="Choose another app" />
                        </MenuItem>
                        <Separator />
                        <MenuItem Header="Delete"
                                  InputGestureText="Del"
                                  IsEnabled="False">
                            <MenuItem.Icon>
                                <iconPacks:PackIconMaterial Kind="DeleteOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Header="Properties" InputGestureText="Alt+Enter" />
                    </ContextMenu>
                </Border.ContextMenu>
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <iconPacks:PackIconMaterial Width="24"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                                Kind="CursorDefaultClickOutline" />
                    <TextBlock Margin="0 6 0 0"
                               HorizontalAlignment="Center"
                               FontWeight="Bold"
                               Text="Right click here" />
                    <TextBlock HorizontalAlignment="Center"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               Text="mah:ControlsHelper.CornerRadius 8, no drop shadow" />
                </StackPanel>
            </Border>

            <TextBlock Margin="0 12 0 4"
                       Text="A TextBox brings its own menu from the MahApps.TextBox.ContextMenu resource."
                       TextWrapping="Wrap" />

            <TextBox mah:TextBoxHelper.Watermark="Right click for Cut, Copy and Paste" Text="Select a word in here and right click it" />

        </StackPanel>

        <StackPanel Grid.Column="1">
            <Label Content="FlipView" Style="{DynamicResource DescriptionHeaderStyle}" />

            <StackPanel Orientation="Horizontal">
                <CheckBox x:Name="ShowBannerCheckBox"
                          Margin="2"
                          Content="Show Banner"
                          IsChecked="{Binding ElementName=FlipView1st, Path=IsBannerEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox x:Name="ShowMouseOverCheckBox"
                          Margin="2"
                          Content="MouseOver Border"
                          IsChecked="{Binding ElementName=FlipView1st, Path=MouseHoverBorderEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox x:Name="CircularNaviCheckBox"
                          Margin="2"
                          Content="Circular Navi"
                          IsChecked="{Binding ElementName=FlipView1st, Path=CircularNavigation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox x:Name="ShowNaviCheckBox"
                          Margin="2"
                          Content="Show Navi Buttons"
                          IsChecked="{Binding ElementName=FlipView1st, Path=IsNavigationEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <CheckBox x:Name="ShowIndexCheckBox"
                          Margin="2"
                          Content="Show Navi Index"
                          IsChecked="{Binding ElementName=FlipView1st, Path=ShowIndex, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </StackPanel>

            <Grid Grid.IsSharedSizeScope="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" SharedSizeGroup="FlipViewSettingsLabel" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Label Grid.Row="0"
                       Grid.Column="0"
                       Content="Navigation Button Orientation" />
                <ComboBox x:Name="Orientation"
                          Grid.Row="0"
                          Grid.Column="1"
                          Width="120"
                          Margin="2"
                          ItemsSource="{Binding Source={mx:EnumBindingSource {x:Type Orientation}}, Mode=OneTime}"
                          SelectedValue="{Binding ElementName=FlipView1st, Path=Orientation, FallbackValue={x:Static Orientation.Horizontal}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="1"
                       Grid.Column="0"
                       Content="Navigation Button Position" />
                <ComboBox x:Name="NaviButtonsPosition"
                          Grid.Row="1"
                          Grid.Column="1"
                          Width="120"
                          Margin="2"
                          ItemsSource="{Binding Source={mx:EnumBindingSource {x:Type mah:NavigationButtonsPosition}}, Mode=OneTime}"
                          SelectedValue="{Binding ElementName=FlipView1st, Path=NavigationButtonsPosition, FallbackValue={x:Static mah:NavigationButtonsPosition.Inside}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="2"
                       Grid.Column="0"
                       Content="Navigation Index Placement" />
                <ComboBox x:Name="IndexPlacement"
                          Grid.Row="2"
                          Grid.Column="1"
                          Width="120"
                          Margin="2"
                          ItemsSource="{Binding Source={mx:EnumBindingSource {x:Type mah:NavigationIndexPlacement}}, Mode=OneTime}"
                          SelectedValue="{Binding ElementName=FlipView1st, Path=IndexPlacement, FallbackValue={x:Static mah:NavigationIndexPlacement.Bottom}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <Label Grid.Row="3"
                       Grid.Column="0"
                       Content="Navigation Index Horizontal Alignment" />
                <ComboBox x:Name="IndexHorizontalAlignment"
                          Grid.Row="3"
                          Grid.Column="1"
                          Width="120"
                          Margin="2"
                          ItemsSource="{Binding Source={mx:EnumBindingSource {x:Type HorizontalAlignment}}, Mode=OneTime}"
                          SelectedValue="{Binding ElementName=FlipView1st, Path=IndexHorizontalAlignment, FallbackValue={x:Static HorizontalAlignment.Center}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Only used when the index sits on the top or the bottom side" />

                <Label Grid.Row="4"
                       Grid.Column="0"
                       Content="Navigation Index Vertical Alignment" />
                <ComboBox x:Name="IndexVerticalAlignment"
                          Grid.Row="4"
                          Grid.Column="1"
                          Width="120"
                          Margin="2"
                          ItemsSource="{Binding Source={mx:EnumBindingSource {x:Type VerticalAlignment}}, Mode=OneTime}"
                          SelectedValue="{Binding ElementName=FlipView1st, Path=IndexVerticalAlignment, FallbackValue={x:Static VerticalAlignment.Center}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Only used when the index sits on the left or the right side" />

                <Label Grid.Row="5"
                       Grid.Column="0"
                       Content="Left Transition" />
                <ComboBox x:Name="LeftTransition"
                          Grid.Row="5"
                          Grid.Column="1"
                          Width="120"
                          Margin="2"
                          ItemsSource="{Binding Source={mx:EnumBindingSource {x:Type mah:TransitionType}}, Mode=OneTime}"
                          SelectedValue="{Binding ElementName=FlipView1st, Path=LeftTransition, FallbackValue={x:Static mah:TransitionType.LeftReplace}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Used when moving forward while the orientation is horizontal" />

                <Label Grid.Row="6"
                       Grid.Column="0"
                       Content="Right Transition" />
                <ComboBox x:Name="RightTransition"
                          Grid.Row="6"
                          Grid.Column="1"
                          Width="120"
                          Margin="2"
                          ItemsSource="{Binding Source={mx:EnumBindingSource {x:Type mah:TransitionType}}, Mode=OneTime}"
                          SelectedValue="{Binding ElementName=FlipView1st, Path=RightTransition, FallbackValue={x:Static mah:TransitionType.RightReplace}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Used when moving back while the orientation is horizontal" />

                <Label Grid.Row="7"
                       Grid.Column="0"
                       Content="Down Transition" />
                <ComboBox x:Name="DownTransition"
                          Grid.Row="7"
                          Grid.Column="1"
                          Width="120"
                          Margin="2"
                          ItemsSource="{Binding Source={mx:EnumBindingSource {x:Type mah:TransitionType}}, Mode=OneTime}"
                          SelectedValue="{Binding ElementName=FlipView1st, Path=DownTransition, FallbackValue={x:Static mah:TransitionType.Down}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Used when moving forward while the orientation is vertical" />

                <Label Grid.Row="8"
                       Grid.Column="0"
                       Content="Up Transition" />
                <ComboBox x:Name="UpTransition"
                          Grid.Row="8"
                          Grid.Column="1"
                          Width="120"
                          Margin="2"
                          ItemsSource="{Binding Source={mx:EnumBindingSource {x:Type mah:TransitionType}}, Mode=OneTime}"
                          SelectedValue="{Binding ElementName=FlipView1st, Path=UpTransition, FallbackValue={x:Static mah:TransitionType.Up}, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                          ToolTip="Used when moving back while the orientation is vertical" />
            </Grid>

            <mah:FlipView x:Name="FlipView1st"
                          Height="200"
                          MaxWidth="560"
                          Margin="0 0 5 0"
                          Foreground="{DynamicResource MahApps.Brushes.ThemeBackground}"
                          IndexPlacement="TopOverItem"
                          ShowIndex="True">
                <mah:FlipView.Items>
                    <mah:FlipViewItem Background="#2E8DEF"
                                      BannerText="Cupcakes!"
                                      BorderBrush="Black"
                                      BorderThickness="1">
                        <iconPacks:PackIconModern Width="60"
                                                  Height="60"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Kind="FoodCupcake" />
                    </mah:FlipViewItem>
                    <mah:FlipViewItem Background="#00A600" BannerText="XBox!">
                        <iconPacks:PackIconModern Width="60"
                                                  Height="60"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Kind="Xbox" />
                    </mah:FlipViewItem>
                    <mah:FlipViewItem Background="#BF1E4B" BannerText="Chess!">
                        <iconPacks:PackIconModern Width="60"
                                                  Height="60"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Kind="ChessHorse" />
                    </mah:FlipViewItem>
                </mah:FlipView.Items>
            </mah:FlipView>

            <StackPanel HorizontalAlignment="Center"
                        DataContext="{Binding ElementName=FlipView1st, Mode=OneWay}"
                        Orientation="Horizontal">
                <mah:NumericUpDown mah:TextBoxHelper.SelectAllOnFocus="True"
                                   ButtonsAlignment="Left"
                                   Interval="1"
                                   Maximum="{Binding Path=Items.Count, Mode=OneWay}"
                                   Minimum="1"
                                   Value="{Binding Path=SelectedIndex, Mode=TwoWay, Converter={vc:Int32IndexToNumberConverter}}" />
                <TextBlock Margin="8 0 0 0" VerticalAlignment="Center">
                    <Run Text="/" />
                    <Run Text="{Binding Path=Items.Count, Mode=OneWay}" />
                </TextBlock>
            </StackPanel>

            <Separator Margin="0 5" />

            <TextBlock Margin="0 4 0 8"
                       Text="The one above has its items written out one by one, each a FlipViewItem naming its own banner. The gallery below takes its items from a source instead, so the banner is named by a FlipViewItem inside the item template, and the line over the picture comes from the same object."
                       TextWrapping="Wrap" />

            <!--  the height follows the width, so the gallery keeps its shape as the window is resized  -->
            <mah:FlipView x:Name="FlipView2nd"
                          Height="{Binding RelativeSource={RelativeSource Self}, Path=ActualWidth, Converter={vc:AspectRatioConverter Ratio=0.75}}"
                          MaxWidth="560"
                          Margin="0 0 5 0"
                          IndexPlacement="BottomOverItem"
                          ItemTemplate="{StaticResource GalleryDataTemplate}"
                          ItemsSource="{Binding Gallery, Mode=OneWay}"
                          MouseHoverBorderEnabled="{Binding ElementName=ShowMouseOverCheckBox, Path=IsChecked, Mode=OneWay}"
                          Orientation="{Binding ElementName=Orientation, Path=SelectedValue, Mode=OneWay}"
                          ShowIndex="True" />
            <StackPanel HorizontalAlignment="Center"
                        DataContext="{Binding ElementName=FlipView2nd, Mode=OneWay}"
                        Orientation="Horizontal">
                <mah:NumericUpDown mah:TextBoxHelper.SelectAllOnFocus="True"
                                   ButtonsAlignment="Opposite"
                                   Interval="1"
                                   Maximum="{Binding Path=Items.Count, Mode=OneWay}"
                                   Minimum="1"
                                   SwitchUpDownButtons="True"
                                   Value="{Binding Path=SelectedIndex, Mode=TwoWay, Converter={vc:Int32IndexToNumberConverter}}" />
            </StackPanel>
        </StackPanel>
    </Grid>

</UserControl>