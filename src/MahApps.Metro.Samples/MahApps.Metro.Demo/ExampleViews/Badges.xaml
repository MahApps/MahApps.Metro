<UserControl x:Class="MetroDemo.ExampleViews.Badges"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:local="clr-namespace:MetroDemo"
             xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:MetroDemo.Models"
             d:DataContext="{d:DesignInstance local:MainWindowViewModel}"
             d:DesignHeight="900"
             d:DesignWidth="1000"
             mc:Ignorable="d">

    <UserControl.Resources>
        <ResourceDictionary>

            <Style BasedOn="{StaticResource MahApps.Styles.MetroHeader}" TargetType="{x:Type mah:MetroHeader}">
                <Setter Property="HeaderTemplate">
                    <Setter.Value>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" UseLayoutRounding="True">
                                <TextBlock Margin="0 4"
                                           FontSize="15"
                                           FontWeight="SemiBold"
                                           Text="{Binding}" />
                                <Separator Margin="0 0 0 6" />
                            </StackPanel>
                        </DataTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="Margin" Value="0 0 0 18" />
            </Style>

            <models:MailboxFolder x:Key="Inbox"
                                  Caption="Inbox"
                                  Count="9"
                                  Glyph="InboxArrowDown" />
            <models:MailboxFolder x:Key="Drafts"
                                  Caption="Drafts"
                                  Count="2"
                                  Glyph="FileDocumentEditOutline" />
            <models:MailboxFolder x:Key="Sent"
                                  Caption="Sent items"
                                  Count="17"
                                  Glyph="SendOutline" />
            <models:MailboxFolder x:Key="Archive"
                                  Caption="Archive"
                                  Count="128"
                                  Glyph="ArchiveOutline" />

            <!--
                The header of a mailbox tab. The border fills the whole header, which is what the
                stretched alignment on the tab gives it, and it carries a background of its own so
                that the hit test finds it anywhere on the tab rather than only over the letters.
            -->
            <DataTemplate x:Key="MailboxTabHeader" DataType="{x:Type models:MailboxFolder}">
                <Border x:Name="HeaderHighlight"
                        Padding="12 5"
                        Background="Transparent">
                    <!--
                        Stretched, so the badge is carried to the right hand end of the tab while the
                        glyph and the caption stay at the left. The padding on the border leaves the
                        badge somewhere to hang, since it stands half its own width outside.
                    -->
                    <mah:Badged HorizontalAlignment="Stretch"
                                VerticalAlignment="Center"
                                Badge="{Binding Count, Mode=OneWay}">
                        <StackPanel HorizontalAlignment="Left" Orientation="Horizontal">
                            <iconPacks:PackIconMaterial Width="14"
                                                        Height="14"
                                                        VerticalAlignment="Center"
                                                        Kind="{Binding Glyph, Mode=OneTime}" />
                            <TextBlock Text="{Binding Caption, Mode=OneTime}" />
                        </StackPanel>
                    </mah:Badged>
                </Border>
                <DataTemplate.Triggers>
                    <Trigger SourceName="HeaderHighlight" Property="IsMouseOver" Value="True">
                        <Setter TargetName="HeaderHighlight" Property="Background" Value="{DynamicResource MahApps.Brushes.Accent4}" />
                    </Trigger>
                </DataTemplate.Triggers>
            </DataTemplate>

            <!--  Colours of the page's own, far enough from the accent that a sample is plainly painted by hand.  -->
            <SolidColorBrush x:Key="Mandarin" Color="#E8710A" />
            <SolidColorBrush x:Key="Moss" Color="#3F8F5B" />
            <SolidColorBrush x:Key="Plum" Color="#8E44AD" />

            <Style x:Key="GroupCaption" TargetType="{x:Type TextBlock}">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource MahApps.Brushes.Gray3}" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Margin" Value="2 2 0 8" />
                <Setter Property="MaxWidth" Value="900" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--  Every sample sits in a card of its own that says what it shows.  -->
            <Style x:Key="BadgeCard" TargetType="{x:Type HeaderedContentControl}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Margin" Value="0 0 12 12" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type HeaderedContentControl}">
                            <Border Padding="12 8 12 14"
                                    Background="{DynamicResource MahApps.Brushes.Gray10}"
                                    BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                                    BorderThickness="1"
                                    CornerRadius="4">
                                <StackPanel>
                                    <TextBlock MinHeight="28"
                                               FontSize="11"
                                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                               Text="{TemplateBinding Header}"
                                               TextWrapping="Wrap" />
                                    <!--  room around the sample, because a badge hangs over the edge of what it is put on  -->
                                    <ContentPresenter Margin="14 16 14 6" HorizontalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Width" Value="168" />
            </Style>

            <Style x:Key="WideCard"
                   BasedOn="{StaticResource BadgeCard}"
                   TargetType="{x:Type HeaderedContentControl}">
                <Setter Property="Width" Value="330" />
            </Style>

            <!--
                The tabs of the mailbox: all of one width, and answering the mouse in colour. The
                hover is a trigger; the press is set from the code behind, because a tab has no
                IsPressed of its own and a storyboard cannot be frozen around a brush that follows
                the theme.
            -->
            <Style x:Key="MailboxTab"
                   BasedOn="{StaticResource MahApps.Styles.TabItem}"
                   TargetType="{x:Type TabItem}">
                <!--
                    the template of a TabControl hosts its headers in a TabPanel of its own, so a
                    panel handed to ItemsPanel is never asked; one width for every tab is
                -->
                <Setter Property="HeaderTemplate" Value="{StaticResource MailboxTabHeader}" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="Width" Value="132" />
                <!--  a header template takes the size the tab gives it, which is the big one by default  -->
                <Setter Property="mah:HeaderedControlHelper.HeaderFontSize" Value="13" />
                <!--  stretched, so the header fills the tab and answers the mouse everywhere on it  -->
                <Setter Property="mah:HeaderedControlHelper.HeaderHorizontalContentAlignment" Value="Stretch" />
                <Setter Property="mah:HeaderedControlHelper.HeaderVerticalContentAlignment" Value="Stretch" />
            </Style>

            <Style x:Key="Message" TargetType="{x:Type HeaderedContentControl}">
                <Setter Property="Focusable" Value="False" />
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type HeaderedContentControl}">
                            <Grid Margin="0 0 0 9">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="104" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock FontWeight="SemiBold"
                                           Text="{TemplateBinding Header}"
                                           TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="1"
                                           Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                                           Text="{TemplateBinding Content}"
                                           TextTrimming="CharacterEllipsis" />
                            </Grid>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--  An icon and a caption side by side, which is what a badge usually goes on in a tab.  -->
            <Style x:Key="TabCaption" TargetType="{x:Type StackPanel}">
                <Setter Property="Orientation" Value="Horizontal" />
            </Style>

            <Style x:Key="TabGlyph" TargetType="{x:Type iconPacks:PackIconMaterial}">
                <Setter Property="Height" Value="14" />
                <Setter Property="Margin" Value="0 0 7 0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="Width" Value="14" />
            </Style>

            <Style x:Key="SampleButton"
                   BasedOn="{StaticResource MahApps.Styles.Button}"
                   TargetType="{x:Type Button}">
                <Setter Property="Content" Value="Inbox" />
                <Setter Property="MinWidth" Value="92" />
                <Setter Property="mah:ControlsHelper.ContentCharacterCasing" Value="Normal" />
            </Style>

        </ResourceDictionary>
    </UserControl.Resources>

    <StackPanel Margin="10">

        <mah:MetroHeader Header="Where the badge sits">
            <StackPanel>
                <TextBlock Style="{StaticResource GroupCaption}" Text="BadgePlacementMode puts the badge on one of eight spots around the content. Wherever it goes it hangs over the edge by half its own size, so leave room for it or it will sit on whatever is beside it." />
                <WrapPanel>
                    <HeaderedContentControl Header="TopLeft" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4" BadgePlacementMode="TopLeft">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Top" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4" BadgePlacementMode="Top">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="TopRight, what a badge does by default" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4" BadgePlacementMode="TopRight">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Right" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4" BadgePlacementMode="Right">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="BottomRight" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4" BadgePlacementMode="BottomRight">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Bottom" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4" BadgePlacementMode="Bottom">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="BottomLeft" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4" BadgePlacementMode="BottomLeft">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Left" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4" BadgePlacementMode="Left">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                </WrapPanel>
            </StackPanel>
        </mah:MetroHeader>

        <mah:MetroHeader Header="On a tab">
            <StackPanel>
                <TextBlock Style="{StaticResource GroupCaption}" Text="A badge on a tab header used to come out cut in half, and which header it happened to looked like chance: it came down to whether the caption landed on a whole device pixel. Four captions of different lengths, which is what the report went by." />
                <Border MaxWidth="560"
                        HorizontalAlignment="Left"
                        Background="{DynamicResource MahApps.Brushes.Gray10}"
                        BorderBrush="{DynamicResource MahApps.Brushes.Gray8}"
                        BorderThickness="1"
                        CornerRadius="4">
                    <TabControl Height="152"
                                Margin="10 6 10 10"
                                Background="Transparent"
                                ItemContainerStyle="{StaticResource MailboxTab}"
                                MouseLeave="OnTabLetGo"
                                PreviewMouseLeftButtonDown="OnTabPressed"
                                PreviewMouseLeftButtonUp="OnTabLetGo">
                        <TabItem Header="{StaticResource Inbox}">
                            <StackPanel Margin="14 12">
                                <HeaderedContentControl Content="Re: the badge that keeps losing its top half"
                                                        Header="Tim"
                                                        Style="{StaticResource Message}" />
                                <HeaderedContentControl Content="develop is green again"
                                                        Header="Build server"
                                                        Style="{StaticResource Message}" />
                                <HeaderedContentControl Content="Found something that stops the clipping"
                                                        Header="Dealman"
                                                        Style="{StaticResource Message}" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="{StaticResource Drafts}">
                            <StackPanel Margin="14 12">
                                <HeaderedContentControl Content="About that layout rounding"
                                                        Header="To: Tim"
                                                        Style="{StaticResource Message}" />
                                <HeaderedContentControl Content="Started months ago, never finished"
                                                        Header="To: nobody yet"
                                                        Style="{StaticResource Message}" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="{StaticResource Sent}">
                            <StackPanel Margin="14 12">
                                <HeaderedContentControl Content="Thanks for the repro, that helped"
                                                        Header="To: Blinxar"
                                                        Style="{StaticResource Message}" />
                                <HeaderedContentControl Content="Release notes, second go"
                                                        Header="To: the list"
                                                        Style="{StaticResource Message}" />
                                <HeaderedContentControl Content="Merged, and the docs are written"
                                                        Header="To: Tim"
                                                        Style="{StaticResource Message}" />
                            </StackPanel>
                        </TabItem>
                        <TabItem Header="{StaticResource Archive}">
                            <StackPanel Margin="14 12">
                                <HeaderedContentControl Content="Kept, and never looked at again"
                                                        Header="Everyone"
                                                        Style="{StaticResource Message}" />
                                <HeaderedContentControl Content="Where this one started"
                                                        Header="2017"
                                                        Style="{StaticResource Message}" />
                                <HeaderedContentControl Content="Nine years is a long time for an issue"
                                                        Header="Nobody"
                                                        Style="{StaticResource Message}" />
                            </StackPanel>
                        </TabItem>
                    </TabControl>
                </Border>
                <StackPanel Margin="0 12 0 0" Orientation="Horizontal">
                    <TextBlock VerticalAlignment="Center"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               Text="Unread in the inbox" />
                    <mah:NumericUpDown Width="100"
                                       Margin="10 0 0 0"
                                       Maximum="999"
                                       Minimum="0"
                                       Value="{Binding Count, Source={StaticResource Inbox}, Mode=TwoWay}" />
                    <TextBlock Margin="12 0 0 0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource MahApps.Brushes.Gray3}"
                               Text="A number that changes is swelled up and let go again." />
                </StackPanel>
            </StackPanel>
        </mah:MetroHeader>

        <mah:MetroHeader Header="What it goes on">
            <StackPanel>
                <TextBlock Style="{StaticResource GroupCaption}" Text="Anything can carry a badge, since what it is put on is simply its content." />
                <WrapPanel>
                    <HeaderedContentControl Header="A button" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="An icon on its own" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4">
                            <iconPacks:PackIconMaterial Width="30"
                                                        Height="30"
                                                        Foreground="{DynamicResource MahApps.Brushes.Gray2}"
                                                        Kind="BellOutline" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="A round picture" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4">
                            <Border Width="56"
                                    Height="56"
                                    Background="{DynamicResource MahApps.Brushes.Accent3}"
                                    CornerRadius="28">
                                <TextBlock HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           FontSize="18"
                                           FontWeight="SemiBold"
                                           Foreground="White"
                                           Text="JK" />
                            </Border>
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="A line of text" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4">
                            <TextBlock VerticalAlignment="Center" Text="Messages" />
                        </mah:Badged>
                    </HeaderedContentControl>
                </WrapPanel>
            </StackPanel>
        </mah:MetroHeader>

        <mah:MetroHeader Header="What the badge looks like">
            <StackPanel>
                <TextBlock Style="{StaticResource GroupCaption}" Text="The badge takes brushes, a font and a template of its own. An empty one comes out as a dot, and a badge nobody set is drawn as nothing at all." />
                <WrapPanel>
                    <HeaderedContentControl Header="BadgeBackground and BadgeForeground" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4"
                                    BadgeBackground="{StaticResource Mandarin}"
                                    BadgeForeground="White">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="A border around it" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4"
                                    BadgeBackground="{DynamicResource MahApps.Brushes.ThemeBackground}"
                                    BadgeBorderBrush="{StaticResource Moss}"
                                    BadgeBorderThickness="2"
                                    BadgeForeground="{StaticResource Moss}">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="BadgeFontSize and BadgeFontWeight" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4"
                                    BadgeBackground="{StaticResource Plum}"
                                    BadgeFontSize="14"
                                    BadgeFontWeight="Black"
                                    BadgeForeground="White">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="A badge with nothing to read, which comes out as a dot" Style="{StaticResource BadgeCard}">
                        <mah:Badged BadgeBackground="{StaticResource Mandarin}" BadgeMargin="0">
                            <!--  anything that is not a text counts as a badge, and an empty one draws nothing but the dot around it  -->
                            <mah:Badged.Badge>
                                <Grid Width="0" Height="0" />
                            </mah:Badged.Badge>
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="An empty text is read as no badge at all, and nothing is drawn" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="BadgeStringFormat" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="128" BadgeStringFormat="{}{0}+">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="BadgeTemplate, for a badge that is not a number" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="done" BadgeBackground="{StaticResource Moss}">
                            <mah:Badged.BadgeTemplate>
                                <DataTemplate>
                                    <iconPacks:PackIconMaterial Width="10"
                                                                Height="10"
                                                                Foreground="White"
                                                                Kind="Check" />
                                </DataTemplate>
                            </mah:Badged.BadgeTemplate>
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="Switched off along with what it sits on" Style="{StaticResource BadgeCard}">
                        <mah:Badged Badge="4" IsEnabled="False">
                            <Button Style="{StaticResource SampleButton}" />
                        </mah:Badged>
                    </HeaderedContentControl>
                </WrapPanel>
            </StackPanel>
        </mah:MetroHeader>

        <mah:MetroHeader Header="Room for it">
            <StackPanel>
                <TextBlock Style="{StaticResource GroupCaption}" Text="A badged control asks for as much room as its content needs and no more, so the badge is outside what the layout knows about. Put next to something else it will overlap, and a margin is what keeps the two apart." />
                <WrapPanel>
                    <HeaderedContentControl Header="Side by side with nothing between them" Style="{StaticResource WideCard}">
                        <StackPanel Orientation="Horizontal">
                            <mah:Badged Badge="4">
                                <Button Style="{StaticResource SampleButton}" />
                            </mah:Badged>
                            <mah:Badged Badge="12">
                                <Button Content="Drafts" Style="{StaticResource SampleButton}" />
                            </mah:Badged>
                        </StackPanel>
                    </HeaderedContentControl>
                    <HeaderedContentControl Header="The same two, with a margin that leaves the badge somewhere to go" Style="{StaticResource WideCard}">
                        <StackPanel Orientation="Horizontal">
                            <mah:Badged Margin="0 0 14 0" Badge="4">
                                <Button Style="{StaticResource SampleButton}" />
                            </mah:Badged>
                            <mah:Badged Margin="0 0 14 0" Badge="12">
                                <Button Content="Drafts" Style="{StaticResource SampleButton}" />
                            </mah:Badged>
                        </StackPanel>
                    </HeaderedContentControl>
                </WrapPanel>
            </StackPanel>
        </mah:MetroHeader>

    </StackPanel>
</UserControl>
