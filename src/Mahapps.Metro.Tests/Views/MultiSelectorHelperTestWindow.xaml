<tests:TestWindow x:Class="MahApps.Metro.Tests.Views.MultiSelectorHelperTestWindow"
                  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                  xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                  xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
                  xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                  xmlns:tests="clr-namespace:MahApps.Metro.Tests"
                  x:Name="Window"
                  Title="MultiSelectorHelperTestWindow"
                  Width="800"
                  Height="450"
                  mc:Ignorable="d">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <mah:MultiSelectionComboBox x:Name="MultiSelectionComboBox"
                                    Grid.Row="0"
                                    Grid.Column="0"
                                    Grid.ColumnSpan="2"
                                    Margin="4 4 4 0"
                                    mah:MultiSelectorHelper.SelectedItems="{Binding ElementName=Window, Path=SelectedItems}"
                                    ItemsSource="{Binding ElementName=Window, Path=Items}"
                                    SelectionMode="Extended" />

        <ListBox x:Name="FirstListBox"
                 Grid.Row="1"
                 Grid.Column="0"
                 Margin="4 4 2 4"
                 mah:MultiSelectorHelper.SelectedItems="{Binding ElementName=Window, Path=SelectedItems}"
                 ItemsSource="{Binding ElementName=Window, Path=Items}"
                 SelectionMode="Extended" />

        <ListBox x:Name="SecondListBox"
                 Grid.Row="1"
                 Grid.Column="1"
                 Margin="2 4 4 4"
                 mah:MultiSelectorHelper.SelectedItems="{Binding ElementName=Window, Path=SelectedItems}"
                 ItemsSource="{Binding ElementName=Window, Path=SecondItems}"
                 SelectionMode="Extended" />

        <!--  GH-4461: a list inside a list, where the inner one lets its selection bubble up to the outer  -->
        <ListView x:Name="OuterListView"
                  Grid.Row="2"
                  Grid.Column="0"
                  Grid.ColumnSpan="2"
                  Margin="4"
                  mah:MultiSelectorHelper.SelectedItems="{Binding ElementName=Window, Path=SelectedItems}"
                  ItemsSource="{Binding ElementName=Window, Path=Items}"
                  SelectionMode="Extended">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <ListBox x:Name="InnerListBox" ItemsSource="{Binding ElementName=Window, Path=Numbers}" />
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</tests:TestWindow>