<Page x:Class="MahAppsMetroNavApp.Pages.SettingsPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mah="http://metro.mahapps.com/winfx/xaml/controls"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      Title="Settings"
      d:DesignHeight="600"
      d:DesignWidth="800"
      KeepAlive="True"
      mc:Ignorable="d">

    <StackPanel Margin="24">
        <TextBlock FontSize="28" Text="Settings" />
        <mah:ToggleSwitch Margin="0 16 0 0"
                          Header="Keep me signed in"
                          IsOn="True" />

        <TextBlock Margin="0 16 0 0"
                   Text="This page stays alive while the application runs, so the switch is where you left it when you come back."
                   TextWrapping="Wrap" />
    </StackPanel>

</Page>
